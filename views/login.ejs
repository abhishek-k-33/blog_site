<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In — miniblogs</title>
    <meta name="description" content="Sign in or create your miniblogs account to start writing and sharing stories.">
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="alternate icon" href="/images/favicon.svg">
    <!-- Typography (Inter + Lora) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body class="dark-mode">
    <script>
        // Apply saved theme immediately to prevent flashing
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme) {
            document.body.className = savedTheme;
        }
    </script>

    <!-- ========== AUTH PAGE ========== -->
    <div class="auth-page" id="auth-page">

        <!-- Ambient Background Glow Orbs -->
        <div class="auth-bg-orb auth-bg-orb--1"></div>
        <div class="auth-bg-orb auth-bg-orb--2"></div>
        <div class="auth-bg-orb auth-bg-orb--3"></div>

        <!-- Floating Grid Pattern -->
        <div class="auth-grid-pattern"></div>

        <!-- Main Auth Container -->
        <div class="auth-container">

            <!-- Brand Section -->
            <a href="/" class="auth-brand" title="Back to miniblogs home">
                <svg class="auth-brand-logo" viewBox="0 0 100 112" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <defs>
                        <linearGradient id="authFoldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#E06A3B"/>
                            <stop offset="100%" stop-color="#F59E0B"/>
                        </linearGradient>
                        <filter id="authFoldShadow" x="-30%" y="-30%" width="160%" height="160%">
                            <feDropShadow dx="-1.5" dy="2" stdDeviation="2" flood-color="#000000" flood-opacity="0.4"/>
                        </filter>
                    </defs>
                    <path d="M 20 8 L 65 8 L 65 24 Q 65 32, 73 32 L 88 32 L 88 72 Q 88 84, 76 84 L 20 84 Q 8 84, 8 72 L 8 20 Q 8 8, 20 8 Z" fill="currentColor"/>
                    <path d="M 36 84 L 16 100 L 20 84 Z" fill="currentColor"/>
                    <path d="M 65 8 L 88 32 L 73 32 Q 65 32, 65 24 Z" fill="url(#authFoldGrad)" filter="url(#authFoldShadow)"/>
                    <rect x="22" y="42" width="30" height="4.5" rx="2.25" fill="url(#authFoldGrad)" opacity="0.5"/>
                    <rect x="22" y="52" width="46" height="4.5" rx="2.25" fill="url(#authFoldGrad)" opacity="0.35"/>
                    <rect x="22" y="62" width="24" height="4.5" rx="2.25" fill="url(#authFoldGrad)" opacity="0.2"/>
                </svg>
                <span class="auth-brand-name">miniblogs</span>
            </a>

            <!-- Glassmorphic Auth Card -->
            <div class="auth-card" id="auth-card">

                <!-- Tab Switcher -->
                <div class="auth-tabs" role="tablist" aria-label="Authentication method">
                    <button class="auth-tab auth-tab--active" id="tab-signin" role="tab" aria-selected="true" aria-controls="panel-signin" data-tab="signin">Sign In</button>
                    <button class="auth-tab" id="tab-signup" role="tab" aria-selected="false" aria-controls="panel-signup" data-tab="signup">Create Account</button>
                    <div class="auth-tab-indicator" id="auth-tab-indicator"></div>
                </div>

                <!-- ===== SIGN IN PANEL ===== -->
                <div class="auth-panel auth-panel--active" id="panel-signin" role="tabpanel" aria-labelledby="tab-signin">
                    <h1 class="auth-heading">Welcome back</h1>
                    <p class="auth-subheading">Sign in to continue writing your stories.</p>

                    <form class="auth-form" id="signin-form" novalidate>
                        <!-- Email -->
                        <div class="auth-form-group" id="signin-email-group">
                            <label class="auth-label" for="signin-email">Email</label>
                            <div class="auth-input-wrapper">
                                <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                                <input type="email" id="signin-email" class="auth-input" placeholder="you@example.com" required autocomplete="email">
                            </div>
                            <span class="auth-error" id="signin-email-error"></span>
                        </div>

                        <!-- Password -->
                        <div class="auth-form-group" id="signin-password-group">
                            <label class="auth-label" for="signin-password">Password</label>
                            <div class="auth-input-wrapper">
                                <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                                <input type="password" id="signin-password" class="auth-input" placeholder="Enter your password" required autocomplete="current-password">
                                <button type="button" class="auth-toggle-pwd" id="signin-toggle-pwd" aria-label="Show password" title="Show password">
                                    <!-- Eye icon (show) -->
                                    <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                    <!-- Eye-off icon (hide) -->
                                    <svg class="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                        <line x1="1" y1="1" x2="23" y2="23"></line>
                                    </svg>
                                </button>
                            </div>
                            <span class="auth-error" id="signin-password-error"></span>
                        </div>

                        <!-- Remember Me & Forgot Password -->
                        <div class="auth-options-row">
                            <label class="auth-checkbox-label" for="signin-remember">
                                <input type="checkbox" id="signin-remember" class="auth-checkbox">
                                <span class="auth-checkbox-custom"></span>
                                <span class="auth-checkbox-text">Remember me</span>
                            </label>
                            <button type="button" class="auth-link-btn" id="forgot-password-trigger">Forgot password?</button>
                        </div>

                        <!-- Submit -->
                        <button type="submit" class="auth-submit-btn" id="signin-submit-btn">
                            <span class="auth-btn-text">Sign In</span>
                            <span class="auth-btn-spinner" style="display:none;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path></svg>
                            </span>
                        </button>
                    </form>
                </div>

                <!-- ===== SIGN UP PANEL ===== -->
                <div class="auth-panel" id="panel-signup" role="tabpanel" aria-labelledby="tab-signup">
                    <h1 class="auth-heading">Create your account</h1>
                    <p class="auth-subheading">Join the miniblogs community and start sharing.</p>

                    <form class="auth-form" id="signup-form" novalidate>
                        <!-- Display Name -->
                        <div class="auth-form-group" id="signup-name-group">
                            <label class="auth-label" for="signup-name">Display Name</label>
                            <div class="auth-input-wrapper">
                                <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                                <input type="text" id="signup-name" class="auth-input" placeholder="Your display name" required autocomplete="name">
                            </div>
                            <span class="auth-error" id="signup-name-error"></span>
                        </div>

                        <!-- Email -->
                        <div class="auth-form-group" id="signup-email-group">
                            <label class="auth-label" for="signup-email">Email</label>
                            <div class="auth-input-wrapper">
                                <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                                <input type="email" id="signup-email" class="auth-input" placeholder="you@example.com" required autocomplete="email">
                            </div>
                            <span class="auth-error" id="signup-email-error"></span>
                        </div>

                        <!-- Password -->
                        <div class="auth-form-group" id="signup-password-group">
                            <label class="auth-label" for="signup-password">Password</label>
                            <div class="auth-input-wrapper">
                                <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                                <input type="password" id="signup-password" class="auth-input" placeholder="Min. 8 characters" required autocomplete="new-password" minlength="8">
                                <button type="button" class="auth-toggle-pwd" id="signup-toggle-pwd" aria-label="Show password" title="Show password">
                                    <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                    <svg class="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                        <line x1="1" y1="1" x2="23" y2="23"></line>
                                    </svg>
                                </button>
                            </div>
                            <span class="auth-error" id="signup-password-error"></span>

                            <!-- Password Strength Meter -->
                            <div class="auth-strength-meter" id="signup-strength-meter">
                                <div class="auth-strength-bar">
                                    <div class="auth-strength-fill" id="signup-strength-fill"></div>
                                </div>
                                <span class="auth-strength-text" id="signup-strength-text"></span>
                            </div>
                        </div>

                        <!-- Confirm Password -->
                        <div class="auth-form-group" id="signup-confirm-group">
                            <label class="auth-label" for="signup-confirm">Confirm Password</label>
                            <div class="auth-input-wrapper">
                                <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                </svg>
                                <input type="password" id="signup-confirm" class="auth-input" placeholder="Re-enter password" required autocomplete="new-password">
                            </div>
                            <span class="auth-error" id="signup-confirm-error"></span>
                        </div>

                        <!-- Submit -->
                        <button type="submit" class="auth-submit-btn" id="signup-submit-btn">
                            <span class="auth-btn-text">Create Account</span>
                            <span class="auth-btn-spinner" style="display:none;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path></svg>
                            </span>
                        </button>
                    </form>
                </div>

                <!-- Auth footer -->
                <div class="auth-card-footer">
                    <p class="auth-footer-text">
                        By continuing, you agree to miniblogs' <a href="#" class="auth-footer-link">Terms of Service</a> and <a href="#" class="auth-footer-link">Privacy Policy</a>.
                    </p>
                </div>
            </div>

            <!-- Back to home link -->
            <a href="/" class="auth-back-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                Back to miniblogs
            </a>
        </div>
    </div>

    <!-- ========== FORGOT PASSWORD MODAL ========== -->
    <div class="auth-modal-backdrop" id="forgot-modal-backdrop"></div>
    <div class="auth-modal" id="forgot-modal" role="dialog" aria-labelledby="forgot-modal-title" aria-modal="true">
        <div class="auth-modal-header">
            <h2 id="forgot-modal-title" class="auth-modal-title">Reset your password</h2>
            <button type="button" class="auth-modal-close" id="forgot-modal-close" aria-label="Close modal">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
        <div class="auth-modal-body">
            <p class="auth-modal-desc">Enter the email address associated with your account. We'll send you a link to reset your password.</p>
            <form id="forgot-form" class="auth-form" novalidate>
                <div class="auth-form-group" id="forgot-email-group">
                    <label class="auth-label" for="forgot-email">Email</label>
                    <div class="auth-input-wrapper">
                        <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                        <input type="email" id="forgot-email" class="auth-input" placeholder="you@example.com" required autocomplete="email">
                    </div>
                    <span class="auth-error" id="forgot-email-error"></span>
                </div>
                <button type="submit" class="auth-submit-btn" id="forgot-submit-btn">
                    <span class="auth-btn-text">Send Reset Link</span>
                    <span class="auth-btn-spinner" style="display:none;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path></svg>
                    </span>
                </button>
            </form>
            <div class="auth-modal-success" id="forgot-success" style="display:none;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <h3>Check your inbox!</h3>
                <p>We've sent a password reset link to your email. Please check your inbox (and spam folder) and follow the instructions.</p>
            </div>
        </div>
    </div>

    <!-- ========== TOAST NOTIFICATION ========== -->
    <div class="auth-toast" id="auth-toast" role="alert" aria-live="polite">
        <span class="auth-toast-icon" id="auth-toast-icon"></span>
        <span class="auth-toast-message" id="auth-toast-message"></span>
    </div>

    <!-- ========== AUTH PAGE SCRIPTS ========== -->
    <script>
    (function() {
        'use strict';

        // === Tab Switching ===
        const tabs = document.querySelectorAll('.auth-tab');
        const panels = document.querySelectorAll('.auth-panel');
        const indicator = document.getElementById('auth-tab-indicator');

        function switchTab(tabName) {
            tabs.forEach(t => {
                const isActive = t.dataset.tab === tabName;
                t.classList.toggle('auth-tab--active', isActive);
                t.setAttribute('aria-selected', isActive);
            });
            panels.forEach(p => {
                p.classList.toggle('auth-panel--active', p.id === 'panel-' + tabName);
            });
            positionIndicator();
        }

        function positionIndicator() {
            const activeTab = document.querySelector('.auth-tab--active');
            if (activeTab && indicator) {
                indicator.style.width = activeTab.offsetWidth + 'px';
                indicator.style.left = activeTab.offsetLeft + 'px';
            }
        }

        tabs.forEach(tab => {
            tab.addEventListener('click', () => switchTab(tab.dataset.tab));
        });

        // Initial indicator position
        positionIndicator();
        window.addEventListener('resize', positionIndicator);

        // Support ?tab=signup query param
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('tab') === 'signup') {
            switchTab('signup');
        }

        // === Password Toggle ===
        document.querySelectorAll('.auth-toggle-pwd').forEach(btn => {
            btn.addEventListener('click', () => {
                const wrapper = btn.closest('.auth-input-wrapper');
                const input = wrapper.querySelector('.auth-input');
                const eyeOpen = btn.querySelector('.eye-open');
                const eyeClosed = btn.querySelector('.eye-closed');

                if (input.type === 'password') {
                    input.type = 'text';
                    eyeOpen.style.display = 'none';
                    eyeClosed.style.display = 'block';
                    btn.setAttribute('aria-label', 'Hide password');
                    btn.setAttribute('title', 'Hide password');
                } else {
                    input.type = 'password';
                    eyeOpen.style.display = 'block';
                    eyeClosed.style.display = 'none';
                    btn.setAttribute('aria-label', 'Show password');
                    btn.setAttribute('title', 'Show password');
                }
                input.focus();
            });
        });

        // === Password Strength Meter ===
        const signupPwd = document.getElementById('signup-password');
        const strengthFill = document.getElementById('signup-strength-fill');
        const strengthText = document.getElementById('signup-strength-text');

        function evaluateStrength(pwd) {
            let score = 0;
            if (pwd.length >= 8) score++;
            if (pwd.length >= 12) score++;
            if (/[a-z]/.test(pwd) && /[A-Z]/.test(pwd)) score++;
            if (/[0-9]/.test(pwd)) score++;
            if (/[^a-zA-Z0-9]/.test(pwd)) score++;
            return score; // 0-5
        }

        if (signupPwd) {
            signupPwd.addEventListener('input', () => {
                const val = signupPwd.value;
                const meter = document.getElementById('signup-strength-meter');
                if (!val) {
                    meter.style.opacity = '0';
                    return;
                }
                meter.style.opacity = '1';
                const score = evaluateStrength(val);
                const levels = [
                    { width: '10%', color: '#ef4444', text: 'Very Weak' },
                    { width: '25%', color: '#f97316', text: 'Weak' },
                    { width: '50%', color: '#eab308', text: 'Fair' },
                    { width: '75%', color: '#22c55e', text: 'Strong' },
                    { width: '90%', color: '#10b981', text: 'Very Strong' },
                    { width: '100%', color: '#06d6a0', text: 'Excellent' }
                ];
                const level = levels[score];
                strengthFill.style.width = level.width;
                strengthFill.style.background = level.color;
                strengthText.textContent = level.text;
                strengthText.style.color = level.color;
            });
        }

        // === Form Validation Helpers ===
        function showError(groupId, errorId, message) {
            const group = document.getElementById(groupId);
            const error = document.getElementById(errorId);
            if (group) group.classList.add('auth-form-group--error');
            if (error) error.textContent = message;
        }

        function clearError(groupId, errorId) {
            const group = document.getElementById(groupId);
            const error = document.getElementById(errorId);
            if (group) group.classList.remove('auth-form-group--error');
            if (error) error.textContent = '';
        }

        function clearAllErrors(prefix) {
            document.querySelectorAll(`[id^="${prefix}"]`).forEach(el => {
                if (el.classList) el.classList.remove('auth-form-group--error');
            });
            document.querySelectorAll('.auth-error').forEach(el => el.textContent = '');
        }

        function isValidEmail(email) {
            return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        }

        function shakeCard() {
            const card = document.getElementById('auth-card');
            card.classList.add('auth-card--shake');
            setTimeout(() => card.classList.remove('auth-card--shake'), 500);
        }

        // === Toast Notifications ===
        const toast = document.getElementById('auth-toast');
        const toastIcon = document.getElementById('auth-toast-icon');
        const toastMessage = document.getElementById('auth-toast-message');
        let toastTimeout;

        function showToast(message, type) {
            clearTimeout(toastTimeout);
            toast.className = 'auth-toast auth-toast--' + type + ' auth-toast--visible';
            toastMessage.textContent = message;
            toastIcon.innerHTML = type === 'success'
                ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>'
                : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>';
            toastTimeout = setTimeout(() => {
                toast.classList.remove('auth-toast--visible');
            }, 4000);
        }

        // === Sign In Form Submission ===
        const signinForm = document.getElementById('signin-form');
        signinForm.addEventListener('submit', (e) => {
            e.preventDefault();
            clearAllErrors('signin');
            let valid = true;

            const email = document.getElementById('signin-email').value.trim();
            const password = document.getElementById('signin-password').value;

            if (!email) {
                showError('signin-email-group', 'signin-email-error', 'Email is required.');
                valid = false;
            } else if (!isValidEmail(email)) {
                showError('signin-email-group', 'signin-email-error', 'Please enter a valid email.');
                valid = false;
            }

            if (!password) {
                showError('signin-password-group', 'signin-password-error', 'Password is required.');
                valid = false;
            }

            if (!valid) {
                shakeCard();
                return;
            }

            // Simulate loading state
            const btn = document.getElementById('signin-submit-btn');
            btn.querySelector('.auth-btn-text').style.display = 'none';
            btn.querySelector('.auth-btn-spinner').style.display = 'inline-flex';
            btn.disabled = true;

            // TODO: Replace with actual Supabase auth call
            setTimeout(() => {
                btn.querySelector('.auth-btn-text').style.display = '';
                btn.querySelector('.auth-btn-spinner').style.display = 'none';
                btn.disabled = false;
                showToast('Sign in successful! Redirecting...', 'success');
                setTimeout(() => { window.location.href = '/'; }, 1500);
            }, 1800);
        });

        // === Sign Up Form Submission ===
        const signupForm = document.getElementById('signup-form');
        signupForm.addEventListener('submit', (e) => {
            e.preventDefault();
            clearAllErrors('signup');
            let valid = true;

            const name = document.getElementById('signup-name').value.trim();
            const email = document.getElementById('signup-email').value.trim();
            const password = document.getElementById('signup-password').value;
            const confirm = document.getElementById('signup-confirm').value;

            if (!name) {
                showError('signup-name-group', 'signup-name-error', 'Display name is required.');
                valid = false;
            }

            if (!email) {
                showError('signup-email-group', 'signup-email-error', 'Email is required.');
                valid = false;
            } else if (!isValidEmail(email)) {
                showError('signup-email-group', 'signup-email-error', 'Please enter a valid email.');
                valid = false;
            }

            if (!password) {
                showError('signup-password-group', 'signup-password-error', 'Password is required.');
                valid = false;
            } else if (password.length < 8) {
                showError('signup-password-group', 'signup-password-error', 'Password must be at least 8 characters.');
                valid = false;
            }

            if (!confirm) {
                showError('signup-confirm-group', 'signup-confirm-error', 'Please confirm your password.');
                valid = false;
            } else if (password !== confirm) {
                showError('signup-confirm-group', 'signup-confirm-error', 'Passwords do not match.');
                valid = false;
            }

            if (!valid) {
                shakeCard();
                return;
            }

            // Simulate loading state
            const btn = document.getElementById('signup-submit-btn');
            btn.querySelector('.auth-btn-text').style.display = 'none';
            btn.querySelector('.auth-btn-spinner').style.display = 'inline-flex';
            btn.disabled = true;

            // TODO: Replace with actual Supabase auth call
            setTimeout(() => {
                btn.querySelector('.auth-btn-text').style.display = '';
                btn.querySelector('.auth-btn-spinner').style.display = 'none';
                btn.disabled = false;
                showToast('Account created! Check your email to verify.', 'success');
            }, 1800);
        });

        // === Forgot Password Modal ===
        const forgotTrigger = document.getElementById('forgot-password-trigger');
        const forgotBackdrop = document.getElementById('forgot-modal-backdrop');
        const forgotModal = document.getElementById('forgot-modal');
        const forgotClose = document.getElementById('forgot-modal-close');

        function openForgotModal() {
            forgotBackdrop.classList.add('auth-modal-backdrop--visible');
            forgotModal.classList.add('auth-modal--visible');
            document.body.style.overflow = 'hidden';
            document.getElementById('forgot-email').focus();
        }

        function closeForgotModal() {
            forgotBackdrop.classList.remove('auth-modal-backdrop--visible');
            forgotModal.classList.remove('auth-modal--visible');
            document.body.style.overflow = '';
            // Reset modal state
            document.getElementById('forgot-form').style.display = '';
            document.getElementById('forgot-success').style.display = 'none';
            document.getElementById('forgot-email').value = '';
            clearError('forgot-email-group', 'forgot-email-error');
        }

        if (forgotTrigger) forgotTrigger.addEventListener('click', openForgotModal);
        if (forgotClose) forgotClose.addEventListener('click', closeForgotModal);
        if (forgotBackdrop) forgotBackdrop.addEventListener('click', closeForgotModal);

        // Escape key closes modal
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && forgotModal.classList.contains('auth-modal--visible')) {
                closeForgotModal();
            }
        });

        // Forgot Password Form
        const forgotForm = document.getElementById('forgot-form');
        forgotForm.addEventListener('submit', (e) => {
            e.preventDefault();
            clearError('forgot-email-group', 'forgot-email-error');

            const email = document.getElementById('forgot-email').value.trim();
            if (!email) {
                showError('forgot-email-group', 'forgot-email-error', 'Email is required.');
                return;
            }
            if (!isValidEmail(email)) {
                showError('forgot-email-group', 'forgot-email-error', 'Please enter a valid email.');
                return;
            }

            const btn = document.getElementById('forgot-submit-btn');
            btn.querySelector('.auth-btn-text').style.display = 'none';
            btn.querySelector('.auth-btn-spinner').style.display = 'inline-flex';
            btn.disabled = true;

            // TODO: Replace with actual Supabase password reset call
            setTimeout(() => {
                btn.querySelector('.auth-btn-text').style.display = '';
                btn.querySelector('.auth-btn-spinner').style.display = 'none';
                btn.disabled = false;
                forgotForm.style.display = 'none';
                document.getElementById('forgot-success').style.display = 'flex';
            }, 1800);
        });

        // === Inline Validation (clear errors on input) ===
        document.querySelectorAll('.auth-input').forEach(input => {
            input.addEventListener('input', () => {
                const group = input.closest('.auth-form-group');
                if (group) {
                    group.classList.remove('auth-form-group--error');
                    const err = group.querySelector('.auth-error');
                    if (err) err.textContent = '';
                }
            });
        });

    })();
    </script>
</body>
</html>
