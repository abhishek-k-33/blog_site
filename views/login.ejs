<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In — miniblogs</title>
    <meta name="description" content="Sign in or create your miniblogs account to start writing and sharing stories.">
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="alternate icon" href="/images/favicon.svg">
    <!-- Typography (Inter + Lora) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/style.css">
    <style>
        /* Interactive Shimmer, Spotlight & Parallax enhancements */
        .auth-hero {
            perspective: 1000px;
            cursor: default;
        }

        .auth-hero-img {
            transition: transform 0.15s ease-out;
            will-change: transform;
        }

        .floating-page {
            will-change: transform;
            transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1);
        }

        /* Stardust Particle Canvas */
        #auth-particle-canvas {
            position: absolute;
            inset: 0;
            z-index: 2;
            pointer-events: none;
            width: 100%;
            height: 100%;
        }

        /* Dynamic Quote Rotator with smooth blur-fade transition */
        .auth-hero-quote {
            min-height: 80px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            transition: opacity 0.5s ease, transform 0.5s ease, filter 0.5s ease;
        }

        .auth-hero-quote.quote-transitioning {
            opacity: 0;
            transform: translateY(8px);
            filter: blur(4px);
        }

        /* Card Cursor Spotlight */
        .auth-form-scroll {
            position: relative;
            background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(245, 158, 11, 0.06), transparent 40%);
            border-radius: 20px;
        }

        /* Continuous subtle button light-sweep */
        .auth-submit-btn {
            background-size: 200% 200%;
            animation: btnGradientGlow 6s ease infinite;
        }

        @keyframes btnGradientGlow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .auth-submit-btn::after {
            content: '';
            position: absolute;
            top: 0;
            left: -150%;
            width: 80%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
            transform: skewX(-25deg);
            animation: btnShimmerSweep 5s ease-in-out infinite;
        }

        @keyframes btnShimmerSweep {
            0% { left: -150%; }
            30% { left: 150%; }
            100% { left: 150%; }
        }
    </style>
</head>
<body class="dark-mode">
    <script>
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme) document.body.className = savedTheme;
    </script>

    <!-- ========== SPLIT-SCREEN AUTH PAGE ========== -->
    <div class="auth-split" id="auth-page">

        <!-- ===== LEFT: Hero Panel with 3D Parallax & Stardust ===== -->
        <div class="auth-hero" id="auth-hero">
            <!-- Hero Background Image with Ken Burns animation -->
            <div class="auth-hero-img" id="hero-img"></div>

            <!-- Dark gradient overlay -->
            <div class="auth-hero-overlay"></div>

            <!-- Canvas for interactive cursor stardust particles -->
            <canvas id="auth-particle-canvas"></canvas>

            <!-- Animated floating paper pages with 3D depth tags -->
            <div class="auth-floating-pages" id="floating-pages-container">
                <div class="floating-page fp-1" data-depth="0.06" data-speed="1.2">
                    <svg viewBox="0 0 60 75" fill="none"><rect x="2" y="2" width="56" height="71" rx="4" fill="rgba(255,248,230,0.12)" stroke="rgba(245,158,11,0.3)" stroke-width="1"/><line x1="12" y1="16" x2="48" y2="16" stroke="rgba(245,158,11,0.2)" stroke-width="2" stroke-linecap="round"/><line x1="12" y1="24" x2="42" y2="24" stroke="rgba(245,158,11,0.15)" stroke-width="2" stroke-linecap="round"/><line x1="12" y1="32" x2="36" y2="32" stroke="rgba(245,158,11,0.1)" stroke-width="2" stroke-linecap="round"/><line x1="12" y1="40" x2="44" y2="40" stroke="rgba(245,158,11,0.08)" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
                <div class="floating-page fp-2" data-depth="0.04" data-speed="0.8">
                    <svg viewBox="0 0 50 65" fill="none"><rect x="2" y="2" width="46" height="61" rx="3" fill="rgba(255,248,230,0.1)" stroke="rgba(224,106,59,0.25)" stroke-width="1"/><line x1="10" y1="14" x2="38" y2="14" stroke="rgba(224,106,59,0.18)" stroke-width="2" stroke-linecap="round"/><line x1="10" y1="22" x2="34" y2="22" stroke="rgba(224,106,59,0.12)" stroke-width="2" stroke-linecap="round"/><line x1="10" y1="30" x2="30" y2="30" stroke="rgba(224,106,59,0.08)" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
                <div class="floating-page fp-3" data-depth="0.08" data-speed="1.4">
                    <svg viewBox="0 0 55 70" fill="none"><rect x="2" y="2" width="51" height="66" rx="4" fill="rgba(255,248,230,0.08)" stroke="rgba(245,158,11,0.2)" stroke-width="1"/><line x1="11" y1="15" x2="42" y2="15" stroke="rgba(245,158,11,0.15)" stroke-width="2" stroke-linecap="round"/><line x1="11" y1="23" x2="38" y2="23" stroke="rgba(245,158,11,0.1)" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
                <div class="floating-page fp-4" data-depth="0.05" data-speed="1.0">
                    <svg viewBox="0 0 45 58" fill="none"><rect x="2" y="2" width="41" height="54" rx="3" fill="rgba(255,248,230,0.06)" stroke="rgba(224,106,59,0.18)" stroke-width="1"/><line x1="9" y1="13" x2="34" y2="13" stroke="rgba(224,106,59,0.12)" stroke-width="2" stroke-linecap="round"/><line x1="9" y1="20" x2="28" y2="20" stroke="rgba(224,106,59,0.08)" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
                <div class="floating-page fp-5" data-depth="0.07" data-speed="1.1">
                    <svg viewBox="0 0 40 52" fill="none"><rect x="2" y="2" width="36" height="48" rx="3" fill="rgba(255,248,230,0.07)" stroke="rgba(245,158,11,0.15)" stroke-width="1"/><line x1="8" y1="12" x2="30" y2="12" stroke="rgba(245,158,11,0.1)" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
                <div class="floating-page fp-6" data-depth="0.03" data-speed="0.7">
                    <svg viewBox="0 0 48 62" fill="none"><rect x="2" y="2" width="44" height="58" rx="3" fill="rgba(255,248,230,0.05)" stroke="rgba(224,106,59,0.12)" stroke-width="1"/><line x1="10" y1="14" x2="36" y2="14" stroke="rgba(224,106,59,0.1)" stroke-width="2" stroke-linecap="round"/><line x1="10" y1="22" x2="32" y2="22" stroke="rgba(224,106,59,0.07)" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
            </div>

            <!-- Animated ambient sparkle particles -->
            <div class="auth-sparkles">
                <span class="sparkle sp-1"></span>
                <span class="sparkle sp-2"></span>
                <span class="sparkle sp-3"></span>
                <span class="sparkle sp-4"></span>
                <span class="sparkle sp-5"></span>
                <span class="sparkle sp-6"></span>
                <span class="sparkle sp-7"></span>
                <span class="sparkle sp-8"></span>
                <span class="sparkle sp-9"></span>
                <span class="sparkle sp-10"></span>
                <span class="sparkle sp-11"></span>
                <span class="sparkle sp-12"></span>
            </div>

            <!-- Hero content (logo + dynamic rotating quote) -->
            <div class="auth-hero-content" id="hero-content">
                <a href="/" class="auth-hero-brand" title="Back to miniblogs home">
                    <svg class="auth-hero-logo" viewBox="0 0 100 112" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <defs>
                            <linearGradient id="authHeroFoldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#E06A3B"/>
                                <stop offset="100%" stop-color="#F59E0B"/>
                            </linearGradient>
                            <filter id="authHeroFoldShadow" x="-30%" y="-30%" width="160%" height="160%">
                                <feDropShadow dx="-1.5" dy="2" stdDeviation="2" flood-color="#000000" flood-opacity="0.4"/>
                            </filter>
                        </defs>
                        <path d="M 20 8 L 65 8 L 65 24 Q 65 32, 73 32 L 88 32 L 88 72 Q 88 84, 76 84 L 20 84 Q 8 84, 8 72 L 8 20 Q 8 8, 20 8 Z" fill="currentColor"/>
                        <path d="M 36 84 L 16 100 L 20 84 Z" fill="currentColor"/>
                        <path d="M 65 8 L 88 32 L 73 32 Q 65 32, 65 24 Z" fill="url(#authHeroFoldGrad)" filter="url(#authHeroFoldShadow)"/>
                        <rect x="22" y="42" width="30" height="4.5" rx="2.25" fill="url(#authHeroFoldGrad)" opacity="0.5"/>
                        <rect x="22" y="52" width="46" height="4.5" rx="2.25" fill="url(#authHeroFoldGrad)" opacity="0.35"/>
                        <rect x="22" y="62" width="24" height="4.5" rx="2.25" fill="url(#authHeroFoldGrad)" opacity="0.2"/>
                    </svg>
                    <span class="auth-hero-wordmark">miniblogs</span>
                </a>
                <p class="auth-hero-quote" id="auth-quote">
                    <em id="quote-text">"Words are, in my not-so-humble opinion, our most inexhaustible source of magic."</em>
                    <span class="auth-hero-author" id="quote-author">— J.K. Rowling</span>
                </p>
            </div>
        </div>

        <!-- ===== RIGHT: Form Panel ===== -->
        <div class="auth-form-panel" id="form-panel">
            <div class="auth-form-scroll" id="auth-card-scroll">

                <!-- Tab Switcher -->
                <div class="auth-tabs" role="tablist" aria-label="Authentication method">
                    <button class="auth-tab auth-tab--active" id="tab-signin" role="tab" aria-selected="true" aria-controls="panel-signin" data-tab="signin">Sign In</button>
                    <button class="auth-tab" id="tab-signup" role="tab" aria-selected="false" aria-controls="panel-signup" data-tab="signup">Create Account</button>
                    <div class="auth-tab-indicator" id="auth-tab-indicator"></div>
                </div>

                <!-- ===== SIGN IN PANEL ===== -->
                <div class="auth-panel auth-panel--active" id="panel-signin" role="tabpanel" aria-labelledby="tab-signin">
                    <h1 class="auth-heading">Welcome back!</h1>
                    <p class="auth-subheading">Sign in to your miniblogs account to start writing.</p>

                    <form class="auth-form" id="signin-form" novalidate>
                        <!-- Email -->
                        <div class="auth-form-group" id="signin-email-group">
                            <label class="auth-label" for="signin-email">Email Address</label>
                            <div class="auth-input-wrapper">
                                <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                <input type="email" id="signin-email" class="auth-input" placeholder="name@example.com" required autocomplete="email">
                            </div>
                            <span class="auth-error" id="signin-email-error"></span>
                        </div>

                        <!-- Password -->
                        <div class="auth-form-group" id="signin-password-group">
                            <label class="auth-label" for="signin-password">Password</label>
                            <div class="auth-input-wrapper">
                                <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                <input type="password" id="signin-password" class="auth-input" placeholder="Enter your password" required autocomplete="current-password">
                                <button type="button" class="auth-toggle-pwd" id="signin-toggle-pwd" aria-label="Show password" title="Show password">
                                    <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                    <svg class="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                                </button>
                            </div>
                            <div class="auth-password-meta">
                                <label class="auth-checkbox-label" for="signin-remember">
                                    <input type="checkbox" id="signin-remember" class="auth-checkbox">
                                    <span class="auth-checkbox-custom"></span>
                                    <span class="auth-checkbox-text">Remember me</span>
                                </label>
                                <button type="button" class="auth-link-btn" id="forgot-password-trigger">Forgot Password?</button>
                            </div>
                            <span class="auth-error" id="signin-password-error"></span>
                        </div>

                        <!-- Sign In Button -->
                        <button type="submit" class="auth-submit-btn" id="signin-submit-btn">
                            <span class="auth-btn-text">Sign In</span>
                            <span class="auth-btn-spinner" style="display:none;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path></svg></span>
                        </button>
                    </form>

                    <!-- Divider -->
                    <div class="auth-divider">
                        <span class="auth-divider-line"></span>
                        <span class="auth-divider-text">or continue with</span>
                        <span class="auth-divider-line"></span>
                    </div>

                    <!-- OAuth Buttons -->
                    <div class="auth-oauth-buttons">
                        <button type="button" class="auth-oauth-btn" id="google-signin-btn">
                            <svg width="18" height="18" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                            <span>Google</span>
                        </button>
                        <button type="button" class="auth-oauth-btn" id="github-signin-btn">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                            <span>GitHub</span>
                        </button>
                    </div>

                    <!-- Bottom link -->
                    <p class="auth-switch-text">
                        Don't have an account? <button type="button" class="auth-switch-link" data-switch="signup">Create an account</button>
                    </p>
                </div>

                <!-- ===== SIGN UP PANEL ===== -->
                <div class="auth-panel" id="panel-signup" role="tabpanel" aria-labelledby="tab-signup">
                    <h1 class="auth-heading">Create your account</h1>
                    <p class="auth-subheading">Join the miniblogs community and start sharing.</p>

                    <form class="auth-form" id="signup-form" novalidate>
                        <div class="auth-form-group" id="signup-name-group">
                            <label class="auth-label" for="signup-name">Display Name</label>
                            <div class="auth-input-wrapper">
                                <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                <input type="text" id="signup-name" class="auth-input" placeholder="Your display name" required autocomplete="name">
                            </div>
                            <span class="auth-error" id="signup-name-error"></span>
                        </div>

                        <div class="auth-form-group" id="signup-email-group">
                            <label class="auth-label" for="signup-email">Email Address</label>
                            <div class="auth-input-wrapper">
                                <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                <input type="email" id="signup-email" class="auth-input" placeholder="name@example.com" required autocomplete="email">
                            </div>
                            <span class="auth-error" id="signup-email-error"></span>
                        </div>

                        <div class="auth-form-group" id="signup-password-group">
                            <label class="auth-label" for="signup-password">Password</label>
                            <div class="auth-input-wrapper">
                                <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                <input type="password" id="signup-password" class="auth-input" placeholder="Min. 8 characters" required autocomplete="new-password" minlength="8">
                                <button type="button" class="auth-toggle-pwd" id="signup-toggle-pwd" aria-label="Show password" title="Show password">
                                    <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                    <svg class="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                                </button>
                            </div>
                            <span class="auth-error" id="signup-password-error"></span>
                            <div class="auth-strength-meter" id="signup-strength-meter">
                                <div class="auth-strength-bar"><div class="auth-strength-fill" id="signup-strength-fill"></div></div>
                                <span class="auth-strength-text" id="signup-strength-text"></span>
                            </div>
                        </div>

                        <div class="auth-form-group" id="signup-confirm-group">
                            <label class="auth-label" for="signup-confirm">Confirm Password</label>
                            <div class="auth-input-wrapper">
                                <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                                <input type="password" id="signup-confirm" class="auth-input" placeholder="Re-enter password" required autocomplete="new-password">
                            </div>
                            <span class="auth-error" id="signup-confirm-error"></span>
                        </div>

                        <button type="submit" class="auth-submit-btn" id="signup-submit-btn">
                            <span class="auth-btn-text">Create Account</span>
                            <span class="auth-btn-spinner" style="display:none;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path></svg></span>
                        </button>
                    </form>

                    <p class="auth-switch-text">
                        Already have an account? <button type="button" class="auth-switch-link" data-switch="signin">Sign In</button>
                    </p>
                </div>

                <!-- Footer -->
                <div class="auth-card-footer">
                    <p class="auth-footer-text">By continuing, you agree to miniblogs' <a href="#" class="auth-footer-link">Terms of Service</a> and <a href="#" class="auth-footer-link">Privacy Policy</a>.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== FORGOT PASSWORD MODAL ========== -->
    <div class="auth-modal-backdrop" id="forgot-modal-backdrop"></div>
    <div class="auth-modal" id="forgot-modal" role="dialog" aria-labelledby="forgot-modal-title" aria-modal="true">
        <div class="auth-modal-header">
            <h2 id="forgot-modal-title" class="auth-modal-title">Reset your password</h2>
            <button type="button" class="auth-modal-close" id="forgot-modal-close" aria-label="Close modal"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
        </div>
        <div class="auth-modal-body">
            <p class="auth-modal-desc">Enter the email address associated with your account. We'll send you a link to reset your password.</p>
            <form id="forgot-form" class="auth-form" novalidate>
                <div class="auth-form-group" id="forgot-email-group">
                    <label class="auth-label" for="forgot-email">Email</label>
                    <div class="auth-input-wrapper">
                        <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                        <input type="email" id="forgot-email" class="auth-input" placeholder="name@example.com" required autocomplete="email">
                    </div>
                    <span class="auth-error" id="forgot-email-error"></span>
                </div>
                <button type="submit" class="auth-submit-btn" id="forgot-submit-btn">
                    <span class="auth-btn-text">Send Reset Link</span>
                    <span class="auth-btn-spinner" style="display:none;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path></svg></span>
                </button>
            </form>
            <div class="auth-modal-success" id="forgot-success" style="display:none;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <h3>Check your inbox!</h3>
                <p>We've sent a password reset link to your email.</p>
            </div>
        </div>
    </div>

    <!-- ========== TOAST ========== -->
    <div class="auth-toast" id="auth-toast" role="alert" aria-live="polite">
        <span class="auth-toast-icon" id="auth-toast-icon"></span>
        <span class="auth-toast-message" id="auth-toast-message"></span>
    </div>

    <!-- ========== INTERACTIVE SCRIPTS & EFFECTS ========== -->
    <script>
    (function() {
        'use strict';

        // =========================================
        // 1. DYNAMIC LITERARY QUOTE ROTATOR
        // =========================================
        const quotes = [
            { text: `"Words are, in my not-so-humble opinion, our most inexhaustible source of magic."`, author: "— J.K. Rowling" },
            { text: `"There is no greater agony than bearing an untold story inside you."`, author: "— Maya Angelou" },
            { text: `"You can make anything by writing."`, author: "— C.S. Lewis" },
            { text: `"Write what should not be forgotten."`, author: "— Isabel Allende" }
        ];

        let quoteIndex = 0;
        const quoteEl = document.getElementById('auth-quote');
        const quoteText = document.getElementById('quote-text');
        const quoteAuthor = document.getElementById('quote-author');

        if (quoteEl && quoteText && quoteAuthor) {
            setInterval(() => {
                quoteEl.classList.add('quote-transitioning');
                setTimeout(() => {
                    quoteIndex = (quoteIndex + 1) % quotes.length;
                    quoteText.textContent = quotes[quoteIndex].text;
                    quoteAuthor.textContent = quotes[quoteIndex].author;
                    quoteEl.classList.remove('quote-transitioning');
                }, 500);
            }, 7000);
        }

        // =========================================
        // 2. 3D MOUSE PARALLAX & DEPTH TRACKING
        // =========================================
        const hero = document.getElementById('auth-hero');
        const heroImg = document.getElementById('hero-img');
        const floatingPages = document.querySelectorAll('.floating-page');
        const heroContent = document.getElementById('hero-content');

        let mouseX = 0, mouseY = 0;
        let targetX = 0, targetY = 0;

        if (hero && window.matchMedia('(hover: hover) and (min-width: 900px)').matches) {
            hero.addEventListener('mousemove', (e) => {
                const rect = hero.getBoundingClientRect();
                const x = (e.clientX - rect.left) / rect.width - 0.5;
                const y = (e.clientY - rect.top) / rect.height - 0.5;
                targetX = x * 2;
                targetY = y * 2;
            });

            hero.addEventListener('mouseleave', () => {
                targetX = 0;
                targetY = 0;
            });

            function updateParallax() {
                mouseX += (targetX - mouseX) * 0.08;
                mouseY += (targetY - mouseY) * 0.08;

                if (heroImg) {
                    heroImg.style.transform = `scale(1.05) translate3d(${mouseX * -14}px, ${mouseY * -14}px, 0)`;
                }

                if (heroContent) {
                    heroContent.style.transform = `translate3d(${mouseX * 8}px, ${mouseY * 8}px, 0)`;
                }

                floatingPages.forEach((page) => {
                    const depth = parseFloat(page.dataset.depth) || 0.05;
                    const shiftX = mouseX * (depth * 500);
                    const shiftY = mouseY * (depth * 500);
                    const rotX = -mouseY * (depth * 200);
                    const rotY = mouseX * (depth * 200);
                    page.style.transform = `translate3d(${shiftX}px, ${shiftY}px, 0) rotateX(${rotX}deg) rotateY(${rotY}deg)`;
                });

                requestAnimationFrame(updateParallax);
            }
            updateParallax();
        }

        // =========================================
        // 3. CURSOR STARDUST PARTICLE CANVAS
        // =========================================
        const canvas = document.getElementById('auth-particle-canvas');
        if (canvas && hero) {
            const ctx = canvas.getContext('2d');
            let particles = [];

            function resizeCanvas() {
                canvas.width = hero.offsetWidth;
                canvas.height = hero.offsetHeight;
            }
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);

            class DustParticle {
                constructor(x, y) {
                    this.x = x + (Math.random() - 0.5) * 16;
                    this.y = y + (Math.random() - 0.5) * 16;
                    this.size = Math.random() * 2.5 + 1;
                    this.speedX = (Math.random() - 0.5) * 1.2;
                    this.speedY = -Math.random() * 1.5 - 0.5;
                    this.opacity = 1;
                    this.color = Math.random() > 0.4 ? '#F59E0B' : '#E06A3B';
                    this.decay = Math.random() * 0.02 + 0.015;
                }
                update() {
                    this.x += this.speedX;
                    this.y += this.speedY;
                    this.opacity -= this.decay;
                }
                draw() {
                    ctx.save();
                    ctx.globalAlpha = Math.max(0, this.opacity);
                    ctx.shadowBlur = 8;
                    ctx.shadowColor = this.color;
                    ctx.fillStyle = this.color;
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.restore();
                }
            }

            let lastSpawn = 0;
            hero.addEventListener('mousemove', (e) => {
                const now = Date.now();
                if (now - lastSpawn > 35) {
                    const rect = hero.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    particles.push(new DustParticle(x, y));
                    if (Math.random() > 0.5) particles.push(new DustParticle(x, y));
                    lastSpawn = now;
                }
            });

            function renderParticles() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (let i = particles.length - 1; i >= 0; i--) {
                    particles[i].update();
                    particles[i].draw();
                    if (particles[i].opacity <= 0) {
                        particles.splice(i, 1);
                    }
                }
                requestAnimationFrame(renderParticles);
            }
            renderParticles();
        }

        // =========================================
        // 4. CARD SPOTLIGHT TRACKER
        // =========================================
        const cardScroll = document.getElementById('auth-card-scroll');
        if (cardScroll) {
            cardScroll.addEventListener('mousemove', (e) => {
                const rect = cardScroll.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                cardScroll.style.setProperty('--mouse-x', `${x}px`);
                cardScroll.style.setProperty('--mouse-y', `${y}px`);
            });
        }

        // =========================================
        // 5. TAB SWITCHING
        // =========================================
        const tabs = document.querySelectorAll('.auth-tab');
        const panels = document.querySelectorAll('.auth-panel');
        const indicator = document.getElementById('auth-tab-indicator');
        const switchLinks = document.querySelectorAll('.auth-switch-link');

        function switchTab(tabName) {
            tabs.forEach(t => {
                const isActive = t.dataset.tab === tabName;
                t.classList.toggle('auth-tab--active', isActive);
                t.setAttribute('aria-selected', isActive);
            });
            panels.forEach(p => {
                p.classList.toggle('auth-panel--active', p.id === 'panel-' + tabName);
            });
            positionIndicator();
        }

        function positionIndicator() {
            const activeTab = document.querySelector('.auth-tab--active');
            if (activeTab && indicator) {
                indicator.style.width = activeTab.offsetWidth + 'px';
                indicator.style.left = activeTab.offsetLeft + 'px';
            }
        }

        tabs.forEach(tab => tab.addEventListener('click', () => switchTab(tab.dataset.tab)));
        switchLinks.forEach(link => link.addEventListener('click', () => switchTab(link.dataset.switch)));

        positionIndicator();
        window.addEventListener('resize', positionIndicator);

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('tab') === 'signup') switchTab('signup');

        // =========================================
        // 6. PASSWORD TOGGLE
        // =========================================
        document.querySelectorAll('.auth-toggle-pwd').forEach(btn => {
            btn.addEventListener('click', () => {
                const wrapper = btn.closest('.auth-input-wrapper');
                const input = wrapper.querySelector('.auth-input');
                const eyeOpen = btn.querySelector('.eye-open');
                const eyeClosed = btn.querySelector('.eye-closed');
                if (input.type === 'password') {
                    input.type = 'text';
                    eyeOpen.style.display = 'none';
                    eyeClosed.style.display = 'block';
                    btn.setAttribute('aria-label', 'Hide password');
                } else {
                    input.type = 'password';
                    eyeOpen.style.display = 'block';
                    eyeClosed.style.display = 'none';
                    btn.setAttribute('aria-label', 'Show password');
                }
                input.focus();
            });
        });

        // =========================================
        // 7. PASSWORD STRENGTH METER
        // =========================================
        const signupPwd = document.getElementById('signup-password');
        const strengthFill = document.getElementById('signup-strength-fill');
        const strengthText = document.getElementById('signup-strength-text');
        if (signupPwd) {
            signupPwd.addEventListener('input', () => {
                const val = signupPwd.value;
                const meter = document.getElementById('signup-strength-meter');
                if (!val) { meter.style.opacity = '0'; return; }
                meter.style.opacity = '1';
                let score = 0;
                if (val.length >= 8) score++;
                if (val.length >= 12) score++;
                if (/[a-z]/.test(val) && /[A-Z]/.test(val)) score++;
                if (/[0-9]/.test(val)) score++;
                if (/[^a-zA-Z0-9]/.test(val)) score++;
                const levels = [
                    { w: '10%', c: '#ef4444', t: 'Very Weak' },
                    { w: '25%', c: '#f97316', t: 'Weak' },
                    { w: '50%', c: '#eab308', t: 'Fair' },
                    { w: '75%', c: '#22c55e', t: 'Strong' },
                    { w: '90%', c: '#10b981', t: 'Very Strong' },
                    { w: '100%', c: '#06d6a0', t: 'Excellent' }
                ];
                const l = levels[score];
                strengthFill.style.width = l.w;
                strengthFill.style.background = l.c;
                strengthText.textContent = l.t;
                strengthText.style.color = l.c;
            });
        }

        // =========================================
        // 8. FORM VALIDATIONS & FEEDBACK
        // =========================================
        function showError(gId, eId, msg) {
            const g = document.getElementById(gId);
            const e = document.getElementById(eId);
            if (g) g.classList.add('auth-form-group--error');
            if (e) e.textContent = msg;
        }
        function clearError(gId, eId) {
            const g = document.getElementById(gId);
            const e = document.getElementById(eId);
            if (g) g.classList.remove('auth-form-group--error');
            if (e) e.textContent = '';
        }
        function clearAllErrors(prefix) {
            document.querySelectorAll(`[id^="${prefix}"]`).forEach(el => {
                if (el.classList) el.classList.remove('auth-form-group--error');
            });
            document.querySelectorAll('.auth-error').forEach(el => el.textContent = '');
        }
        function isValidEmail(e) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e); }
        function shakePanel() {
            const panel = document.querySelector('.auth-form-panel');
            panel.classList.add('auth-form-panel--shake');
            setTimeout(() => panel.classList.remove('auth-form-panel--shake'), 500);
        }

        const toast = document.getElementById('auth-toast');
        const toastIcon = document.getElementById('auth-toast-icon');
        const toastMsg = document.getElementById('auth-toast-message');
        let toastTimeout;
        function showToast(message, type) {
            clearTimeout(toastTimeout);
            toast.className = 'auth-toast auth-toast--' + type + ' auth-toast--visible';
            toastMsg.textContent = message;
            toastIcon.innerHTML = type === 'success'
                ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>'
                : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>';
            toastTimeout = setTimeout(() => toast.classList.remove('auth-toast--visible'), 4000);
        }

        // Sign In Submit
        document.getElementById('signin-form').addEventListener('submit', (e) => {
            e.preventDefault();
            clearAllErrors('signin');
            let valid = true;
            const email = document.getElementById('signin-email').value.trim();
            const pw = document.getElementById('signin-password').value;
            if (!email) { showError('signin-email-group', 'signin-email-error', 'Email is required.'); valid = false; }
            else if (!isValidEmail(email)) { showError('signin-email-group', 'signin-email-error', 'Please enter a valid email.'); valid = false; }
            if (!pw) { showError('signin-password-group', 'signin-password-error', 'Password is required.'); valid = false; }
            if (!valid) { shakePanel(); return; }
            const btn = document.getElementById('signin-submit-btn');
            btn.querySelector('.auth-btn-text').style.display = 'none';
            btn.querySelector('.auth-btn-spinner').style.display = 'inline-flex';
            btn.disabled = true;
            setTimeout(() => {
                btn.querySelector('.auth-btn-text').style.display = '';
                btn.querySelector('.auth-btn-spinner').style.display = 'none';
                btn.disabled = false;
                showToast('Sign in successful! Redirecting...', 'success');
                setTimeout(() => { window.location.href = '/'; }, 1500);
            }, 1800);
        });

        // Sign Up Submit
        document.getElementById('signup-form').addEventListener('submit', (e) => {
            e.preventDefault();
            clearAllErrors('signup');
            let valid = true;
            const name = document.getElementById('signup-name').value.trim();
            const email = document.getElementById('signup-email').value.trim();
            const pw = document.getElementById('signup-password').value;
            const confirm = document.getElementById('signup-confirm').value;
            if (!name) { showError('signup-name-group', 'signup-name-error', 'Display name is required.'); valid = false; }
            if (!email) { showError('signup-email-group', 'signup-email-error', 'Email is required.'); valid = false; }
            else if (!isValidEmail(email)) { showError('signup-email-group', 'signup-email-error', 'Please enter a valid email.'); valid = false; }
            if (!pw) { showError('signup-password-group', 'signup-password-error', 'Password is required.'); valid = false; }
            else if (pw.length < 8) { showError('signup-password-group', 'signup-password-error', 'Min. 8 characters required.'); valid = false; }
            if (!confirm) { showError('signup-confirm-group', 'signup-confirm-error', 'Please confirm your password.'); valid = false; }
            else if (pw !== confirm) { showError('signup-confirm-group', 'signup-confirm-error', 'Passwords do not match.'); valid = false; }
            if (!valid) { shakePanel(); return; }
            const btn = document.getElementById('signup-submit-btn');
            btn.querySelector('.auth-btn-text').style.display = 'none';
            btn.querySelector('.auth-btn-spinner').style.display = 'inline-flex';
            btn.disabled = true;
            setTimeout(() => {
                btn.querySelector('.auth-btn-text').style.display = '';
                btn.querySelector('.auth-btn-spinner').style.display = 'none';
                btn.disabled = false;
                showToast('Account created! Check your email to verify.', 'success');
            }, 1800);
        });

        // Forgot Password Modal
        const forgotTrigger = document.getElementById('forgot-password-trigger');
        const forgotBackdrop = document.getElementById('forgot-modal-backdrop');
        const forgotModal = document.getElementById('forgot-modal');
        const forgotClose = document.getElementById('forgot-modal-close');
        function openForgotModal() {
            forgotBackdrop.classList.add('auth-modal-backdrop--visible');
            forgotModal.classList.add('auth-modal--visible');
            document.body.style.overflow = 'hidden';
            document.getElementById('forgot-email').focus();
        }
        function closeForgotModal() {
            forgotBackdrop.classList.remove('auth-modal-backdrop--visible');
            forgotModal.classList.remove('auth-modal--visible');
            document.body.style.overflow = '';
            document.getElementById('forgot-form').style.display = '';
            document.getElementById('forgot-success').style.display = 'none';
            document.getElementById('forgot-email').value = '';
            clearError('forgot-email-group', 'forgot-email-error');
        }
        if (forgotTrigger) forgotTrigger.addEventListener('click', openForgotModal);
        if (forgotClose) forgotClose.addEventListener('click', closeForgotModal);
        if (forgotBackdrop) forgotBackdrop.addEventListener('click', closeForgotModal);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && forgotModal.classList.contains('auth-modal--visible')) closeForgotModal(); });

        document.getElementById('forgot-form').addEventListener('submit', (e) => {
            e.preventDefault();
            clearError('forgot-email-group', 'forgot-email-error');
            const email = document.getElementById('forgot-email').value.trim();
            if (!email) { showError('forgot-email-group', 'forgot-email-error', 'Email is required.'); return; }
            if (!isValidEmail(email)) { showError('forgot-email-group', 'forgot-email-error', 'Please enter a valid email.'); return; }
            const btn = document.getElementById('forgot-submit-btn');
            btn.querySelector('.auth-btn-text').style.display = 'none';
            btn.querySelector('.auth-btn-spinner').style.display = 'inline-flex';
            btn.disabled = true;
            setTimeout(() => {
                btn.querySelector('.auth-btn-text').style.display = '';
                btn.querySelector('.auth-btn-spinner').style.display = 'none';
                btn.disabled = false;
                document.getElementById('forgot-form').style.display = 'none';
                document.getElementById('forgot-success').style.display = 'flex';
            }, 1800);
        });

        // Clear error on input
        document.querySelectorAll('.auth-input').forEach(input => {
            input.addEventListener('input', () => {
                const group = input.closest('.auth-form-group');
                if (group) { group.classList.remove('auth-form-group--error'); const err = group.querySelector('.auth-error'); if (err) err.textContent = ''; }
            });
        });
    })();
    </script>
</body>
</html>
