<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>miniblogs - Login</title>
    <meta name="description" content="Sign in or create your miniblogs account to start writing and sharing stories.">
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="alternate icon" href="/images/favicon.svg">
    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Lora:ital,wght@0,400;0,600;1,400;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body class="dark-mode auth-body">
    <script>
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme) document.body.className = savedTheme + ' auth-body';
    </script>

    <!-- Top Minimal Navbar matching mockup -->
    <nav class="auth-top-nav" aria-label="Auth Navigation">
        <a href="/?guest=true" class="auth-nav-brand">miniblogs</a>
        <div class="auth-nav-links">
            <a href="/?guest=true" class="auth-nav-link" title="Explore stories without signing in">Explore Stories →</a>
        </div>
    </nav>

    <!-- ========== SPLIT-SCREEN AUTH PAGE ========== -->
    <div class="auth-split-exact" id="auth-page">

        <!-- ===== LEFT: Hero Panel with Inkwell & Golden Crane Vortex ===== -->
        <div class="auth-hero-exact" id="auth-hero">
            <!-- Center Glowing Inkwell Artwork -->
            <div class="auth-hero-visual-box">
                <img src="/images/login-hero.jpg" alt="Miniblogs Golden Inkwell Story Magic" class="auth-inkpot-img" id="hero-img">
                <canvas id="auth-particle-canvas"></canvas>
            </div>

            <!-- Bottom Left Brand & Quote -->
            <div class="auth-hero-bottom" id="hero-content">
                <h2 class="auth-brand-wordmark">miniblogs</h2>
                <p class="auth-hero-quote-exact" id="auth-quote">
                    <span id="quote-text">Words are, in my not-so-humble opinion, our most inexhaustible source of magic. (J.K. Rowling)</span>
                </p>
            </div>
        </div>

        <!-- ===== RIGHT: Floating Card Panel ===== -->
        <div class="auth-form-panel-exact" id="form-panel">
            <div class="auth-card-exact" id="auth-card">

                <!-- Tab Switcher -->
                <div class="auth-tabs-exact" role="tablist" aria-label="Authentication method">
                    <button class="auth-tab-exact auth-tab-exact--active" id="tab-signin" role="tab" aria-selected="true" data-tab="signin">Sign In</button>
                    <button class="auth-tab-exact" id="tab-signup" role="tab" aria-selected="false" data-tab="signup">Create Account</button>
                </div>

                <!-- ===== SIGN IN PANEL ===== -->
                <div class="auth-panel-exact auth-panel-exact--active" id="panel-signin" role="tabpanel">
                    <h1 class="auth-title-exact">Welcome Back</h1>
                    <p class="auth-subtitle-exact">Please sign in to continue.</p>

                    <form class="auth-form-exact" id="signin-form" novalidate>
                        <!-- Email -->
                        <div class="auth-field-exact" id="signin-email-group">
                            <label class="auth-field-label" for="signin-email">Email Address</label>
                            <div class="auth-input-container">
                                <input type="email" id="signin-email" class="auth-input-exact" placeholder="name@example.com" required autocomplete="email">
                            </div>
                            <span class="auth-error-msg" id="signin-email-error"></span>
                        </div>

                        <!-- Password -->
                        <div class="auth-field-exact" id="signin-password-group">
                            <label class="auth-field-label" for="signin-password">Password</label>
                            <div class="auth-input-container">
                                <input type="password" id="signin-password" class="auth-input-exact" placeholder="••••••••••••" required autocomplete="current-password">
                                <button type="button" class="auth-eye-btn" id="signin-toggle-pwd" aria-label="Toggle password visibility">
                                    <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                    <svg class="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                                </button>
                            </div>
                            <div class="auth-field-aux">
                                <div></div>
                                <button type="button" class="auth-forgot-link" id="forgot-password-trigger">Forgot Password?</button>
                            </div>
                            <span class="auth-error-msg" id="signin-password-error"></span>
                        </div>

                        <!-- Sign In CTA Button -->
                        <button type="submit" class="auth-cta-btn" id="signin-submit-btn">
                            <span class="auth-cta-text">Sign In</span>
                            <span class="auth-cta-spinner" style="display:none;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path></svg></span>
                        </button>
                    </form>

                    <!-- Divider -->
                    <div class="auth-divider-exact">
                        <span class="auth-divider-rule"></span>
                        <span class="auth-divider-label">or continue with</span>
                        <span class="auth-divider-rule"></span>
                    </div>

                    <!-- Social OAuth Buttons Row -->
                    <div class="auth-oauth-row">
                        <a href="/api/auth/oauth/google" class="auth-oauth-pill" id="google-signin-btn" title="Continue with Google">
                            <svg width="18" height="18" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                            <span>Continue with Google</span>
                        </a>
                    </div>

                    <!-- Skip / Sign in later option -->
                    <div class="auth-guest-row">
                        <a href="/?guest=true" class="auth-guest-btn" id="signin-guest-btn" title="Explore stories without signing in">
                            <span>Skip for now, explore stories</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </a>
                    </div>
                </div>

                <!-- ===== SIGN UP PANEL ===== -->
                <div class="auth-panel-exact" id="panel-signup" role="tabpanel">
                    <h1 class="auth-title-exact">Create Account</h1>
                    <p class="auth-subtitle-exact">Join miniblogs to start sharing stories.</p>

                    <form class="auth-form-exact" id="signup-form" novalidate>
                        <div class="auth-field-exact" id="signup-name-group">
                            <label class="auth-field-label" for="signup-name">Display Name</label>
                            <div class="auth-input-container">
                                <input type="text" id="signup-name" class="auth-input-exact" placeholder="Your name" required autocomplete="name">
                            </div>
                            <span class="auth-error-msg" id="signup-name-error"></span>
                        </div>

                        <div class="auth-field-exact" id="signup-email-group">
                            <label class="auth-field-label" for="signup-email">Email Address</label>
                            <div class="auth-input-container">
                                <input type="email" id="signup-email" class="auth-input-exact" placeholder="name@example.com" required autocomplete="email">
                            </div>
                            <span class="auth-error-msg" id="signup-email-error"></span>
                        </div>

                        <div class="auth-field-exact" id="signup-password-group">
                            <label class="auth-field-label" for="signup-password">Password</label>
                            <div class="auth-input-container">
                                <input type="password" id="signup-password" class="auth-input-exact" placeholder="Min. 8 characters" required autocomplete="new-password" minlength="8">
                                <button type="button" class="auth-eye-btn" id="signup-toggle-pwd" aria-label="Toggle password visibility">
                                    <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                    <svg class="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                                </button>
                            </div>
                            <span class="auth-error-msg" id="signup-password-error"></span>
                            <div class="auth-strength-meter" id="signup-strength-meter">
                                <div class="auth-strength-bar"><div class="auth-strength-fill" id="signup-strength-fill"></div></div>
                                <span class="auth-strength-text" id="signup-strength-text"></span>
                            </div>
                        </div>

                        <button type="submit" class="auth-cta-btn" id="signup-submit-btn">
                            <span class="auth-cta-text">Create Account</span>
                            <span class="auth-cta-spinner" style="display:none;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path></svg></span>
                        </button>
                    </form>

                    <!-- Divider -->
                    <div class="auth-divider-exact">
                        <span class="auth-divider-rule"></span>
                        <span class="auth-divider-label">or sign up with</span>
                        <span class="auth-divider-rule"></span>
                    </div>

                    <!-- Social OAuth Buttons Row -->
                    <div class="auth-oauth-row">
                        <a href="/api/auth/oauth/google" class="auth-oauth-pill" id="signup-google-btn" title="Continue with Google">
                            <svg width="18" height="18" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                            <span>Continue with Google</span>
                        </a>
                    </div>

                    <!-- Skip / Sign in later option -->
                    <div class="auth-guest-row">
                        <a href="/?guest=true" class="auth-guest-btn" id="signup-guest-btn" title="Explore stories without signing in">
                            <span>Skip for now, explore stories</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </a>
                    </div>
                <!-- ===== GITHUB-STYLE 2FA SECURITY VERIFICATION PANEL ===== -->
                <div class="auth-panel-exact" id="panel-2fa" role="tabpanel">
                    <div class="github-2fa-header">
                        <div class="github-shield-icon">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#FF8A00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        </div>
                        <h1 class="auth-title-exact" style="margin-top:10px;font-size:1.45rem;text-align:center;">Two-factor authentication</h1>
                        <p class="auth-subtitle-exact" id="twofa-instruction-text" style="margin-bottom:18px;text-align:center;font-size:0.86rem;line-height:1.45;">Open your two-factor authenticator (TOTP) app or browser extension to view your authentication code.</p>
                    </div>

                    <form class="auth-form-exact" id="twofa-login-form" novalidate>
                        <input type="hidden" id="twofa-temp-token" value="">
                        
                        <!-- Segmented 6-Digit Code Boxes (GitHub Style) -->
                        <div id="twofa-totp-container">
                            <label class="auth-field-label" style="text-align:center;display:block;margin-bottom:12px;font-size:0.84rem;font-weight:600;color:rgba(255,255,255,0.85);">Authentication code</label>
                            <div class="github-otp-box-group" id="github-otp-boxes">
                                <input type="text" class="github-otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off" data-index="0">
                                <input type="text" class="github-otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off" data-index="1">
                                <input type="text" class="github-otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off" data-index="2">
                                <span class="github-otp-divider">-</span>
                                <input type="text" class="github-otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off" data-index="3">
                                <input type="text" class="github-otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off" data-index="4">
                                <input type="text" class="github-otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off" data-index="5">
                            </div>
                        </div>

                        <!-- Recovery Code Mode (Hidden by default) -->
                        <div id="twofa-recovery-container" style="display:none;">
                            <label class="auth-field-label" for="twofa-recovery-code" style="text-align:center;display:block;margin-bottom:8px;font-size:0.84rem;font-weight:600;">Two-factor recovery code</label>
                            <div class="auth-input-container">
                                <input type="text" id="twofa-recovery-code" class="auth-input-exact" placeholder="XXXX-XXXX" maxlength="12" style="text-align:center;font-family:monospace;font-size:1.15rem;letter-spacing:2px;font-weight:700;">
                            </div>
                        </div>

                        <span class="auth-error-msg" id="twofa-code-error" style="text-align:center;display:block;margin-top:8px;"></span>

                        <button type="submit" class="auth-cta-btn" id="twofa-submit-btn" style="margin-top:14px;">
                            <span class="auth-cta-text">Verify</span>
                            <span class="auth-cta-spinner" style="display:none;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path></svg></span>
                        </button>
                    </form>

                    <div style="margin-top:20px;padding-top:16px;border-top:1px solid rgba(255,255,255,0.08);text-align:center;display:flex;flex-direction:column;gap:10px;">
                        <button type="button" class="auth-forgot-link" id="btn-toggle-backup-mode" style="font-size:0.84rem;font-weight:600;">Enter a two-factor recovery code</button>
                        <button type="button" class="auth-forgot-link" id="btn-2fa-back-to-login" style="font-size:0.8rem;color:rgba(255,255,255,0.45);">← Re-enter password or switch account</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== FORGOT PASSWORD MODAL ========== -->
    <div class="auth-modal-backdrop" id="forgot-modal-backdrop"></div>
    <div class="auth-modal" id="forgot-modal" role="dialog" aria-labelledby="forgot-modal-title" aria-modal="true">
        <div class="auth-modal-header">
            <h2 id="forgot-modal-title" class="auth-modal-title">Reset your password</h2>
            <button type="button" class="auth-modal-close" id="forgot-modal-close" aria-label="Close modal"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
        </div>
        <div class="auth-modal-body">
            <p class="auth-modal-desc">Enter the email address associated with your account. We'll send you a link to reset your password.</p>
            <form id="forgot-form" class="auth-form-exact" novalidate>
                <div class="auth-field-exact" id="forgot-email-group">
                    <label class="auth-field-label" for="forgot-email">Email</label>
                    <div class="auth-input-container">
                        <input type="email" id="forgot-email" class="auth-input-exact" placeholder="name@example.com" required autocomplete="email">
                    </div>
                    <span class="auth-error-msg" id="forgot-email-error"></span>
                </div>
                <button type="submit" class="auth-cta-btn" id="forgot-submit-btn">
                    <span class="auth-cta-text">Send Reset Link</span>
                    <span class="auth-cta-spinner" style="display:none;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path></svg></span>
                </button>
            </form>
            <div class="auth-modal-success" id="forgot-success" style="display:none;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <h3>Check your inbox!</h3>
                <p>We've sent a password reset link to your email.</p>
            </div>
        </div>
    </div>

    <!-- ========== TOAST ========== -->
    <div class="auth-toast" id="auth-toast" role="alert" aria-live="polite">
        <span class="auth-toast-icon" id="auth-toast-icon"></span>
        <span class="auth-toast-message" id="auth-toast-message"></span>
    </div>

    <!-- ========== SCRIPTS & INTERACTIONS ========== -->
    <script>
    (function() {
        'use strict';

        // === Tab Switching ===
        const tabs = document.querySelectorAll('.auth-tab-exact');
        const panels = document.querySelectorAll('.auth-panel-exact');

        function switchTab(tabName) {
            tabs.forEach(t => {
                const isActive = t.dataset.tab === tabName;
                t.classList.toggle('auth-tab-exact--active', isActive);
                t.setAttribute('aria-selected', isActive);
            });
            panels.forEach(p => {
                p.classList.toggle('auth-panel-exact--active', p.id === 'panel-' + tabName);
            });
        }

        tabs.forEach(tab => tab.addEventListener('click', () => switchTab(tab.dataset.tab)));

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('tab') === 'signup') switchTab('signup');

        // === 3D Parallax & Stardust on Inkwell Hero ===
        const hero = document.getElementById('auth-hero');
        const heroImg = document.getElementById('hero-img');
        const heroBottom = document.getElementById('hero-content');

        if (hero && heroImg && window.matchMedia('(hover: hover) and (min-width: 900px)').matches) {
            let mouseX = 0, mouseY = 0, targetX = 0, targetY = 0;

            hero.addEventListener('mousemove', (e) => {
                const rect = hero.getBoundingClientRect();
                targetX = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
                targetY = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
            });

            hero.addEventListener('mouseleave', () => { targetX = 0; targetY = 0; });

            function renderParallax() {
                mouseX += (targetX - mouseX) * 0.08;
                mouseY += (targetY - mouseY) * 0.08;
                heroImg.style.transform = `scale(1.03) translate3d(${mouseX * -12}px, ${mouseY * -12}px, 0) rotate(${mouseX * 1}deg)`;
                if (heroBottom) {
                    heroBottom.style.transform = `translate3d(${mouseX * 6}px, ${mouseY * 6}px, 0)`;
                }
                requestAnimationFrame(renderParallax);
            }
            renderParallax();
        }

        // Stardust Canvas
        const canvas = document.getElementById('auth-particle-canvas');
        if (canvas && hero) {
            const ctx = canvas.getContext('2d');
            let particles = [];
            function resizeCanvas() {
                canvas.width = canvas.parentElement.offsetWidth;
                canvas.height = canvas.parentElement.offsetHeight;
            }
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);

            class Sparkle {
                constructor(x, y) {
                    this.x = x + (Math.random() - 0.5) * 20;
                    this.y = y + (Math.random() - 0.5) * 20;
                    this.size = Math.random() * 2.5 + 1;
                    this.speedX = (Math.random() - 0.5) * 1.2;
                    this.speedY = -Math.random() * 1.5 - 0.5;
                    this.opacity = 1;
                    this.color = Math.random() > 0.4 ? '#FFB800' : '#FF7A00';
                    this.decay = Math.random() * 0.02 + 0.015;
                }
                update() { this.x += this.speedX; this.y += this.speedY; this.opacity -= this.decay; }
                draw() {
                    ctx.save();
                    ctx.globalAlpha = Math.max(0, this.opacity);
                    ctx.shadowBlur = 8;
                    ctx.shadowColor = this.color;
                    ctx.fillStyle = this.color;
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.restore();
                }
            }

            let lastSpawn = 0;
            hero.addEventListener('mousemove', (e) => {
                const now = Date.now();
                if (now - lastSpawn > 35) {
                    const rect = canvas.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    particles.push(new Sparkle(x, y));
                    lastSpawn = now;
                }
            });

            function loop() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (let i = particles.length - 1; i >= 0; i--) {
                    particles[i].update();
                    particles[i].draw();
                    if (particles[i].opacity <= 0) particles.splice(i, 1);
                }
                requestAnimationFrame(loop);
            }
            loop();
        }

        // === Password Toggle ===
        document.querySelectorAll('.auth-eye-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const container = btn.closest('.auth-input-container');
                const input = container.querySelector('.auth-input-exact');
                const eyeOpen = btn.querySelector('.eye-open');
                const eyeClosed = btn.querySelector('.eye-closed');
                if (input.type === 'password') {
                    input.type = 'text';
                    eyeOpen.style.display = 'none';
                    eyeClosed.style.display = 'block';
                } else {
                    input.type = 'password';
                    eyeOpen.style.display = 'block';
                    eyeClosed.style.display = 'none';
                }
                input.focus();
            });
        });

        // === Password Strength ===
        const signupPwd = document.getElementById('signup-password');
        const strengthFill = document.getElementById('signup-strength-fill');
        const strengthText = document.getElementById('signup-strength-text');
        if (signupPwd) {
            signupPwd.addEventListener('input', () => {
                const val = signupPwd.value;
                const meter = document.getElementById('signup-strength-meter');
                if (!val) { meter.style.opacity = '0'; return; }
                meter.style.opacity = '1';
                let score = 0;
                if (val.length >= 8) score++;
                if (val.length >= 12) score++;
                if (/[a-z]/.test(val) && /[A-Z]/.test(val)) score++;
                if (/[0-9]/.test(val)) score++;
                if (/[^a-zA-Z0-9]/.test(val)) score++;
                const levels = [
                    { w: '10%', c: '#ef4444', t: 'Very Weak' },
                    { w: '25%', c: '#f97316', t: 'Weak' },
                    { w: '50%', c: '#eab308', t: 'Fair' },
                    { w: '75%', c: '#22c55e', t: 'Strong' },
                    { w: '90%', c: '#10b981', t: 'Very Strong' },
                    { w: '100%', c: '#06d6a0', t: 'Excellent' }
                ];
                const l = levels[score];
                strengthFill.style.width = l.w;
                strengthFill.style.background = l.c;
                strengthText.textContent = l.t;
                strengthText.style.color = l.c;
            });
        }

        // === Form Validations ===
        function showError(gId, eId, msg) {
            const g = document.getElementById(gId);
            const e = document.getElementById(eId);
            if (g) g.classList.add('auth-field--error');
            if (e) e.textContent = msg;
        }
        function clearAllErrors(prefix) {
            document.querySelectorAll(`[id^="${prefix}"]`).forEach(el => {
                if (el.classList) el.classList.remove('auth-field--error');
            });
            document.querySelectorAll('.auth-error-msg').forEach(el => el.textContent = '');
        }
        function isValidEmail(e) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e); }
        function shakeCard() {
            const card = document.getElementById('auth-card');
            card.classList.add('auth-card--shake');
            setTimeout(() => card.classList.remove('auth-card--shake'), 500);
        }

        const toast = document.getElementById('auth-toast');
        const toastIcon = document.getElementById('auth-toast-icon');
        const toastMsg = document.getElementById('auth-toast-message');
        let toastTimeout;
        function showToast(message, type) {
            clearTimeout(toastTimeout);
            toast.className = 'auth-toast auth-toast--' + type + ' auth-toast--visible';
            toastMsg.textContent = message;
            toastIcon.innerHTML = type === 'success'
                ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>'
                : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>';
            toastTimeout = setTimeout(() => toast.classList.remove('auth-toast--visible'), 4000);
        }

        // Sign In Submit
        document.getElementById('signin-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            clearAllErrors('signin');
            let valid = true;
            const email = document.getElementById('signin-email').value.trim();
            const pw = document.getElementById('signin-password').value;
            if (!email) { showError('signin-email-group', 'signin-email-error', 'Email is required.'); valid = false; }
            else if (!isValidEmail(email)) { showError('signin-email-group', 'signin-email-error', 'Please enter a valid email.'); valid = false; }
            if (!pw) { showError('signin-password-group', 'signin-password-error', 'Password is required.'); valid = false; }
            if (!valid) { shakeCard(); return; }

            const btn = document.getElementById('signin-submit-btn');
            btn.querySelector('.auth-cta-text').style.display = 'none';
            btn.querySelector('.auth-cta-spinner').style.display = 'inline-flex';
            btn.disabled = true;

            try {
                const res = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ email, password: pw })
                });
                const data = await res.json();

                if (!res.ok || data.error) {
                    showError('signin-password-group', 'signin-password-error', data.error || 'Invalid credentials.');
                    shakeCard();
                    btn.querySelector('.auth-cta-text').style.display = '';
                    btn.querySelector('.auth-cta-spinner').style.display = 'none';
                    btn.disabled = false;
                    return;
                }

                // If user has Two-Factor Authentication enabled
                if (data.requires2FA) {
                    document.querySelector('.auth-tabs-exact').style.display = 'none';
                    panels.forEach(p => p.classList.remove('auth-panel-exact--active'));
                    const panel2FA = document.getElementById('panel-2fa');
                    panel2FA.classList.add('auth-panel-exact--active');
                    document.getElementById('twofa-temp-token').value = data.tempToken;
                    
                    // Reset and focus first box
                    otpDigits.forEach(d => d.value = '');
                    document.getElementById('twofa-code-error').textContent = '';
                    setTimeout(() => { if (otpDigits[0]) otpDigits[0].focus(); }, 100);

                    btn.querySelector('.auth-cta-text').style.display = '';
                    btn.querySelector('.auth-cta-spinner').style.display = 'none';
                    btn.disabled = false;
                    return;
                }

                showToast('Signed in successfully! Redirecting...', 'success');
                const redirectTarget = new URLSearchParams(window.location.search).get('redirect') || '/';
                setTimeout(() => { window.location.href = redirectTarget; }, 800);
            } catch (err) {
                console.error('Sign in error:', err);
                showError('signin-password-group', 'signin-password-error', 'An unexpected connection error occurred.');
                shakeCard();
                btn.querySelector('.auth-cta-text').style.display = '';
                btn.querySelector('.auth-cta-spinner').style.display = 'none';
                btn.disabled = false;
            }
        });

        // 2FA Back Button
        const btn2FABack = document.getElementById('btn-2fa-back-to-login');
        if (btn2FABack) {
            btn2FABack.addEventListener('click', () => {
                document.querySelector('.auth-tabs-exact').style.display = 'flex';
                panels.forEach(p => p.classList.remove('auth-panel-exact--active'));
                document.getElementById('panel-signin').classList.add('auth-panel-exact--active');
                document.getElementById('twofa-code-error').textContent = '';
            });
        }

        // GitHub 6-Digit Segmented Box Logic
        const otpDigits = Array.from(document.querySelectorAll('.github-otp-digit'));
        const twofaForm = document.getElementById('twofa-login-form');

        function getFullOTPCode() {
            return otpDigits.map(d => d.value).join('');
        }

        otpDigits.forEach((digit, idx) => {
            digit.addEventListener('input', (e) => {
                const val = digit.value.replace(/[^0-9]/g, '');
                digit.value = val ? val.slice(-1) : '';

                if (digit.value && idx < otpDigits.length - 1) {
                    otpDigits[idx + 1].focus();
                    otpDigits[idx + 1].select();
                }

                document.getElementById('twofa-code-error').textContent = '';

                // Auto-submit when all 6 digits are filled
                if (getFullOTPCode().length === 6) {
                    submit2FAVerification();
                }
            });

            digit.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace') {
                    if (!digit.value && idx > 0) {
                        otpDigits[idx - 1].focus();
                        otpDigits[idx - 1].value = '';
                    } else {
                        digit.value = '';
                    }
                } else if (e.key === 'ArrowLeft' && idx > 0) {
                    otpDigits[idx - 1].focus();
                } else if (e.key === 'ArrowRight' && idx < otpDigits.length - 1) {
                    otpDigits[idx + 1].focus();
                }
            });

            digit.addEventListener('paste', (e) => {
                e.preventDefault();
                const pasteData = (e.clipboardData || window.clipboardData).getData('text');
                const cleanDigits = pasteData.replace(/[^0-9]/g, '').slice(0, 6);
                if (cleanDigits) {
                    cleanDigits.split('').forEach((char, i) => {
                        if (otpDigits[i]) otpDigits[i].value = char;
                    });
                    if (cleanDigits.length < 6 && otpDigits[cleanDigits.length]) {
                        otpDigits[cleanDigits.length].focus();
                    } else if (cleanDigits.length === 6) {
                        otpDigits[5].focus();
                        submit2FAVerification();
                    }
                }
            });

            digit.addEventListener('focus', () => {
                digit.select();
            });
        });

        // 2FA Backup Recovery Code Mode Toggle
        let isBackupMode = false;
        const btnToggleBackup = document.getElementById('btn-toggle-backup-mode');
        const totpContainer = document.getElementById('twofa-totp-container');
        const recoveryContainer = document.getElementById('twofa-recovery-container');
        const recoveryInput = document.getElementById('twofa-recovery-code');
        const instructionText = document.getElementById('twofa-instruction-text');

        if (btnToggleBackup && totpContainer && recoveryContainer) {
            btnToggleBackup.addEventListener('click', () => {
                isBackupMode = !isBackupMode;
                document.getElementById('twofa-code-error').textContent = '';
                if (isBackupMode) {
                    totpContainer.style.display = 'none';
                    recoveryContainer.style.display = 'block';
                    instructionText.textContent = 'Enter one of the 8-character recovery codes you saved during 2FA setup.';
                    btnToggleBackup.textContent = 'Re-authenticate with two-factor authenticator app';
                    recoveryInput.value = '';
                    recoveryInput.focus();
                } else {
                    totpContainer.style.display = 'block';
                    recoveryContainer.style.display = 'none';
                    instructionText.textContent = 'Open your two-factor authenticator (TOTP) app or browser extension to view your authentication code.';
                    btnToggleBackup.textContent = 'Enter a two-factor recovery code';
                    otpDigits.forEach(d => d.value = '');
                    if (otpDigits[0]) otpDigits[0].focus();
                }
            });
        }

        async function submit2FAVerification() {
            const tempToken = document.getElementById('twofa-temp-token').value;
            const code = isBackupMode ? recoveryInput.value.trim() : getFullOTPCode().trim();
            const errEl = document.getElementById('twofa-code-error');
            errEl.textContent = '';

            if (!code || (!isBackupMode && code.length < 6)) {
                errEl.textContent = isBackupMode ? 'Please enter a recovery code.' : 'Please enter all 6 digits.';
                shakeCard();
                return;
            }

            const btn = document.getElementById('twofa-submit-btn');
            btn.querySelector('.auth-cta-text').style.display = 'none';
            btn.querySelector('.auth-cta-spinner').style.display = 'inline-flex';
            btn.disabled = true;

            try {
                const res = await fetch('/api/auth/2fa-verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ tempToken, code })
                });
                const data = await res.json();

                if (!res.ok || data.error) {
                    errEl.textContent = data.error || 'Invalid authentication code. Please try again.';
                    shakeCard();
                    btn.querySelector('.auth-cta-text').style.display = '';
                    btn.querySelector('.auth-cta-spinner').style.display = 'none';
                    btn.disabled = false;
                    if (!isBackupMode) {
                        otpDigits.forEach(d => d.value = '');
                        otpDigits[0].focus();
                    }
                    return;
                }

                showToast('Authentication successful! Redirecting...', 'success');
                const redirectTarget = new URLSearchParams(window.location.search).get('redirect') || '/';
                setTimeout(() => { window.location.href = redirectTarget; }, 750);
            } catch (err) {
                errEl.textContent = 'Connection error verifying 2FA.';
                shakeCard();
                btn.querySelector('.auth-cta-text').style.display = '';
                btn.querySelector('.auth-cta-spinner').style.display = 'none';
                btn.disabled = false;
            }
        }

        if (twofaForm) {
            twofaForm.addEventListener('submit', (e) => {
                e.preventDefault();
                submit2FAVerification();
            });
        }

        // Sign Up Submit
        document.getElementById('signup-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            clearAllErrors('signup');
            let valid = true;
            const name = document.getElementById('signup-name').value.trim();
            const email = document.getElementById('signup-email').value.trim();
            const pw = document.getElementById('signup-password').value;
            if (!name) { showError('signup-name-group', 'signup-name-error', 'Display name is required.'); valid = false; }
            if (!email) { showError('signup-email-group', 'signup-email-error', 'Email is required.'); valid = false; }
            else if (!isValidEmail(email)) { showError('signup-email-group', 'signup-email-error', 'Please enter a valid email.'); valid = false; }
            if (!pw) { showError('signup-password-group', 'signup-password-error', 'Password is required.'); valid = false; }
            else if (pw.length < 8) { showError('signup-password-group', 'signup-password-error', 'Min. 8 characters required.'); valid = false; }
            if (!valid) { shakeCard(); return; }

            const btn = document.getElementById('signup-submit-btn');
            btn.querySelector('.auth-cta-text').style.display = 'none';
            btn.querySelector('.auth-cta-spinner').style.display = 'inline-flex';
            btn.disabled = true;

            try {
                const res = await fetch('/api/auth/signup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ name, email, password: pw })
                });
                const data = await res.json();

                if (!res.ok || data.error) {
                    showError('signup-email-group', 'signup-email-error', data.error || 'Could not create account.');
                    shakeCard();
                    btn.querySelector('.auth-cta-text').style.display = '';
                    btn.querySelector('.auth-cta-spinner').style.display = 'none';
                    btn.disabled = false;
                    return;
                }

                if (data.requiresConfirmation) {
                    showToast('Account created! Please check your email to confirm.', 'success');
                    btn.querySelector('.auth-cta-text').style.display = '';
                    btn.querySelector('.auth-cta-spinner').style.display = 'none';
                    btn.disabled = false;
                } else {
                    showToast('Account created! Redirecting...', 'success');
                    setTimeout(() => { window.location.href = '/'; }, 900);
                }
            } catch (err) {
                console.error('Sign up error:', err);
                showError('signup-email-group', 'signup-email-error', 'An unexpected error occurred.');
                shakeCard();
                btn.querySelector('.auth-cta-text').style.display = '';
                btn.querySelector('.auth-cta-spinner').style.display = 'none';
                btn.disabled = false;
            }
        });

        // Forgot Modal
        const forgotTrigger = document.getElementById('forgot-password-trigger');
        const forgotBackdrop = document.getElementById('forgot-modal-backdrop');
        const forgotModal = document.getElementById('forgot-modal');
        const forgotClose = document.getElementById('forgot-modal-close');
        function openForgotModal() {
            forgotBackdrop.classList.add('auth-modal-backdrop--visible');
            forgotModal.classList.add('auth-modal--visible');
            document.getElementById('forgot-email').focus();
        }
        function closeForgotModal() {
            forgotBackdrop.classList.remove('auth-modal-backdrop--visible');
            forgotModal.classList.remove('auth-modal--visible');
            document.getElementById('forgot-form').style.display = '';
            document.getElementById('forgot-success').style.display = 'none';
            document.getElementById('forgot-email').value = '';
        }
        if (forgotTrigger) forgotTrigger.addEventListener('click', openForgotModal);
        if (forgotClose) forgotClose.addEventListener('click', closeForgotModal);
        if (forgotBackdrop) forgotBackdrop.addEventListener('click', closeForgotModal);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && forgotModal.classList.contains('auth-modal--visible')) closeForgotModal(); });

        document.getElementById('forgot-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('forgot-email').value.trim();
            if (!email || !isValidEmail(email)) { showError('forgot-email-group', 'forgot-email-error', 'Enter a valid email.'); return; }
            const btn = document.getElementById('forgot-submit-btn');
            btn.querySelector('.auth-cta-text').style.display = 'none';
            btn.querySelector('.auth-cta-spinner').style.display = 'inline-flex';
            btn.disabled = true;

            try {
                const res = await fetch('/api/auth/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });
                const data = await res.json();
                btn.querySelector('.auth-cta-text').style.display = '';
                btn.querySelector('.auth-cta-spinner').style.display = 'none';
                btn.disabled = false;
                document.getElementById('forgot-form').style.display = 'none';
                document.getElementById('forgot-success').style.display = 'flex';
            } catch (err) {
                btn.querySelector('.auth-cta-text').style.display = '';
                btn.querySelector('.auth-cta-spinner').style.display = 'none';
                btn.disabled = false;
                showError('forgot-email-group', 'forgot-email-error', 'Could not send reset link.');
            }
        });

        document.querySelectorAll('.auth-input-exact').forEach(input => {
            input.addEventListener('input', () => {
                const group = input.closest('.auth-field-exact');
                if (group) { group.classList.remove('auth-field--error'); const err = group.querySelector('.auth-error-msg'); if (err) err.textContent = ''; }
            });
        });
    })();
    </script>
</body>
</html>
