<%- include("partials/header.ejs") %>

<div class="article-reader-container">
    <div class="article-reader-layout">
        <!-- Main Article Column (Focused ~680px) -->
        <article class="single-post">
            <header class="post-header">
                <% if (post.tags && post.tags.length > 0) { %>
                    <div class="post-detail-tags">
                        <% post.tags.forEach(tag => { %>
                            <a href="/?tag=<%= encodeURIComponent(tag) %>" class="post-pill-tag">#<%= tag %></a>
                        <% }) %>
                    </div>
                <% } %>
                <h1 class="single-post-title"><%= post.title %></h1>
                <div class="post-meta post-meta-pills">
                    <a href="/profile/<%= encodeURIComponent(post.author_username || post.author_id || post.author) %>" class="meta-pill meta-author" title="View <%= post.author %>'s profile">
                        <svg class="meta-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <%= post.author %>
                    </a>
                    <span class="meta-pill meta-date">
                        <svg class="meta-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <%= post.date %>
                    </span>
                    <% if (post.readingTime) { %>
                        <span class="meta-pill meta-reading-time"><%= post.readingTime %> min read</span>
                    <% } %>
                </div>
            </header>

            <% if (post.coverImage || post.thumbnail) { %>
                <div class="article-lead-cover-wrapper">
                    <img src="<%= post.coverImage || post.thumbnail %>" alt="<%= post.title %>" class="article-lead-cover-img" loading="eager" fetchpriority="high" decoding="async">
                </div>
            <% } %>

            <!-- Inline Mobile Table of Contents (if headings exist) -->
            <div class="mobile-toc-accordion" id="mobile-toc-accordion" style="display: none;">
                <button type="button" class="mobile-toc-toggle" id="mobile-toc-toggle" aria-expanded="false">
                    <span>Table of Contents</span>
                    <svg class="toc-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="mobile-toc-list" id="mobile-toc-list"></div>
            </div>
            
            <div class="post-content medium-story-content" id="story-content-body">
                <% if (post.content && (post.content.includes('<p>') || post.content.includes('<div>') || post.content.includes('<h2>') || post.content.includes('<blockquote>') || post.content.includes('<ul>'))) { %>
                    <%- post.content %>
                <% } else { %>
                    <% (post.content || '').split('\n').forEach(paragraph => { %>
                        <% if (paragraph.trim()) { %>
                            <p><%= paragraph %></p>
                        <% } %>
                    <% }) %>
                <% } %>
            </div>
            
            <!-- Bottom Sharing & Actions Bar -->
            <div class="post-footer-actions-card">
                <div class="post-social-share-row">
                    <span class="share-label">Share this story:</span>
                    <div class="share-buttons-group">
                        <button type="button" class="btn-share-icon" id="share-copy-btn" title="Copy Link" aria-label="Copy story link">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                            <span class="share-btn-text">Copy Link</span>
                        </button>
                        <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title) %>&url=<%= encodeURIComponent('https://mini25.vercel.app/posts/' + post.id) %>" target="_blank" rel="noopener noreferrer" class="btn-share-icon" title="Share on X" aria-label="Share on X">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        </a>
                        <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent('https://mini25.vercel.app/posts/' + post.id) %>" target="_blank" rel="noopener noreferrer" class="btn-share-icon" title="Share on LinkedIn" aria-label="Share on LinkedIn">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                        </a>
                    </div>
                </div>

                <div class="post-actions">
                    <button type="button" class="btn btn-secondary post-page-clap-btn" id="post-page-clap-btn" data-id="<%= post.id %>" title="Clap / Applaud story">
                        <span class="clap-icon" style="font-size: 1.05rem; display: inline-block; transition: transform 0.2s cubic-bezier(0.16,1,0.3,1);">👏</span>
                        <span class="clap-btn-text" id="post-clap-text"><%= typeof post.claps !== 'undefined' ? post.claps : 0 %> Claps</span>
                    </button>
                    <button type="button" class="btn btn-secondary post-page-bookmark-btn" id="post-page-bookmark-btn" data-id="<%= post.id %>" data-title="<%= post.title %>" data-author="<%= post.author %>">
                        <svg class="post-action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <span class="bookmark-btn-text">Save Story</span>
                    </button>
                    <% if (typeof isAuthor !== 'undefined' && isAuthor) { %>
                        <a href="/edit/<%= post.id %>" class="btn btn-secondary">Edit Post</a>
                        <form action="/delete/<%= post.id %>" method="POST" style="display: inline;">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this post?');">Delete Post</button>
                        </form>
                    <% } %>
                </div>
            </div>

            <!-- Medium-style Responses -->
            <section class="responses-section" id="responses" aria-label="Responses">
                <div class="responses-head">
                    <h2>Responses <span class="responses-count" id="responses-count"><%= typeof responsesCount !== 'undefined' ? responsesCount : 0 %></span></h2>
                    <div class="responses-sort">
                        <span>Sort:</span>
                        <button type="button" class="sort-pill active" id="sort-relevant">Most relevant</button>
                        <button type="button" class="sort-pill" id="sort-newest">Newest</button>
                        <% if (typeof isAuthor !== 'undefined' && isAuthor) { %>
                        <button type="button" class="sort-pill" id="manage-discussion">⋯ Manage</button>
                        <% } %>
                    </div>
                </div>
                <% if (typeof discussionClosed !== 'undefined' && discussionClosed) { %>
                <div class="responses-closed">Discussion is closed for this story. Existing responses remain visible.</div>
                <% } %>
                <% if (typeof user !== 'undefined' && user && !(typeof discussionClosed !== 'undefined' && discussionClosed)) { %>
                <div class="response-composer">
                    <div class="composer-who"><span class="avatar-init"><%= (user.name || user.email || 'U').charAt(0).toUpperCase() %></span><span><%= user.name || 'You' %></span></div>
                    <div class="quote-preview" id="quote-preview" style="display:none"></div>
                    <textarea id="response-text" placeholder="What are your thoughts?" rows="3" maxlength="2000"></textarea>
                    <div class="composer-row"><span id="response-count">0 / 2000</span><button type="button" class="btn btn-primary" id="submit-response" data-post-id="<%= post.id %>">Respond</button></div>
                </div>
                <% } else if (!(typeof user !== 'undefined' && user)) { %>
                <div class="response-login"><a href="/login?redirect=<%= encodeURIComponent('/posts/' + post.id + '#responses') %>">Sign in</a> to respond.</div>
                <% } %>
                <div id="responses-list" data-post-id="<%= post.id %>" data-author="<%= post.author %>" data-is-author="<%= typeof isAuthor !== 'undefined' && isAuthor ? 'true' : 'false' %>" data-user-id="<%= typeof user !== 'undefined' && user ? user.id : '' %>">
                    <% (typeof responses !== 'undefined' ? responses : []).forEach(function(r) { %>
                    <div class="response-card" id="response-<%= r.id %>" data-id="<%= r.id %>">
                        <div class="r-head"><span class="avatar-init"><%= (r.authorName || 'U').charAt(0).toUpperCase() %></span><b><%= r.authorName %></b><% if (r.authorUsername) { %><span class="handle">@<%= r.authorUsername %></span><% } %><% if (typeof isAuthor !== 'undefined' && (r.authorName === post.author)) { %><span class="author-badge">Author</span><% } %><span class="time"><%= new Date(r.createdAt).toLocaleDateString(undefined, {month:'short', day:'numeric'}) %></span><% if (typeof isAuthor !== 'undefined' && isAuthor) { %><button type="button" class="hide-btn" data-id="<%= r.id %>" title="Hide response">⋯</button><% } %></div>
                        <% if (r.quotedText) { %><blockquote class="r-quote"><%= r.quotedText %></blockquote><% } %>
                        <div class="r-body"><%= r.content %></div>
                        <div class="r-foot"><button type="button" class="clap-btn <%= r.userClapped ? 'active' : '' %>" data-id="<%= r.id %>">👏 <span><%= r.claps || 0 %></span></button><button type="button" class="reply-btn" data-id="<%= r.id %>" data-post="<%= post.id %>">Reply</button><% if (r.replies && r.replies.length) { %><button type="button" class="toggle-replies" data-id="<%= r.id %>"><%= r.replies.length %> <%= r.replies.length === 1 ? 'reply' : 'replies' %></button><% } %></div>
                        <% if (r.replies && r.replies.length) { %>
                        <div class="replies" id="replies-<%= r.id %>" style="display:none">
                            <% r.replies.forEach(function(rep) { %>
                            <div class="response-card reply" id="response-<%= rep.id %>" data-id="<%= rep.id %>">
                                <div class="r-head"><span class="avatar-init sm"><%= (rep.authorName || 'U').charAt(0).toUpperCase() %></span><b><%= rep.authorName %></b><% if (typeof isAuthor !== 'undefined' && (rep.authorName === post.author)) { %><span class="author-badge">Author</span><% } %><span class="time"><%= new Date(rep.createdAt).toLocaleDateString(undefined, {month:'short', day:'numeric'}) %></span></div>
                                <div class="r-body"><%= rep.content %></div>
                                <div class="r-foot"><button type="button" class="clap-btn <%= rep.userClapped ? 'active' : '' %>" data-id="<%= rep.id %>">👏 <span><%= rep.claps || 0 %></span></button></div>
                            </div>
                            <% }) %>
                        </div>
                        <% } %>
                        <div class="reply-box" id="replybox-<%= r.id %>" style="display:none"><textarea placeholder="Write a reply..." rows="2" maxlength="2000"></textarea><div class="composer-row"><button type="button" class="btn btn-secondary cancel-reply" data-id="<%= r.id %>">Cancel</button><button type="button" class="btn btn-primary send-reply" data-post="<%= post.id %>" data-parent="<%= r.id %>">Reply</button></div></div>
                    </div>
                    <% }) %>
                    <% if (!(typeof responses !== 'undefined' && responses.length)) { %><div class="responses-empty">No responses yet. Be the first to share your thoughts.</div><% } %>
                </div>
            </section>
            <script>
            document.addEventListener('DOMContentLoaded', () => {
                const list = document.getElementById('responses-list');
                if (!list) return;
                const postId = list.getAttribute('data-post-id');
                const getCsrf = () => (document.cookie.match(/(?:^|;\s*)csrf_token=([^;]+)/) || [])[1] ? decodeURIComponent(document.cookie.match(/(?:^|;\s*)csrf_token=([^;]+)/)[1]) : '';
                const esc = (s) => String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
                let sort = 'relevant';
                const ta = document.getElementById('response-text');
                const cc = document.getElementById('response-count');
                if (ta && cc) ta.addEventListener('input', () => cc.textContent = ta.value.length + ' / 2000');
                async function reload(mode) {
                    sort = mode || sort;
                    document.getElementById('sort-relevant')?.classList.toggle('active', sort === 'relevant');
                    document.getElementById('sort-newest')?.classList.toggle('active', sort === 'newest');
                    try {
                        const res = await fetch('/api/posts/' + postId + '/responses?sort=' + (sort === 'newest' ? 'newest' : 'relevant'));
                        const data = await res.json();
                        if (res.ok && data.success) renderAll(data.responses || [], data.count || 0);
                    } catch (e) {}
                }
                document.getElementById('sort-relevant')?.addEventListener('click', () => reload('relevant'));
                document.getElementById('sort-newest')?.addEventListener('click', () => reload('newest'));
                function card(r, isReply) {
                    return '<div class="response-card' + (isReply ? ' reply' : '') + '" id="response-' + r.id + '" data-id="' + r.id + '">'
                        + '<div class="r-head"><span class="avatar-init' + (isReply ? ' sm' : '') + '">' + esc((r.authorName || 'U')[0].toUpperCase()) + '</span><b>' + esc(r.authorName) + '</b>'
                        + (r.authorUsername ? '<span class="handle">@' + esc(r.authorUsername) + '</span>' : '')
                        + '<span class="time">' + new Date(r.createdAt).toLocaleDateString(undefined, {month:'short', day:'numeric'}) + '</span></div>'
                        + (r.quotedText ? '<blockquote class="r-quote">' + esc(r.quotedText) + '</blockquote>' : '')
                        + '<div class="r-body">' + esc(r.content) + '</div>'
                        + '<div class="r-foot"><button type="button" class="clap-btn' + (r.userClapped ? ' active' : '') + '" data-id="' + r.id + '">👏 <span>' + (r.claps || 0) + '</span></button>'
                        + (!isReply ? '<button type="button" class="reply-btn" data-id="' + r.id + '">Reply</button>' : '')
                        + (!isReply && r.replies && r.replies.length ? '<button type="button" class="toggle-replies" data-id="' + r.id + '">' + r.replies.length + ' replies</button>' : '') + '</div>'
                        + (!isReply && r.replies && r.replies.length ? '<div class="replies" id="replies-' + r.id + '" style="display:none">' + r.replies.map(x => card(x, true)).join('') + '</div>' : '')
                        + (!isReply ? '<div class="reply-box" id="replybox-' + r.id + '" style="display:none"><textarea rows="2" maxlength="2000"></textarea><div class="composer-row"><button type="button" class="btn btn-secondary cancel-reply" data-id="' + r.id + '">Cancel</button><button type="button" class="btn btn-primary send-reply" data-post="' + postId + '" data-parent="' + r.id + '">Reply</button></div></div>' : '')
                        + '</div>';
                }
                function renderAll(items, count) {
                    document.getElementById('responses-count').textContent = count;
                    list.innerHTML = items.length ? items.map(x => card(x, false)).join('') : '<div class="responses-empty">No responses yet. Be the first to share your thoughts.</div>';
                }
                document.getElementById('submit-response')?.addEventListener('click', async (e) => {
                    const btn = e.currentTarget; const text = ta.value.trim();
                    if (!text) { ta.focus(); return; }
                    btn.disabled = true;
                    try {
                        const res = await fetch('/api/posts/' + postId + '/responses', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-csrf-token': getCsrf() }, body: JSON.stringify({ content: text, quoted_text: ta.dataset.quote || null }) });
                        const data = await res.json();
                        if (res.ok && data.success) { ta.value = ''; delete ta.dataset.quote; const qp = document.getElementById('quote-preview'); if (qp) qp.style.display = 'none'; cc.textContent = '0 / 2000'; reload(sort); }
                        else alert(data.error || 'Could not publish response.');
                    } catch (err) { alert('Network error.'); }
                    btn.disabled = false;
                });
                list.addEventListener('click', async (e) => {
                    const clap = e.target.closest('.clap-btn');
                    if (clap) {
                        const id = clap.getAttribute('data-id');
                        try {
                            const res = await fetch('/api/responses/' + id + '/clap', { method: 'POST', headers: { 'x-csrf-token': getCsrf() } });
                            const data = await res.json();
                            if (res.ok && data.success) { clap.querySelector('span').textContent = data.claps; clap.classList.toggle('active', data.userClapped); }
                            else if (res.status === 401) window.location.href = '/login?redirect=' + encodeURIComponent(location.pathname + '#responses');
                        } catch (err) {}
                        return;
                    }
                    const tg = e.target.closest('.toggle-replies');
                    if (tg) {
                        const box = document.getElementById('replies-' + tg.getAttribute('data-id'));
                        if (box) { const open = box.style.display !== 'none'; box.style.display = open ? 'none' : 'block'; tg.textContent = open ? tg.textContent.replace('Hide', '').trim() || box.children.length + ' replies' : 'Hide replies'; }
                        return;
                    }
                    const rb = e.target.closest('.reply-btn');
                    if (rb) {
                        const box = document.getElementById('replybox-' + rb.getAttribute('data-id'));
                        if (box) { box.style.display = box.style.display === 'none' ? 'block' : 'none'; box.querySelector('textarea')?.focus(); }
                        return;
                    }
                    const cb = e.target.closest('.cancel-reply');
                    if (cb) { document.getElementById('replybox-' + cb.getAttribute('data-id')).style.display = 'none'; return; }
                    const sr = e.target.closest('.send-reply');
                    if (sr) {
                        const pid = sr.getAttribute('data-parent');
                        const box = document.getElementById('replybox-' + pid);
                        const txt = box.querySelector('textarea').value.trim();
                        if (!txt) return;
                        sr.disabled = true;
                        try {
                            const res = await fetch('/api/posts/' + postId + '/responses', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-csrf-token': getCsrf() }, body: JSON.stringify({ content: txt, parentId: pid }) });
                            const data = await res.json();
                            if (res.ok && data.success) reload(sort); else alert(data.error || 'Could not publish reply.');
                        } catch (err) { alert('Network error.'); }
                        sr.disabled = false;
                        return;
                    }
                    const hb = e.target.closest('.hide-btn');
                    if (hb) {
                        if (!confirm('Hide this response?')) return;
                        try {
                            const res = await fetch('/api/responses/' + hb.getAttribute('data-id') + '/hide', { method: 'POST', headers: { 'x-csrf-token': getCsrf() } });
                            const data = await res.json();
                            if (res.ok && data.success) reload(sort); else alert(data.error || 'Could not hide.');
                        } catch (err) {}
                    }
                });
                // Inline quote-to-response: select story text shows quote in composer
                try {
                    const body = document.getElementById('story-content-body');
                    const qp = document.getElementById('quote-preview');
                    body?.addEventListener('mouseup', () => {
                        const sel = window.getSelection()?.toString().trim();
                        if (sel && sel.length > 10 && sel.length < 500 && qp && ta) {
                            qp.style.display = 'block';
                            qp.innerHTML = '<b>Quoting:</b> ' + esc(sel) + ' <button type="button" id="quote-use">Use quote</button> <button type="button" id="quote-clear">×</button>';
                            document.getElementById('quote-use').onclick = () => { ta.focus(); ta.dataset.quote = sel; document.getElementById('responses')?.scrollIntoView({behavior:'smooth'}); };
                            document.getElementById('quote-clear').onclick = () => { qp.style.display = 'none'; delete ta.dataset.quote; };
                        }
                    });
                    const origSubmit = document.getElementById('submit-response');
                } catch (e) {}
            });
            </script>
        </article>

        <!-- Sticky Reading Companion Sidebar (Desktop) -->
        <aside class="article-reading-companion" aria-label="Reading Tools">
            <!-- Sticky Table of Contents (Auto-updating anchors for long articles) -->
            <div class="companion-card companion-toc-card" id="desktop-toc-card" style="display: none;">
                <div class="companion-card-header">
                    <div class="toc-header-title-row">
                        <h4>Table of Contents</h4>
                        <span class="toc-progress-percentage" id="toc-progress-pct">0%</span>
                    </div>
                    <div class="toc-reading-progress-track">
                        <div class="toc-reading-progress-bar" id="toc-progress-bar"></div>
                    </div>
                </div>
                <nav class="companion-toc-nav" id="desktop-toc-nav"></nav>
            </div>

            <!-- Social Sharing Widget -->
            <div class="companion-card companion-share-card">
                <div class="companion-card-header">
                    <h4>Share Story</h4>
                </div>
                <div class="companion-share-buttons">
                    <button type="button" class="btn-companion-share" id="sidebar-share-copy" title="Copy Link">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                        <span id="copy-status-text">Copy Link</span>
                    </button>
                    <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title) %>&url=<%= encodeURIComponent('https://mini25.vercel.app/posts/' + post.id) %>" target="_blank" rel="noopener noreferrer" class="btn-companion-share" title="Share on X">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        <span>Share on X</span>
                    </a>
                </div>
            </div>

            <!-- Related Articles Widget -->
            <% if (typeof relatedPosts !== 'undefined' && relatedPosts.length > 0) { %>
                <div class="companion-card companion-related-card">
                    <div class="companion-card-header">
                        <h4>Related Reads</h4>
                    </div>
                    <div class="companion-related-list">
                        <% relatedPosts.forEach(rel => { %>
                            <a href="/posts/<%= rel.id %>" class="companion-related-item">
                                <span class="related-item-title"><%= rel.title %></span>
                                <span class="related-item-meta"><%= rel.readingTime %> min read • <%= rel.author %></span>
                            </a>
                        <% }) %>
                    </div>
                </div>
            <% } %>
        </aside>
    </div>

    <div class="back-link">
        <a href="/">← Back to All Stories</a>
    </div>
</div>

<script>
    // =========================================
    // Dynamic Table of Contents Generator & Reading Progress Tracker
    // =========================================
    document.addEventListener('DOMContentLoaded', () => {
        const contentBody = document.getElementById('story-content-body');
        if (!contentBody) return;

        const headings = Array.from(contentBody.querySelectorAll('h2, h3'));
        if (headings.length >= 2) {
            const desktopTocNav = document.getElementById('desktop-toc-nav');
            const desktopTocCard = document.getElementById('desktop-toc-card');
            const mobileTocList = document.getElementById('mobile-toc-list');
            const mobileTocAccordion = document.getElementById('mobile-toc-accordion');

            headings.forEach((heading, index) => {
                const id = 'section-' + (heading.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || index);
                heading.id = id;
                heading.classList.add('story-section-heading');

                // Append subtle heading anchor link
                const anchorLink = document.createElement('a');
                anchorLink.href = '#' + id;
                anchorLink.className = 'heading-anchor-symbol';
                anchorLink.setAttribute('aria-label', 'Anchor link to ' + heading.textContent.trim());
                anchorLink.textContent = '#';
                heading.appendChild(anchorLink);

                const text = heading.childNodes[0] ? heading.childNodes[0].textContent.trim() : heading.textContent.trim();
                const level = heading.tagName.toLowerCase();

                // Desktop link
                if (desktopTocNav) {
                    const link = document.createElement('a');
                    link.href = '#' + id;
                    link.className = 'companion-toc-link toc-level-' + level;
                    link.textContent = text;
                    desktopTocNav.appendChild(link);
                }

                // Mobile link
                if (mobileTocList) {
                    const mLink = document.createElement('a');
                    mLink.href = '#' + id;
                    mLink.className = 'mobile-toc-link toc-level-' + level;
                    mLink.textContent = text;
                    mLink.addEventListener('click', () => {
                        if (mobileTocAccordion) mobileTocAccordion.classList.remove('is-open');
                    });
                    mobileTocList.appendChild(mLink);
                }
            });

            if (desktopTocCard) desktopTocCard.style.display = 'block';
            if (mobileTocAccordion) mobileTocAccordion.style.display = 'block';

            // Active TOC link highlighting via IntersectionObserver
            const tocLinks = Array.from(document.querySelectorAll('.companion-toc-link'));
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const id = entry.target.id;
                        tocLinks.forEach(link => {
                            if (link.getAttribute('href') === '#' + id) {
                                link.classList.add('is-active');
                            } else {
                                link.classList.remove('is-active');
                            }
                        });
                    }
                });
            }, { rootMargin: '0px 0px -65% 0px', threshold: 0.1 });

            headings.forEach(h => observer.observe(h));
        }

        // Reading Progress Tracker (Auto-updating % and progress bar)
        const progressBar = document.getElementById('toc-progress-bar');
        const progressPct = document.getElementById('toc-progress-pct');
        function updateReadingProgress() {
            if (!contentBody || !progressBar) return;
            const rect = contentBody.getBoundingClientRect();
            const totalHeight = rect.height;
            const scrolledPast = Math.max(0, -rect.top + 100);
            const percentage = Math.min(100, Math.max(0, Math.round((scrolledPast / totalHeight) * 100)));
            progressBar.style.width = percentage + '%';
            if (progressPct) progressPct.textContent = percentage + '%';
        }
        window.addEventListener('scroll', updateReadingProgress, { passive: true });
        updateReadingProgress();

        // Mobile TOC Accordion Toggle
        const mobileTocToggle = document.getElementById('mobile-toc-toggle');
        const mobileTocAccordion = document.getElementById('mobile-toc-accordion');
        if (mobileTocToggle && mobileTocAccordion) {
            mobileTocToggle.addEventListener('click', () => {
                mobileTocAccordion.classList.toggle('is-open');
            });
        }

        // Copy Share Link Functionality
        const copyBtn = document.getElementById('share-copy-btn');
        const sidebarCopyBtn = document.getElementById('sidebar-share-copy');
        const copyStatusText = document.getElementById('copy-status-text');

        function triggerCopy() {
            navigator.clipboard.writeText(window.location.href).then(() => {
                if (copyStatusText) {
                    const orig = copyStatusText.textContent;
                    copyStatusText.textContent = 'Copied!';
                    setTimeout(() => copyStatusText.textContent = orig, 2000);
                }
                const btnText = copyBtn ? copyBtn.querySelector('.share-btn-text') : null;
                if (btnText) {
                    const orig = btnText.textContent;
                    btnText.textContent = 'Copied!';
                    setTimeout(() => btnText.textContent = orig, 2000);
                }
            }).catch(() => {});
        }

        // Interactive Clap / Applause Handler
        const clapBtn = document.getElementById('post-page-clap-btn');
        const clapText = document.getElementById('post-clap-text');
        if (clapBtn) {
            clapBtn.addEventListener('click', async () => {
                const postId = clapBtn.getAttribute('data-id');
                const icon = clapBtn.querySelector('.clap-icon');
                if (icon) {
                    icon.style.transform = 'scale(1.4) rotate(-15deg)';
                    setTimeout(() => { icon.style.transform = 'scale(1) rotate(0deg)'; }, 250);
                }
                try {
                    const res = await fetch('/api/posts/' + postId + '/clap', { method: 'POST' });
                    const data = await res.json();
                    if (res.ok && typeof data.totalClaps !== 'undefined') {
                        if (clapText) clapText.textContent = data.totalClaps + ' Claps';
                    }
                } catch (e) {
                    console.error('Error clapping:', e);
                }
            });
        }
    });
</script>

