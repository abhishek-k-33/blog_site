<%- include("partials/header.ejs") %>

<div class="article-reader-container">
    <div class="article-reader-layout">
        <!-- Main Article Column (Focused ~680px) -->
        <article class="single-post">
            <header class="post-header">
                <% if (post.tags && post.tags.length > 0) { %>
                    <div class="post-detail-tags">
                        <% post.tags.forEach(tag => { %>
                            <a href="/?tag=<%= encodeURIComponent(tag) %>" class="post-pill-tag">#<%= tag %></a>
                        <% }) %>
                    </div>
                <% } %>
                <h1 class="single-post-title"><%= post.title %></h1>
                <div class="post-meta post-meta-pills">
                    <a href="/profile/<%= encodeURIComponent(post.author_username || post.author_id || post.author) %>" class="meta-pill meta-author" title="View <%= post.author %>'s profile">
                        <svg class="meta-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <%= post.author %>
                    </a>
                    <span class="meta-pill meta-date">
                        <svg class="meta-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <%= post.date %>
                    </span>
                    <% if (post.readingTime) { %>
                        <span class="meta-pill meta-reading-time"><%= post.readingTime %> min read</span>
                    <% } %>
                </div>
            </header>

            <% if (post.coverImage || post.thumbnail) { %>
                <div class="article-lead-cover-wrapper">
                    <img src="<%= post.coverImage || post.thumbnail %>" alt="<%= post.title %>" class="article-lead-cover-img" loading="eager" fetchpriority="high" decoding="async">
                </div>
            <% } %>

            <!-- Inline Mobile Table of Contents (if headings exist) -->
            <div class="mobile-toc-accordion" id="mobile-toc-accordion" style="display: none;">
                <button type="button" class="mobile-toc-toggle" id="mobile-toc-toggle" aria-expanded="false">
                    <span>Table of Contents</span>
                    <svg class="toc-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="mobile-toc-list" id="mobile-toc-list"></div>
            </div>
            
            <div class="post-content medium-story-content" id="story-content-body">
                <% if (post.content && (post.content.includes('<p>') || post.content.includes('<div>') || post.content.includes('<h2>') || post.content.includes('<blockquote>') || post.content.includes('<ul>'))) { %>
                    <%- post.content %>
                <% } else { %>
                    <% (post.content || '').split('\n').forEach(paragraph => { %>
                        <% if (paragraph.trim()) { %>
                            <p><%= paragraph %></p>
                        <% } %>
                    <% }) %>
                <% } %>
            </div>
            
            <!-- Bottom Sharing & Actions Bar -->
            <div class="post-footer-actions-card">
                <div class="post-social-share-row">
                    <span class="share-label">Share this story:</span>
                    <div class="share-buttons-group">
                        <button type="button" class="btn-share-icon" id="share-copy-btn" title="Copy Link" aria-label="Copy story link">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                            <span class="share-btn-text">Copy Link</span>
                        </button>
                        <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title) %>&url=<%= encodeURIComponent('https://mini25.vercel.app/posts/' + post.id) %>" target="_blank" rel="noopener noreferrer" class="btn-share-icon" title="Share on X" aria-label="Share on X">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        </a>
                        <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent('https://mini25.vercel.app/posts/' + post.id) %>" target="_blank" rel="noopener noreferrer" class="btn-share-icon" title="Share on LinkedIn" aria-label="Share on LinkedIn">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                        </a>
                    </div>
                </div>

                <div class="post-actions">
                    <button type="button" class="btn btn-secondary post-page-clap-btn" id="post-page-clap-btn" data-id="<%= post.id %>" title="Clap / Applaud story">
                        <span class="clap-icon" style="font-size: 1.05rem; display: inline-block; transition: transform 0.2s cubic-bezier(0.16,1,0.3,1);">👏</span>
                        <span class="clap-btn-text" id="post-clap-text"><%= typeof post.claps !== 'undefined' ? post.claps : 0 %> Claps</span>
                    </button>
                    <button type="button" class="btn btn-secondary post-page-bookmark-btn" id="post-page-bookmark-btn" data-id="<%= post.id %>" data-title="<%= post.title %>" data-author="<%= post.author %>">
                        <svg class="post-action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <span class="bookmark-btn-text">Save Story</span>
                    </button>
                    <% if (typeof isAuthor !== 'undefined' && isAuthor) { %>
                        <a href="/edit/<%= post.id %>" class="btn btn-secondary">Edit Post</a>
                        <form action="/delete/<%= post.id %>" method="POST" style="display: inline;">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this post?');">Delete Post</button>
                        </form>
                    <% } %>
                </div>
            </div>

            <!-- ========================================= -->
            <!-- Comments & Discussion Section -->
            <!-- ========================================= -->
            <section class="post-discussion-section" id="post-discussion" aria-label="Responses and discussion">
                <div class="discussion-header-row">
                    <div class="discussion-header-title-wrap">
                        <h2 class="discussion-heading">
                            Discussion <span class="discussion-count-badge" id="discussion-count-badge"><%= typeof commentsCount !== 'undefined' ? commentsCount : (typeof comments !== 'undefined' && comments ? comments.length : 0) %></span>
                        </h2>
                        <p class="discussion-subheading">Share your perspective, ask questions, or engage with the author.</p>
                    </div>
                </div>

                <!-- Comment Composer Form -->
                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="comment-composer-card" id="main-comment-composer">
                        <div class="composer-author-bar">
                            <div class="composer-author-info">
                                <span class="user-avatar-initial" style="background: linear-gradient(135deg, #f59e0b, #ec4899);"><%= (user.name || user.email || 'U').charAt(0).toUpperCase() %></span>
                                <span class="composer-author-name"><%= user.name || (user.email ? user.email.split('@')[0] : 'User') %></span>
                            </div>
                            <div class="composer-tabs">
                                <button type="button" class="composer-tab-btn active" id="tab-write-btn">Write</button>
                                <button type="button" class="composer-tab-btn" id="tab-preview-btn">Preview</button>
                            </div>
                        </div>

                        <div class="composer-input-wrapper">
                            <textarea id="main-comment-textarea" class="comment-textarea" placeholder="What are your thoughts? (Markdown supported: **bold**, *italic*, `code`, > quote)" rows="3" maxlength="2000"></textarea>
                            <div id="main-comment-preview" class="comment-preview-area" style="display: none;"></div>
                        </div>

                        <div class="composer-footer-bar">
                            <div class="composer-formatting-hints">
                                <span class="hint-pill">Markdown supported</span>
                                <span class="composer-char-count" id="composer-char-count">0 / 2000</span>
                            </div>
                            <button type="button" class="btn btn-primary btn-submit-comment" id="btn-submit-main-comment" data-post-id="<%= post.id %>">
                                <span>Respond</span>
                            </button>
                        </div>
                    </div>
                <% } else { %>
                    <div class="comment-guest-prompt-card">
                        <div class="guest-prompt-content">
                            <div class="guest-prompt-icon">💬</div>
                            <div class="guest-prompt-text">
                                <h4>Join the conversation</h4>
                                <p>Sign in to share your thoughts, respond to other readers, and connect with <%= post.author %>.</p>
                            </div>
                        </div>
                        <a href="/login?redirect=<%= encodeURIComponent('/posts/' + post.id + '#post-discussion') %>" class="btn btn-secondary guest-signin-btn">
                            Sign In to Respond
                        </a>
                    </div>
                <% } %>

                <!-- Comment Thread List -->
                <div class="comments-thread-container" id="comments-thread-container">
                    <% if (typeof comments !== 'undefined' && comments && comments.length > 0) { %>
                        <% comments.forEach(comment => { %>
                            <div class="comment-thread-node" id="comment-node-<%= comment.id %>" data-comment-id="<%= comment.id %>">
                                <div class="comment-item-card">
                                    <div class="comment-item-header">
                                        <div class="comment-author-pill">
                                            <span class="user-avatar-initial" style="background: linear-gradient(135deg, #6366f1, #a855f7);"><%= (comment.authorName || 'U').charAt(0).toUpperCase() %></span>
                                            <div class="comment-author-meta">
                                                <span class="comment-author-display"><%= comment.authorName %></span>
                                                <% if (comment.authorUsername) { %>
                                                    <span class="comment-author-handle">@<%= comment.authorUsername %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="comment-meta-actions">
                                            <span class="comment-timestamp" title="<%= new Date(comment.createdAt).toLocaleString() %>">
                                                <%= new Date(comment.createdAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) %>
                                            </span>
                                            <% if (typeof user !== 'undefined' && user && (user.id === comment.authorId || (typeof isAuthor !== 'undefined' && isAuthor))) { %>
                                                <button type="button" class="btn-comment-delete" data-comment-id="<%= comment.id %>" title="Delete comment" aria-label="Delete comment">
                                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                </button>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="comment-item-body">
                                        <%- comment.content %>
                                    </div>

                                    <% if (typeof user !== 'undefined' && user) { %>
                                        <div class="comment-item-footer">
                                            <button type="button" class="btn-comment-reply" data-parent-id="<%= comment.id %>">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"></polyline><path d="M20 18v-2a4 4 0 0 0-4-4H4"></path></svg>
                                                <span>Reply</span>
                                            </button>
                                        </div>

                                        <!-- Inline Reply Box (Hidden until clicked) -->
                                        <div class="inline-reply-composer" id="reply-composer-<%= comment.id %>" style="display: none;">
                                            <textarea class="comment-textarea reply-textarea" placeholder="Write a reply..." rows="2" maxlength="2000"></textarea>
                                            <div class="reply-actions-row">
                                                <button type="button" class="btn btn-secondary btn-cancel-reply" data-parent-id="<%= comment.id %>">Cancel</button>
                                                <button type="button" class="btn btn-primary btn-submit-reply" data-post-id="<%= post.id %>" data-parent-id="<%= comment.id %>">Reply</button>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>

                                <!-- Nested Replies -->
                                <div class="nested-replies-list" id="replies-list-<%= comment.id %>">
                                    <% if (comment.replies && comment.replies.length > 0) { %>
                                        <% comment.replies.forEach(reply => { %>
                                            <div class="comment-thread-node reply-node" id="comment-node-<%= reply.id %>" data-comment-id="<%= reply.id %>">
                                                <div class="comment-item-card reply-item-card">
                                                    <div class="comment-item-header">
                                                        <div class="comment-author-pill">
                                                            <span class="user-avatar-initial reply-avatar" style="background: linear-gradient(135deg, #10b981, #06b6d4);"><%= (reply.authorName || 'U').charAt(0).toUpperCase() %></span>
                                                            <div class="comment-author-meta">
                                                                <span class="comment-author-display"><%= reply.authorName %></span>
                                                                <% if (reply.authorUsername) { %>
                                                                    <span class="comment-author-handle">@<%= reply.authorUsername %></span>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                        <div class="comment-meta-actions">
                                                            <span class="comment-timestamp" title="<%= new Date(reply.createdAt).toLocaleString() %>">
                                                                <%= new Date(reply.createdAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) %>
                                                            </span>
                                                            <% if (typeof user !== 'undefined' && user && (user.id === reply.authorId || (typeof isAuthor !== 'undefined' && isAuthor))) { %>
                                                                <button type="button" class="btn-comment-delete" data-comment-id="<%= reply.id %>" title="Delete reply" aria-label="Delete reply">
                                                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                                </button>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                    <div class="comment-item-body">
                                                        <%- reply.content %>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="empty-discussion-state" id="empty-discussion-state">
                            <span class="empty-icon">💭</span>
                            <p>No responses yet. Be the first to start the conversation!</p>
                        </div>
                    <% } %>
                </div>
            </section>
        </article>

        <!-- Sticky Reading Companion Sidebar (Desktop) -->
        <aside class="article-reading-companion" aria-label="Reading Tools">
            <!-- Sticky Table of Contents (Auto-updating anchors for long articles) -->
            <div class="companion-card companion-toc-card" id="desktop-toc-card" style="display: none;">
                <div class="companion-card-header">
                    <div class="toc-header-title-row">
                        <h4>Table of Contents</h4>
                        <span class="toc-progress-percentage" id="toc-progress-pct">0%</span>
                    </div>
                    <div class="toc-reading-progress-track">
                        <div class="toc-reading-progress-bar" id="toc-progress-bar"></div>
                    </div>
                </div>
                <nav class="companion-toc-nav" id="desktop-toc-nav"></nav>
            </div>

            <!-- Social Sharing Widget -->
            <div class="companion-card companion-share-card">
                <div class="companion-card-header">
                    <h4>Share Story</h4>
                </div>
                <div class="companion-share-buttons">
                    <button type="button" class="btn-companion-share" id="sidebar-share-copy" title="Copy Link">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                        <span id="copy-status-text">Copy Link</span>
                    </button>
                    <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title) %>&url=<%= encodeURIComponent('https://mini25.vercel.app/posts/' + post.id) %>" target="_blank" rel="noopener noreferrer" class="btn-companion-share" title="Share on X">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        <span>Share on X</span>
                    </a>
                </div>
            </div>

            <!-- Related Articles Widget -->
            <% if (typeof relatedPosts !== 'undefined' && relatedPosts.length > 0) { %>
                <div class="companion-card companion-related-card">
                    <div class="companion-card-header">
                        <h4>Related Reads</h4>
                    </div>
                    <div class="companion-related-list">
                        <% relatedPosts.forEach(rel => { %>
                            <a href="/posts/<%= rel.id %>" class="companion-related-item">
                                <span class="related-item-title"><%= rel.title %></span>
                                <span class="related-item-meta"><%= rel.readingTime %> min read • <%= rel.author %></span>
                            </a>
                        <% }) %>
                    </div>
                </div>
            <% } %>
        </aside>
    </div>

    <div class="back-link">
        <a href="/">← Back to All Stories</a>
    </div>
</div>

<script>
    // =========================================
    // Dynamic Table of Contents Generator & Reading Progress Tracker
    // =========================================
    document.addEventListener('DOMContentLoaded', () => {
        const contentBody = document.getElementById('story-content-body');
        if (!contentBody) return;

        const headings = Array.from(contentBody.querySelectorAll('h2, h3'));
        if (headings.length >= 2) {
            const desktopTocNav = document.getElementById('desktop-toc-nav');
            const desktopTocCard = document.getElementById('desktop-toc-card');
            const mobileTocList = document.getElementById('mobile-toc-list');
            const mobileTocAccordion = document.getElementById('mobile-toc-accordion');

            headings.forEach((heading, index) => {
                const id = 'section-' + (heading.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || index);
                heading.id = id;
                heading.classList.add('story-section-heading');

                // Append subtle heading anchor link
                const anchorLink = document.createElement('a');
                anchorLink.href = '#' + id;
                anchorLink.className = 'heading-anchor-symbol';
                anchorLink.setAttribute('aria-label', 'Anchor link to ' + heading.textContent.trim());
                anchorLink.textContent = '#';
                heading.appendChild(anchorLink);

                const text = heading.childNodes[0] ? heading.childNodes[0].textContent.trim() : heading.textContent.trim();
                const level = heading.tagName.toLowerCase();

                // Desktop link
                if (desktopTocNav) {
                    const link = document.createElement('a');
                    link.href = '#' + id;
                    link.className = 'companion-toc-link toc-level-' + level;
                    link.textContent = text;
                    desktopTocNav.appendChild(link);
                }

                // Mobile link
                if (mobileTocList) {
                    const mLink = document.createElement('a');
                    mLink.href = '#' + id;
                    mLink.className = 'mobile-toc-link toc-level-' + level;
                    mLink.textContent = text;
                    mLink.addEventListener('click', () => {
                        if (mobileTocAccordion) mobileTocAccordion.classList.remove('is-open');
                    });
                    mobileTocList.appendChild(mLink);
                }
            });

            if (desktopTocCard) desktopTocCard.style.display = 'block';
            if (mobileTocAccordion) mobileTocAccordion.style.display = 'block';

            if (mobileTocAccordion) {
                const toggle = document.getElementById('mobile-toc-toggle');
                if (toggle) {
                    toggle.addEventListener('click', () => {
                        const expanded = toggle.getAttribute('aria-expanded') === 'true';
                        toggle.setAttribute('aria-expanded', !expanded);
                        mobileTocAccordion.classList.toggle('is-open', !expanded);
                    });
                }
            }

            const desktopLinks = document.querySelectorAll('.companion-toc-link');
            const progressBar = document.getElementById('toc-progress-bar');
            const progressPct = document.getElementById('toc-progress-pct');

            function updateScrollProgress() {
                const winScroll = window.scrollY || document.documentElement.scrollTop;
                const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                const scrolled = height > 0 ? Math.min(100, Math.max(0, Math.round((winScroll / height) * 100))) : 0;
                
                if (progressBar) progressBar.style.width = scrolled + '%';
                if (progressPct) progressPct.textContent = scrolled + '%';

                let currentActiveId = '';
                headings.forEach(heading => {
                    const top = heading.getBoundingClientRect().top;
                    if (top <= 140) {
                        currentActiveId = heading.id;
                    }
                });

                desktopLinks.forEach(link => {
                    link.classList.toggle('active', link.getAttribute('href') === '#' + currentActiveId);
                });
            }

            window.addEventListener('scroll', updateScrollProgress, { passive: true });
            updateScrollProgress();
        }

        // Copy Share Link Helpers
        const shareCopyBtn = document.getElementById('share-copy-btn');
        const sidebarShareCopy = document.getElementById('sidebar-share-copy');
        const copyStatusText = document.getElementById('copy-status-text');

        if (shareCopyBtn) shareCopyBtn.addEventListener('click', () => triggerCopy(shareCopyBtn));
        if (sidebarShareCopy) sidebarShareCopy.addEventListener('click', () => triggerCopy(sidebarShareCopy));

        function triggerCopy(btn) {
            navigator.clipboard.writeText(window.location.href).then(() => {
                if (copyStatusText) {
                    const orig = copyStatusText.textContent;
                    copyStatusText.textContent = 'Copied!';
                    setTimeout(() => copyStatusText.textContent = orig, 2000);
                }
                const btnText = btn ? btn.querySelector('.share-btn-text') : null;
                if (btnText) {
                    const orig = btnText.textContent;
                    btnText.textContent = 'Copied!';
                    setTimeout(() => btnText.textContent = orig, 2000);
                }
            }).catch(() => {});
        }

        // Interactive Clap / Applause Handler
        const clapBtn = document.getElementById('post-page-clap-btn');
        const clapText = document.getElementById('post-clap-text');
        if (clapBtn) {
            clapBtn.addEventListener('click', async () => {
                const postId = clapBtn.getAttribute('data-id');
                const icon = clapBtn.querySelector('.clap-icon');
                if (icon) {
                    icon.style.transform = 'scale(1.4) rotate(-15deg)';
                    setTimeout(() => { icon.style.transform = 'scale(1) rotate(0deg)'; }, 250);
                }
                try {
                    const res = await fetch('/api/posts/' + postId + '/clap', { method: 'POST' });
                    const data = await res.json();
                    if (res.ok && typeof data.totalClaps !== 'undefined') {
                        if (clapText) clapText.textContent = data.totalClaps + ' Claps';
                    }
                } catch (e) {
                    console.error('Error clapping:', e);
                }
            });
        }

        // =========================================
        // Interactive Comments & Discussion Logic
        // =========================================
        function getCsrfToken() {
            const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]+)/);
            return match ? decodeURIComponent(match[1]) : '';
        }

        function simpleMarkdown(text) {
            if (!text) return '';
            const escaped = text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');

            return escaped
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/`([^`]+)`/g, '<code>$1</code>')
                .replace(/^>\s*(.+)$/gm, '<blockquote>$1</blockquote>')
                .replace(/\n\n+/g, '</p><p>')
                .replace(/\n/g, '<br>');
        }

        // Tabs: Write vs Preview
        const tabWriteBtn = document.getElementById('tab-write-btn');
        const tabPreviewBtn = document.getElementById('tab-preview-btn');
        const mainTextarea = document.getElementById('main-comment-textarea');
        const mainPreview = document.getElementById('main-comment-preview');
        const charCounter = document.getElementById('composer-char-count');

        if (mainTextarea && charCounter) {
            mainTextarea.addEventListener('input', () => {
                charCounter.textContent = mainTextarea.value.length + ' / 2000';
            });
        }

        if (tabWriteBtn && tabPreviewBtn && mainTextarea && mainPreview) {
            tabWriteBtn.addEventListener('click', () => {
                tabWriteBtn.classList.add('active');
                tabPreviewBtn.classList.remove('active');
                mainTextarea.style.display = 'block';
                mainPreview.style.display = 'none';
            });

            tabPreviewBtn.addEventListener('click', () => {
                tabPreviewBtn.classList.add('active');
                tabWriteBtn.classList.remove('active');
                mainTextarea.style.display = 'none';
                mainPreview.style.display = 'block';
                mainPreview.innerHTML = mainTextarea.value.trim() 
                    ? '<p>' + simpleMarkdown(mainTextarea.value.trim()) + '</p>' 
                    : '<span style="color: var(--text-muted); font-style: italic;">Nothing to preview yet.</span>';
            });
        }

        // Submit Main Comment
        const btnSubmitMain = document.getElementById('btn-submit-main-comment');
        if (btnSubmitMain && mainTextarea) {
            btnSubmitMain.addEventListener('click', async () => {
                const content = mainTextarea.value.trim();
                if (!content) {
                    mainTextarea.focus();
                    return;
                }
                const postId = btnSubmitMain.getAttribute('data-post-id');
                btnSubmitMain.disabled = true;
                btnSubmitMain.innerHTML = '<span>Posting...</span>';

                try {
                    const res = await fetch('/api/posts/' + postId + '/comments', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'x-csrf-token': getCsrfToken()
                        },
                        body: JSON.stringify({ content })
                    });
                    const data = await res.json();
                    if (res.ok && data.success && data.comment) {
                        mainTextarea.value = '';
                        if (charCounter) charCounter.textContent = '0 / 2000';
                        if (tabWriteBtn) tabWriteBtn.click();

                        // Append new comment to DOM
                        appendCommentNode(data.comment);

                        // Increment badge
                        updateCountBadge(1);
                    } else {
                        alert(data.error || 'Failed to post response. Please try again.');
                    }
                } catch (e) {
                    console.error('Error submitting comment:', e);
                    alert('Network error while posting comment.');
                } finally {
                    btnSubmitMain.disabled = false;
                    btnSubmitMain.innerHTML = '<span>Respond</span>';
                }
            });
        }

        // Reply Toggle and Submit Listeners
        const threadContainer = document.getElementById('comments-thread-container');
        if (threadContainer) {
            threadContainer.addEventListener('click', async (e) => {
                // Reply Toggle
                const replyBtn = e.target.closest('.btn-comment-reply');
                if (replyBtn) {
                    const parentId = replyBtn.getAttribute('data-parent-id');
                    const composer = document.getElementById('reply-composer-' + parentId);
                    if (composer) {
                        const isOpen = composer.style.display === 'block';
                        composer.style.display = isOpen ? 'none' : 'block';
                        if (!isOpen) {
                            const txt = composer.querySelector('.reply-textarea');
                            if (txt) txt.focus();
                        }
                    }
                    return;
                }

                // Cancel Reply
                const cancelBtn = e.target.closest('.btn-cancel-reply');
                if (cancelBtn) {
                    const parentId = cancelBtn.getAttribute('data-parent-id');
                    const composer = document.getElementById('reply-composer-' + parentId);
                    if (composer) composer.style.display = 'none';
                    return;
                }

                // Submit Reply
                const submitReplyBtn = e.target.closest('.btn-submit-reply');
                if (submitReplyBtn) {
                    const parentId = submitReplyBtn.getAttribute('data-parent-id');
                    const postId = submitReplyBtn.getAttribute('data-post-id');
                    const composer = document.getElementById('reply-composer-' + parentId);
                    const txt = composer ? composer.querySelector('.reply-textarea') : null;
                    const content = txt ? txt.value.trim() : '';
                    if (!content) {
                        if (txt) txt.focus();
                        return;
                    }

                    submitReplyBtn.disabled = true;
                    submitReplyBtn.textContent = 'Posting...';

                    try {
                        const res = await fetch('/api/posts/' + postId + '/comments', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'x-csrf-token': getCsrfToken()
                            },
                            body: JSON.stringify({ content, parentId })
                        });
                        const data = await res.json();
                        if (res.ok && data.success && data.comment) {
                            txt.value = '';
                            composer.style.display = 'none';
                            appendReplyNode(parentId, data.comment);
                            updateCountBadge(1);
                        } else {
                            alert(data.error || 'Failed to post reply.');
                        }
                    } catch (err) {
                        console.error('Error posting reply:', err);
                        alert('Network error while posting reply.');
                    } finally {
                        submitReplyBtn.disabled = false;
                        submitReplyBtn.textContent = 'Reply';
                    }
                    return;
                }

                // Delete Comment
                const deleteBtn = e.target.closest('.btn-comment-delete');
                if (deleteBtn) {
                    const commentId = deleteBtn.getAttribute('data-comment-id');
                    if (!confirm('Are you sure you want to delete this comment?')) return;

                    deleteBtn.disabled = true;
                    try {
                        const res = await fetch('/api/comments/' + commentId, {
                            method: 'DELETE',
                            headers: {
                                'x-csrf-token': getCsrfToken()
                            }
                        });
                        const data = await res.json();
                        if (res.ok && data.success) {
                            const node = document.getElementById('comment-node-' + commentId);
                            if (node) {
                                node.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
                                node.style.opacity = '0';
                                node.style.transform = 'translateY(-8px)';
                                setTimeout(() => {
                                    node.remove();
                                    updateCountBadge(-1);
                                    checkEmptyState();
                                }, 250);
                            }
                        } else {
                            alert(data.error || 'Failed to delete comment.');
                            deleteBtn.disabled = false;
                        }
                    } catch (err) {
                        console.error('Error deleting comment:', err);
                        alert('Network error while deleting comment.');
                        deleteBtn.disabled = false;
                    }
                }
            });
        }

        function updateCountBadge(delta) {
            const badge = document.getElementById('discussion-count-badge');
            if (badge) {
                const current = parseInt(badge.textContent, 10) || 0;
                badge.textContent = Math.max(0, current + delta);
            }
        }

        function checkEmptyState() {
            const container = document.getElementById('comments-thread-container');
            if (!container) return;
            const nodes = container.querySelectorAll('.comment-thread-node');
            if (nodes.length === 0) {
                container.innerHTML = `
                    <div class="empty-discussion-state" id="empty-discussion-state">
                        <span class="empty-icon">💭</span>
                        <p>No responses yet. Be the first to start the conversation!</p>
                    </div>
                `;
            }
        }

        function appendCommentNode(comment) {
            const container = document.getElementById('comments-thread-container');
            if (!container) return;

            const emptyState = document.getElementById('empty-discussion-state');
            if (emptyState) emptyState.remove();

            const initial = (comment.authorName || 'U').charAt(0).toUpperCase();
            const dateStr = 'Just now';

            const div = document.createElement('div');
            div.className = 'comment-thread-node';
            div.id = 'comment-node-' + comment.id;
            div.setAttribute('data-comment-id', comment.id);
            div.innerHTML = `
                <div class="comment-item-card">
                    <div class="comment-item-header">
                        <div class="comment-author-pill">
                            <span class="user-avatar-initial" style="background: linear-gradient(135deg, #6366f1, #a855f7);">${initial}</span>
                            <div class="comment-author-meta">
                                <span class="comment-author-display">${escapeHtml(comment.authorName)}</span>
                                ${comment.authorUsername ? `<span class="comment-author-handle">@${escapeHtml(comment.authorUsername)}</span>` : ''}
                            </div>
                        </div>
                        <div class="comment-meta-actions">
                            <span class="comment-timestamp">${dateStr}</span>
                            <button type="button" class="btn-comment-delete" data-comment-id="${comment.id}" title="Delete comment" aria-label="Delete comment">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </div>
                    </div>
                    <div class="comment-item-body">
                        ${comment.content}
                    </div>
                    <div class="comment-item-footer">
                        <button type="button" class="btn-comment-reply" data-parent-id="${comment.id}">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"></polyline><path d="M20 18v-2a4 4 0 0 0-4-4H4"></path></svg>
                            <span>Reply</span>
                        </button>
                    </div>
                    <div class="inline-reply-composer" id="reply-composer-${comment.id}" style="display: none;">
                        <textarea class="comment-textarea reply-textarea" placeholder="Write a reply..." rows="2" maxlength="2000"></textarea>
                        <div class="reply-actions-row">
                            <button type="button" class="btn btn-secondary btn-cancel-reply" data-parent-id="${comment.id}">Cancel</button>
                            <button type="button" class="btn btn-primary btn-submit-reply" data-post-id="${comment.postId}" data-parent-id="${comment.id}">Reply</button>
                        </div>
                    </div>
                </div>
                <div class="nested-replies-list" id="replies-list-${comment.id}"></div>
            `;
            container.prepend(div);
        }

        function appendReplyNode(parentId, reply) {
            let repliesList = document.getElementById('replies-list-' + parentId);
            if (!repliesList) {
                const parentNode = document.getElementById('comment-node-' + parentId);
                if (parentNode) {
                    repliesList = document.createElement('div');
                    repliesList.className = 'nested-replies-list';
                    repliesList.id = 'replies-list-' + parentId;
                    parentNode.appendChild(repliesList);
                }
            }
            if (!repliesList) return;

            const initial = (reply.authorName || 'U').charAt(0).toUpperCase();
            const div = document.createElement('div');
            div.className = 'comment-thread-node reply-node';
            div.id = 'comment-node-' + reply.id;
            div.setAttribute('data-comment-id', reply.id);
            div.innerHTML = `
                <div class="comment-item-card reply-item-card">
                    <div class="comment-item-header">
                        <div class="comment-author-pill">
                            <span class="user-avatar-initial reply-avatar" style="background: linear-gradient(135deg, #10b981, #06b6d4);">${initial}</span>
                            <div class="comment-author-meta">
                                <span class="comment-author-display">${escapeHtml(reply.authorName)}</span>
                                ${reply.authorUsername ? `<span class="comment-author-handle">@${escapeHtml(reply.authorUsername)}</span>` : ''}
                            </div>
                        </div>
                        <div class="comment-meta-actions">
                            <span class="comment-timestamp">Just now</span>
                            <button type="button" class="btn-comment-delete" data-comment-id="${reply.id}" title="Delete reply" aria-label="Delete reply">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </div>
                    </div>
                    <div class="comment-item-body">
                        ${reply.content}
                    </div>
                </div>
            `;
            repliesList.appendChild(div);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }
    });
</script>

