    <script>
        // Theme toggle logic (Checkbox Slider)
        const themeToggle = document.getElementById('theme-toggle');
        const body = document.body;
        
        if (themeToggle) {
            // Ensure checkbox state matches body class on load
            themeToggle.checked = body.classList.contains('dark-mode');
            
            themeToggle.addEventListener('change', (e) => {
                if (e.target.checked) {
                    body.className = 'dark-mode';
                    localStorage.setItem('theme', 'dark-mode');
                } else {
                    body.className = 'light-mode';
                    localStorage.setItem('theme', 'light-mode');
                }
            });
        }

        // =========================================
        // Dynamic Island Morphing & Progress Tracker (Zero Lag + Hysteresis)
        // =========================================
        const dynamicHeader = document.getElementById('dynamic-island-header');
        const progressBar = document.getElementById('pill-progress-bar');
        const dynamicPercent = document.getElementById('dynamic-percent');
        const dynamicTitle = document.getElementById('dynamic-title');

        // Check if there is a blog post title on the page
        const postHeading = document.querySelector('.post-header h2');
        if (postHeading && dynamicTitle) {
            const cleanTitle = postHeading.innerText.trim();
            dynamicTitle.innerText = cleanTitle.length > 18 ? cleanTitle.slice(0, 16) + '…' : cleanTitle;
        }

        let isTicking = false;
        let isMorphed = false;

        function updateDynamicIsland() {
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrollPercent = scrollHeight > 0 ? Math.min(100, Math.max(0, Math.round((scrollTop / scrollHeight) * 100))) : 0;

            if (progressBar) {
                progressBar.style.transform = `scaleX(${scrollPercent / 100})`;
            }
            if (dynamicPercent) {
                dynamicPercent.textContent = scrollPercent + '%';
            }

            if (dynamicHeader) {
                // Hysteresis threshold to prevent rapid toggle glitching near scroll boundary
                if (!isMorphed && scrollTop > 80) {
                    isMorphed = true;
                    dynamicHeader.classList.add('is-morphed');
                } else if (isMorphed && scrollTop < 35) {
                    isMorphed = false;
                    dynamicHeader.classList.remove('is-morphed');
                }
            }
            isTicking = false;
        }

        function onScrollRequest() {
            if (!isTicking) {
                window.requestAnimationFrame(updateDynamicIsland);
                isTicking = true;
            }
        }

        window.addEventListener('scroll', onScrollRequest, { passive: true });
        window.addEventListener('resize', onScrollRequest);
        updateDynamicIsland();
    </script>
    <!-- Syntax Highlighter Script -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script>
        // Run code highlighting
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof hljs !== 'undefined') {
                hljs.highlightAll();
            }

            // Attach Copy buttons to all code blocks
            document.querySelectorAll('.post-content pre').forEach((pre) => {
                const code = pre.querySelector('code');
                if (!code) return;

                const copyBtn = document.createElement('button');
                copyBtn.className = 'copy-code-btn';
                copyBtn.type = 'button';
                copyBtn.innerText = 'Copy';

                copyBtn.addEventListener('click', async () => {
                    try {
                        await navigator.clipboard.writeText(code.innerText);
                        copyBtn.innerText = 'Copied! ✓';
                        copyBtn.classList.add('copied');
                        setTimeout(() => {
                            copyBtn.innerText = 'Copy';
                            copyBtn.classList.remove('copied');
                        }, 2000);
                    } catch (err) {
                        copyBtn.innerText = 'Error';
                    }
                });

                pre.style.position = 'relative';
                pre.appendChild(copyBtn);
            });
        });
    </script>
