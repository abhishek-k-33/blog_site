<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>miniblogs</title>
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="alternate icon" href="/images/favicon.svg">
    <!-- Modern accessible 2-font typography system (Lora + Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body class="dark-mode">
    <script>
        // Apply saved theme immediately to prevent flashing
        //client side javascript which runs inside the users browser.

        const savedTheme = localStorage.getItem('theme');// browser has a build in localstrorage.It allows the browser.It allows website to store
        //small bits of text on the users computer so it remembers. Basically it remembers the theme.
        if (savedTheme) {
            document.body.className = savedTheme;
        }
    </script>

    <!-- ========== SPLASH INTRO ANIMATION ========== -->
    <div class="splash-overlay" id="splash-overlay">
        <div class="splash-content">
            <svg class="splash-logo" viewBox="0 0 100 112" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                    <linearGradient id="splashFoldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#d19a79"/>
                        <stop offset="100%" stop-color="#8c7aa9"/>
                    </linearGradient>
                    <filter id="splashFoldShadow" x="-30%" y="-30%" width="160%" height="160%">
                        <feDropShadow dx="-1.5" dy="2" stdDeviation="2" flood-color="#000000" flood-opacity="0.4"/>
                    </filter>
                </defs>

                <!-- Bubble body (WITHOUT the tail — tail is a separate element for wagging) -->
                <path class="splash-body"
                    d="M 20 8 L 65 8 L 65 24 Q 65 32, 73 32 L 88 32 L 88 72 Q 88 84, 76 84 L 20 84 Q 8 84, 8 72 L 8 20 Q 8 8, 20 8 Z"
                    fill="currentColor"/>

                <!-- Speech bubble tail (separate for wag animation) -->
                <path class="splash-tail"
                    d="M 36 84 L 16 100 L 20 84 Z"
                    fill="currentColor"/>

                <!-- Dog-ear fold (separate for fold-in animation) -->
                <path class="splash-fold"
                    d="M 65 8 L 88 32 L 73 32 Q 65 32, 65 24 Z"
                    fill="url(#splashFoldGrad)" filter="url(#splashFoldShadow)"/>

                <!-- Article skeleton lines (staggered fade-in) -->
                <rect class="splash-line splash-line-1" x="22" y="42" width="30" height="4.5" rx="2.25" fill="url(#splashFoldGrad)" opacity="0"/>
                <rect class="splash-line splash-line-2" x="22" y="52" width="46" height="4.5" rx="2.25" fill="url(#splashFoldGrad)" opacity="0"/>
                <rect class="splash-line splash-line-3" x="22" y="62" width="24" height="4.5" rx="2.25" fill="url(#splashFoldGrad)" opacity="0"/>
            </svg>
            <span class="splash-wordmark">miniblogs</span>
        </div>
    </div>
    <script>
        // Only show splash once per browser session
        (function() {
            const splash = document.getElementById('splash-overlay');
            if (sessionStorage.getItem('miniblogsSplashShown')) {
                splash.style.display = 'none';
            } else {
                sessionStorage.setItem('miniblogsSplashShown', 'true');
                // Remove splash from DOM after animation completes
                setTimeout(function() {
                    splash.style.pointerEvents = 'none';
                    splash.addEventListener('animationend', function() {
                        splash.remove();
                    });
                }, 2400);
            }
        })();
    </script>
    <!-- ========== FLOATING MEDIUM-STYLE SIDEBAR (SLIGHTLY ROUNDED CORNERS) ========== -->
    <aside class="floating-medium-sidebar" id="floating-pill-sidebar" aria-label="Sidebar Navigation">
        <div class="sidebar-card-track">
            <!-- Navigation Section -->
            <div class="sidebar-section">
                <span class="sidebar-section-label">Feed</span>
                <!-- Home -->
                <a href="/" class="sidebar-item-btn" id="sidebar-home" aria-label="Home Feed">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span class="sidebar-item-text">Home</span>
                    <span class="pill-tooltip">Home</span>
                </a>

                <!-- Saved / Library -->
                <button type="button" class="sidebar-item-btn" id="sidebar-bookmarks" aria-label="Saved Library">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <span class="sidebar-item-text">Library</span>
                    <span class="sidebar-badge" id="bookmark-count" style="display: none;">0</span>
                    <span class="pill-tooltip">Library</span>
                </button>

                <!-- Write / New Post -->
                <a href="/new" class="sidebar-item-btn sidebar-item-accent" id="sidebar-new" aria-label="Write New Story">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg>
                    <span class="sidebar-item-text">Write</span>
                    <span class="pill-tooltip">Write Story</span>
                </a>
            </div>

            <div class="sidebar-divider"></div>

            <!-- Topics Section -->
            <div class="sidebar-section sidebar-topics-section">
                <span class="sidebar-section-label">Topics</span>
                <a href="/?tag=Tech" class="sidebar-item-btn sidebar-topic-link" id="sidebar-topic-tech" aria-label="Topic Tech">
                    <span class="sidebar-topic-hash">#</span>
                    <span class="sidebar-item-text">Tech</span>
                    <span class="pill-tooltip">#Tech</span>
                </a>
                <a href="/?tag=Design" class="sidebar-item-btn sidebar-topic-link" id="sidebar-topic-design" aria-label="Topic Design">
                    <span class="sidebar-topic-hash">#</span>
                    <span class="sidebar-item-text">Design</span>
                    <span class="pill-tooltip">#Design</span>
                </a>
                <a href="/?tag=Thoughts" class="sidebar-item-btn sidebar-topic-link" id="sidebar-topic-thoughts" aria-label="Topic Thoughts">
                    <span class="sidebar-topic-hash">#</span>
                    <span class="sidebar-item-text">Thoughts</span>
                    <span class="pill-tooltip">#Thoughts</span>
                </a>
            </div>

            <div class="sidebar-divider"></div>

            <!-- Controls Section -->
            <div class="sidebar-section">
                <span class="sidebar-section-label">Options</span>
                <!-- Theme Toggle -->
                <button type="button" class="sidebar-item-btn" id="sidebar-theme-toggle" aria-label="Toggle Theme">
                    <span class="theme-icon-box">
                        <svg class="sidebar-icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                        </svg>
                        <svg class="sidebar-icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="5"></circle>
                            <line x1="12" y1="1" x2="12" y2="3"></line>
                            <line x1="12" y1="21" x2="12" y2="23"></line>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                            <line x1="1" y1="12" x2="3" y2="12"></line>
                            <line x1="21" y1="12" x2="23" y2="12"></line>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                        </svg>
                    </span>
                    <span class="sidebar-item-text" id="theme-label-text">Theme</span>
                    <span class="pill-tooltip" id="theme-tooltip-text">Toggle Theme</span>
                </button>

                <!-- Back to Top -->
                <button type="button" class="sidebar-item-btn" id="sidebar-scroll-top" aria-label="Scroll to Top">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15"></polyline>
                    </svg>
                    <span class="sidebar-item-text">Top</span>
                    <span class="pill-tooltip">Back to Top</span>
                </button>
            </div>
        </div>
    </aside>

    <header class="site-header pill-header" id="dynamic-island-header">
        <div class="pill-navbar" id="pill-navbar" role="navigation" aria-label="Main Navigation">
            <!-- Dynamic Scroll / Reading Progress Line -->
            <div class="pill-progress-bar" id="pill-progress-bar"></div>

            <div class="pill-content">
                <!-- Left: Interactive Logo Badge -->
                <div class="pill-left">
                    <a href="/" class="pill-logo" title="miniblogs home">
                        <span class="pill-logo-icon">
                            <svg class="pill-logo-svg" viewBox="0 0 100 108" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <defs>
                                    <linearGradient id="headerFoldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#d19a79"/>
                                        <stop offset="100%" stop-color="#8c7aa9"/>
                                    </linearGradient>
                                    <filter id="headerFoldShadow" x="-20%" y="-20%" width="140%" height="140%">
                                        <feDropShadow dx="-1" dy="1.5" stdDeviation="1.5" flood-color="#000000" flood-opacity="0.35"/>
                                    </filter>
                                </defs>
                                <!-- Bubble body (without tail) -->
                                <path class="header-logo-body" d="M 20 8 L 65 8 L 65 24 Q 65 32, 73 32 L 88 32 L 88 72 Q 88 84, 76 84 L 20 84 Q 8 84, 8 72 L 8 20 Q 8 8, 20 8 Z" fill="currentColor"/>
                                <!-- Tail (separate for wag on hover) -->
                                <path class="header-logo-tail" d="M 36 84 L 16 100 L 20 84 Z" fill="currentColor"/>
                                <!-- Dog-ear fold -->
                                <path class="header-logo-fold" d="M 65 8 L 88 32 L 73 32 Q 65 32, 65 24 Z" fill="url(#headerFoldGrad)" filter="url(#headerFoldShadow)"/>
                                <!-- Article lines -->
                                <rect x="22" y="42" width="30" height="4.5" rx="2.25" fill="url(#headerFoldGrad)" opacity="0.45"/>
                                <rect x="22" y="52" width="46" height="4.5" rx="2.25" fill="url(#headerFoldGrad)" opacity="0.3"/>
                                <rect x="22" y="62" width="24" height="4.5" rx="2.25" fill="url(#headerFoldGrad)" opacity="0.2"/>
                            </svg>
                        </span>
                        <span class="logo-text">miniblogs</span>
                    </a>
                </div>

                <!-- Center-Left: Primary Topic Categories (Desktop / Tablet) -->
                <nav class="navbar-topics-nav" aria-label="Topic Categories">
                    <a href="/?tag=Tech" class="nav-topic-link">#Tech</a>
                    <a href="/?tag=Design" class="nav-topic-link">#Design</a>
                    <a href="/?tag=Thoughts" class="nav-topic-link">#Thoughts</a>
                </nav>

                <!-- Center-Right: Glassmorphic Search Bar -->
                <div class="navbar-search-box" role="search">
                    <svg class="navbar-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="search" id="navbar-search-input" class="navbar-search-input" placeholder="Search..." aria-label="Search stories" autocomplete="off">
                </div>

                <!-- Center: Dynamic Island Scroll & Reading Tracker (Visible when scrolled on single post) -->
                <div class="pill-dynamic-info" id="pill-dynamic-info">
                    <span class="dynamic-dot"></span>
                    <span class="dynamic-title" id="dynamic-title">Reading</span>
                    <span class="dynamic-percent" id="dynamic-percent">0%</span>
                </div>

                <!-- Right: Navigation Controls & Actions -->
                <nav class="pill-nav" id="pill-nav">
                    <button type="button" class="btn-navbar-newsletter" id="navbar-newsletter-btn" title="Newsletter Subscription" aria-label="Newsletter Subscription">
                        <svg class="nav-newsletter-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                    </button>
                    <a href="/new" class="btn btn-pill-primary" aria-label="Create New Post">
                        <span class="btn-pill-text-desktop">+ New Post</span>
                        <span class="btn-pill-text-mobile">+ Write</span>
                    </a>
                    <div class="theme-switch-wrapper">
                        <label class="theme-switch" for="theme-toggle" title="Toggle Theme">
