<%- include("partials/header.ejs") %> <%# imports the header file%>

<div class="hero">
    <h2>Welcome to miniblogs</h2>
    <p>A chill place to write your thoughts.</p>
</div>

<!-- Topics / Tags Pill Filter Bar -->
<div class="topics-pill-bar-wrapper">
    <div class="topics-pill-bar" role="navigation" aria-label="Topic filter">
        <a href="/" class="topic-pill-chip <%= (!selectedTag || selectedTag === 'All') ? 'is-active' : '' %>">
            ✨ All Stories
        </a>
        <% if (typeof allTags !== 'undefined' && allTags.length > 0) { %>
            <% allTags.forEach(tag => { %>
                <a href="/?tag=<%= encodeURIComponent(tag) %>" class="topic-pill-chip <%= (selectedTag === tag) ? 'is-active' : '' %>">
                    #<%= tag %>
                    <% if (typeof tagCounts !== 'undefined' && tagCounts[tag]) { %>
                        <span class="topic-pill-count"><%= tagCounts[tag] %></span>
                    <% } %>
                </a>
            <% }) %>
        <% } %>
    </div>
</div>

<div class="posts-grid">
    <% if (posts.length > 0) { %>
        <% posts.forEach(post => { %>
            <article class="post-card">
                <% if (post.tags && post.tags.length > 0) { %>
                    <div class="post-tags-row">
                        <% post.tags.forEach(tag => { %>
                            <a href="/?tag=<%= encodeURIComponent(tag) %>" class="post-pill-tag">#<%= tag %></a>
                        <% }) %>
                    </div>
                <% } %>
                <h3 class="post-title"><a href="/posts/<%= post.id %>"><%= post.title %></a></h3>
                <div class="post-meta">
                    <span class="author">By <%= post.author %></span> • <span class="date"><%= post.date %></span>
                    <% if (post.readingTime) { %>
                        • <span class="reading-time">☕ <%= post.readingTime %> min read</span>
                    <% } %>
                </div>
                <p class="post-excerpt"><%= post.excerpt %></p>
                <div class="post-card-footer">
                    <a href="/posts/<%= post.id %>" class="read-more">Read Story →</a>
                    <button type="button" class="post-card-bookmark-btn" data-id="<%= post.id %>" data-title="<%= post.title %>" data-author="<%= post.author %>" title="Save to bookmarks" aria-label="Save to bookmarks">
                        <svg class="card-bookmark-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </button>
                </div>
            </article>
        <% }) %>
    <% } else { %>
        <div class="no-posts">
            <p>No stories found in this topic. <a href="/new">Be the first to write something!</a></p>
        </div>
    <% } %>
</div>

<%- include("partials/footer.ejs") %><%# includes the footer.      n %>