<%- include("partials/header.ejs") %> <%# imports the header file%>

<div class="hero">
    <h1 class="hero-title">Welcome to miniblogs</h1>
    <div class="hero-subtitle-container">
        <span class="hero-pill-badge">✨ A chill place to write your thoughts.</span>
    </div>
    <div class="hero-cta-wrapper">
        <a href="/new" class="hero-primary-cta" aria-label="Start writing a story">
            <span class="hero-cta-icon">✍️</span>
            <span class="hero-cta-label">Start Writing</span>
            <svg class="hero-cta-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </a>
    </div>
</div>

<!-- Topics / Tags Pill Filter Bar -->
<div class="topics-pill-bar-wrapper">
    <div class="topics-pill-bar" role="navigation" aria-label="Topic filter">
        <a href="/" class="topic-pill-chip <%= (!selectedTag || selectedTag === 'All') ? 'is-active' : '' %>">
            ✨ All Stories
        </a>
        <% if (typeof allTags !== 'undefined' && allTags.length > 0) { %>
            <% allTags.forEach(tag => { %>
                <a href="/?tag=<%= encodeURIComponent(tag) %>" class="topic-pill-chip <%= (selectedTag === tag) ? 'is-active' : '' %>">
                    #<%= tag %>
                    <% if (typeof tagCounts !== 'undefined' && tagCounts[tag]) { %>
                        <span class="topic-pill-count"><%= tagCounts[tag] %></span>
                    <% } %>
                </a>
            <% }) %>
        <% } %>
    </div>
</div>

<% if (selectedTag && selectedTag !== 'All') { %>
    <!-- Active Category / Tag Filter Status Banner -->
    <div class="active-tag-filter-banner">
        <div class="active-tag-info">
            <span class="active-tag-prefix">Showing stories tagged:</span>
            <span class="active-tag-badge">#<%= selectedTag %></span>
            <span class="active-tag-count">(<%= posts.length %> <%= posts.length === 1 ? 'story' : 'stories' %>)</span>
        </div>
        <a href="/" class="btn-clear-tag-filter" title="Clear topic filter" aria-label="Clear topic filter">
            <span>Clear Filter</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </a>
    </div>
<% } %>

<div class="posts-feed-container">
    <% if (posts.length > 0) { %>
        <% const featuredPost = posts[0]; %>
        <!-- Visually Distinct Top Featured Story Spotlight -->
        <section class="featured-story-spotlight" aria-label="Featured Story">
            <div class="featured-story-badge-row">
                <span class="featured-pill-badge">
                    <span class="featured-sparkle">⭐</span> Featured Spotlight
                </span>
                <% if (featuredPost.readingTime) { %>
                    <span class="meta-pill">☕ <%= featuredPost.readingTime %> min read</span>
                <% } %>
            </div>
            
            <article class="featured-story-card post-card">
                <div class="featured-card-cover-wrapper">
                    <% if (featuredPost.thumbnail) { %>
                        <a href="/posts/<%= featuredPost.id %>" class="featured-cover-link">
                            <img src="<%= featuredPost.thumbnail %>" alt="<%= featuredPost.title %>" class="featured-cover-img" loading="lazy" decoding="async">
                        </a>
                    <% } else { %>
                        <!-- Editorial Visual Cover Artwork -->
                        <div class="featured-cover-visual">
                            <div class="featured-cover-abstract-shapes">
                                <div class="featured-shape-glow"></div>
                                <div class="featured-shape-circle"></div>
                            </div>
                            <div class="featured-cover-overlay">
                                <% if (featuredPost.tags && featuredPost.tags.length > 0) { %>
                                <span class="featured-cover-topic">#<%= featuredPost.tags[0] %></span>
                                <% } else { %>
                                <span class="featured-cover-topic">#Featured</span>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>

                <div class="featured-card-body">
                    <% if (featuredPost.tags && featuredPost.tags.length > 0) { %>
                        <div class="post-tags-row">
                            <% featuredPost.tags.forEach(tag => { %>
                                <a href="/?tag=<%= encodeURIComponent(tag) %>" class="post-pill-tag">#<%= tag %></a>
                            <% }) %>
                        </div>
                    <% } %>

                    <h2 class="featured-title post-title">
                        <a href="/posts/<%= featuredPost.id %>"><%= featuredPost.title %></a>
                    </h2>

                    <div class="post-meta post-meta-pills">
                        <span class="meta-pill meta-author">
                            <svg class="meta-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            <%= featuredPost.author %>
                        </span>
                        <span class="meta-pill meta-date">
                            <svg class="meta-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            <%= featuredPost.date %>
                        </span>
                    </div>

                    <p class="featured-excerpt post-excerpt"><%= featuredPost.excerpt %></p>

                    <div class="featured-card-actions post-card-footer">
                        <a href="/posts/<%= featuredPost.id %>" class="btn btn-primary featured-cta">
                            <span>Read Full Story</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </a>
                        <button type="button" class="post-card-bookmark-btn" data-id="<%= featuredPost.id %>" data-title="<%= featuredPost.title %>" data-author="<%= featuredPost.author %>" title="Save to bookmarks" aria-label="Save to bookmarks">
                            <svg class="card-bookmark-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                        </button>
                    </div>
                </div>
            </article>
        </section>

        <!-- More Stories Grid -->
        <% if (posts.length > 1) { %>
            <div class="feed-section-header">
                <h3 class="feed-section-title">Latest Stories</h3>
                <span class="feed-count-pill"><%= posts.length - 1 %> <%= (posts.length - 1 === 1) ? 'story' : 'stories' %></span>
            </div>

            <div class="posts-grid">
                <% posts.slice(1).forEach(post => { %>
                    <article class="post-card feed-post-card">
                        <div class="card-thumbnail-container">
                            <% if (post.thumbnail) { %>
                                <a href="/posts/<%= post.id %>" class="card-thumbnail-link">
                                    <img src="<%= post.thumbnail %>" alt="<%= post.title %>" class="card-thumbnail-img" loading="lazy" decoding="async">
                                </a>
                            <% } else { %>
                                <a href="/posts/<%= post.id %>" class="card-thumbnail-fallback">
                                    <span class="card-thumbnail-topic"><%= (post.tags && post.tags[0]) ? '#' + post.tags[0] : '✨ Story' %></span>
                                    <span class="card-thumbnail-deco"></span>
                                </a>
                            <% } %>
                        </div>
                        <div class="card-content-wrap">
                            <% if (post.tags && post.tags.length > 0) { %>
                                <div class="post-tags-row">
                                    <% post.tags.forEach(tag => { %>
                                        <a href="/?tag=<%= encodeURIComponent(tag) %>" class="post-pill-tag">#<%= tag %></a>
                                    <% }) %>
                                </div>
                            <% } %>
                            <h3 class="post-title"><a href="/posts/<%= post.id %>"><%= post.title %></a></h3>
                            <div class="post-meta post-meta-pills">
                                <span class="meta-pill meta-author">
                                    <svg class="meta-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    <%= post.author %>
                                </span>
                                <span class="meta-pill meta-date">
                                    <svg class="meta-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    <%= post.date %>
                                </span>
                                <% if (post.readingTime) { %>
                                    <span class="meta-pill meta-reading-time">☕ <%= post.readingTime %> min read</span>
                                <% } %>
                            </div>
                            <p class="post-excerpt"><%= post.excerpt %></p>
                            <div class="post-card-footer">
                                <a href="/posts/<%= post.id %>" class="read-more">Read Story →</a>
                                <button type="button" class="post-card-bookmark-btn" data-id="<%= post.id %>" data-title="<%= post.title %>" data-author="<%= post.author %>" title="Save to bookmarks" aria-label="Save to bookmarks">
                                    <svg class="card-bookmark-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    <% } else { %>
        <div class="no-posts">
            <% if (selectedTag && selectedTag !== 'All') { %>
                <p>No stories found tagged with <strong>#<%= selectedTag %></strong>.</p>
                <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 14px;">
                    <a href="/" class="btn btn-secondary">Explore All Topics</a>
                    <a href="/new" class="btn btn-primary no-posts-cta">✍️ Write About #<%= selectedTag %></a>
                </div>
            <% } else { %>
                <p>No stories published yet. Be the first to share your thoughts!</p>
                <a href="/new" class="btn btn-primary no-posts-cta">✍️ Write the First Story</a>
            <% } %>
        </div>
    <% } %>
</div>

<%- include("partials/footer.ejs") %><%# includes the footer.      n %>