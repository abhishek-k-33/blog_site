<%- include("partials/header.ejs") %>
<link rel="stylesheet" href="/styles/profile.css">

<div class="profile-page-wrapper">
    <!-- ==================== HERO & IDENTITY CARD ==================== -->
    <div class="profile-hero-card">
        <!-- Cover Banner -->
        <div class="profile-cover-banner">
            <% if (profile.cover) { %>
                <img src="<%= profile.cover %>" alt="<%= profile.name %> Cover" class="profile-cover-img">
            <% } else { %>
                <div class="profile-cover-img" style="background: linear-gradient(135deg, #1c130d 0%, #30180a 40%, #151a24 100%);"></div>
            <% } %>
            <div class="profile-cover-overlay"></div>
        </div>

        <!-- Avatar & Main Info Row -->
        <div class="profile-identity-section">
            <div class="profile-avatar-row">
                <div class="profile-avatar-wrapper">
                    <% if (profile.avatar) { %>
                        <img src="<%= profile.avatar %>" alt="<%= profile.name %>" class="profile-avatar-img">
                    <% } else { %>
                        <div class="profile-avatar-placeholder">
                            <%= (profile.name || profile.email || 'A').charAt(0).toUpperCase() %>
                        </div>
                    <% } %>
                    <span class="profile-online-badge" title="Active Author"></span>
                </div>

                <!-- Profile Action Buttons -->
                <div class="profile-actions-group">
                    <% if (isOwner) { %>
                        <a href="/settings" class="btn-profile-primary" id="edit-profile-btn">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                            <span>Edit Profile</span>
                        </a>
                        <a href="/new" class="btn-profile-secondary">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            <span>New Story</span>
                        </a>
                    <% } else { %>
                        <button class="btn-profile-primary <%= isFollowing ? 'btn-profile-following' : '' %>" id="follow-author-btn" data-user-id="<%= profile.id %>">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                            <span id="follow-btn-text"><%= isFollowing ? 'Following' : 'Follow Author' %></span>
                        </button>
                    <% } %>
                </div>
            </div>

            <!-- Author Names & Badges -->
            <div class="profile-names-block">
                <div class="profile-full-name-row">
                    <h1 class="profile-display-name"><%= profile.name %></h1>
                    <span class="profile-badge-pill badge-top-writer" title="Top Writer">★ Top Writer</span>
                    <% if (profile.isPro) { %>
                        <span class="profile-badge-pill badge-pro" title="Pro Member">PRO MEMBER</span>
                    <% } %>
                </div>
                <p class="profile-username">@<%= profile.username || (profile.email ? profile.email.split('@')[0] : 'author') %></p>
            </div>

            <!-- Author Bio -->
            <% if (profile.bio) { %>
                <p class="profile-bio"><%= profile.bio %></p>
            <% } %>

            <!-- Metadata Chips (Location, Website, Phone, Social) -->
            <div class="profile-meta-chips">
                <% if (profile.location) { %>
                    <span class="profile-meta-item" title="Location">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        <span><%= profile.location %></span>
                    </span>
                <% } %>

                <% if (profile.website) { %>
                    <a href="<%= profile.website.startsWith('http') ? profile.website : 'https://' + profile.website %>" target="_blank" rel="noopener noreferrer" class="profile-meta-item" title="Website / Portfolio">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                        <span><%= profile.website.replace(/^https?:\/\//, '') %></span>
                    </a>
                <% } %>

                <% if (profile.phone) { %>
                    <span class="profile-meta-item" title="Contact Phone">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        <span><%= profile.phone %></span>
                    </span>
                <% } %>

                <% if (profile.social && profile.social.twitter) { %>
                    <a href="https://x.com/<%= profile.social.twitter.replace('@', '') %>" target="_blank" rel="noopener" class="profile-meta-item" title="Twitter / X">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        <span><%= profile.social.twitter %></span>
                    </a>
                <% } %>
            </div>

            <!-- Engagement Stats Grid -->
            <div class="profile-stats-grid">
                <div class="profile-stat-box is-network-clickable" id="stat-followers-box" role="button" tabindex="0" title="Click to view followers list" aria-label="View followers list">
                    <div class="stat-value" id="followers-count"><%= stats.followersCount || 0 %></div>
                    <div class="stat-label">Followers ↗</div>
                </div>
                <div class="profile-stat-box is-network-clickable" id="stat-following-box" role="button" tabindex="0" title="Click to view following list" aria-label="View following list">
                    <div class="stat-value" id="following-count"><%= stats.followingCount || 0 %></div>
                    <div class="stat-label">Following ↗</div>
                </div>
                <div class="profile-stat-box">
                    <div class="stat-value"><%= publishedPosts.length %></div>
                    <div class="stat-label">Published Stories</div>
                </div>
                <div class="profile-stat-box">
                    <div class="stat-value"><%= stats.totalReads || 0 %></div>
                    <div class="stat-label">Total Reads</div>
                </div>
                <div class="profile-stat-box">
                    <div class="stat-value">👏 <%= stats.totalApplause || 0 %></div>
                    <div class="stat-label">Applause</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== CONTENT & ACTIVITY TABS ==================== -->
    <div class="profile-tabs-nav" role="tablist">
        <button class="profile-tab-btn is-active" data-tab="published" role="tab" aria-selected="true">
            <span>Published Stories</span>
            <span class="tab-count-badge"><%= publishedPosts.length %></span>
        </button>

        <% if (isOwner) { %>
            <button class="profile-tab-btn" data-tab="drafts" role="tab" aria-selected="false">
                <span>Drafts & Pending</span>
                <span class="tab-count-badge"><%= drafts.length %></span>
            </button>
        <% } %>

        <button class="profile-tab-btn" data-tab="bookmarks" role="tab" aria-selected="false">
            <span>Saved Bookmarks</span>
            <span class="tab-count-badge"><%= bookmarks.length %></span>
        </button>

        <button class="profile-tab-btn" data-tab="activity" role="tab" aria-selected="false">
            <span>Community & Highlights</span>
        </button>

        <% if (isOwner) { %>
            <button class="profile-tab-btn" data-tab="analytics" role="tab" aria-selected="false">
                <span>Creator Analytics</span>
            </button>
        <% } %>
    </div>

    <!-- ==================== TAB 1: PUBLISHED POSTS ==================== -->
    <div class="profile-tab-panel is-active" id="panel-published" role="tabpanel">
        <% if (publishedPosts.length > 0) { %>
            <div class="posts-feed-container">
                <% publishedPosts.forEach(post => { %>
                    <article class="post-card" id="post-<%= post.id %>">
                        <% if (post.coverImage) { %>
                            <div class="post-card-cover-box">
                                <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="post-card-cover-img" loading="lazy">
                            </div>
                        <% } %>
                        <div class="post-card-body">
                            <div class="post-meta-row">
                                <span class="post-date"><%= post.formattedDate || post.date %></span>
                                <span class="meta-dot">·</span>
                                <span class="read-time"><%= post.readTime || '3 min read' %></span>
                                <% if (post.tags && post.tags.length > 0) { %>
                                    <span class="meta-dot">·</span>
                                    <span class="post-category-tag">#<%= post.tags[0] %></span>
                                <% } %>
                            </div>
                            <h2 class="post-title">
                                <a href="/posts/<%= post.id %>"><%= post.title %></a>
                            </h2>
                            <p class="post-snippet"><%= post.snippet || post.content.substring(0, 160) + '...' %></p>
                            <div class="post-footer-row">
                                <a href="/posts/<%= post.id %>" class="read-more-link">Read Story →</a>
                                <% if (isOwner) { %>
                                    <div class="post-owner-actions">
                                        <a href="/edit/<%= post.id %>" class="btn-post-action-edit" title="Edit story">Edit</a>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } else { %>
            <div class="profile-empty-state">
                <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                <h3>No stories published yet</h3>
                <p>When stories are published, they will appear here for all readers.</p>
                <% if (isOwner) { %>
                    <a href="/new" class="btn-profile-primary">+ Write First Story</a>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- ==================== TAB 2: DRAFTS (OWNER ONLY) ==================== -->
    <% if (isOwner) { %>
        <div class="profile-tab-panel" id="panel-drafts" role="tabpanel">
            <% if (drafts.length > 0) { %>
                <div class="posts-feed-container">
                    <% drafts.forEach(draft => { %>
                        <article class="post-card draft-card">
                            <div class="post-card-body">
                                <div class="post-meta-row">
                                    <span class="post-badge-draft">DRAFT</span>
                                    <span class="meta-dot">·</span>
                                    <span class="post-date">Last updated <%= draft.formattedDate || 'recently' %></span>
                                </div>
                                <h2 class="post-title"><a href="/edit/<%= draft.id %>"><%= draft.title || 'Untitled Draft' %></a></h2>
                                <p class="post-snippet"><%= draft.snippet || 'Work in progress story...' %></p>
                                <div class="post-footer-row">
                                    <a href="/edit/<%= draft.id %>" class="btn-profile-primary" style="padding: 6px 14px; font-size: 0.82rem;">Continue Editing →</a>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="profile-empty-state">
                    <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                    <h3>No drafts in progress</h3>
                    <p>Got an idea? Start writing a new story anytime.</p>
                    <a href="/new" class="btn-profile-primary">+ Start a Draft</a>
                </div>
            <% } %>
        </div>
    <% } %>

    <!-- ==================== TAB 3: BOOKMARKS ==================== -->
    <div class="profile-tab-panel" id="panel-bookmarks" role="tabpanel">
        <% if (bookmarks.length > 0) { %>
            <div class="posts-feed-container">
                <% bookmarks.forEach(item => { %>
                    <article class="post-card">
                        <div class="post-card-body">
                            <div class="post-meta-row">
                                <span class="post-date">By <%= item.author || 'Author' %></span>
                                <span class="meta-dot">·</span>
                                <span class="read-time"><%= item.readTime || '4 min read' %></span>
                            </div>
                            <h2 class="post-title"><a href="/posts/<%= item.id %>"><%= item.title %></a></h2>
                            <p class="post-snippet"><%= item.snippet %></p>
                            <div class="post-footer-row">
                                <a href="/posts/<%= item.id %>" class="read-more-link">Read Bookmarked Story →</a>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } else { %>
            <div class="profile-empty-state">
                <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                <h3>No saved stories yet</h3>
                <p>Bookmark articles you want to read later and find them organized here.</p>
                <a href="/" class="btn-profile-secondary">Explore Stories</a>
            </div>
        <% } %>
    </div>

    <!-- ==================== TAB 4: ACTIVITY ==================== -->
    <div class="profile-tab-panel" id="panel-activity" role="tabpanel">
        <div class="profile-empty-state">
            <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            <h3>Author Highlights & Discussions</h3>
            <p><%= profile.name %> has participated in community discussions and bookmarked inspirational stories across miniblogs.</p>
        </div>
    </div>

    <!-- ==================== TAB 5: ANALYTICS (OWNER ONLY) ==================== -->
    <% if (isOwner) { %>
        <div class="profile-tab-panel" id="panel-analytics" role="tabpanel">
            <div class="analytics-dashboard-grid">
                <div class="analytics-card">
                    <div class="analytics-title">Total Story Views</div>
                    <div class="analytics-num"><%= stats.totalReads || 0 %></div>
                    <div class="analytics-subtext"><%= stats.totalReads > 0 ? 'Live reader traffic' : 'No views recorded yet' %></div>
                </div>
                <div class="analytics-card">
                    <div class="analytics-title">Estimated Total Read Time</div>
                    <div class="analytics-num"><%= stats.readTimeHours || '0.0' %> <span style="font-size:1rem;font-weight:600;">hrs</span></div>
                    <div class="analytics-subtext">Based on story length & reader traffic</div>
                </div>
                <div class="analytics-card">
                    <div class="analytics-title">Total Applause / Claps</div>
                    <div class="analytics-num">👏 <%= stats.totalApplause || 0 %></div>
                    <div class="analytics-subtext">Live reader applause</div>
                </div>
                <div class="analytics-card">
                    <div class="analytics-title">Estimated Partner Earnings</div>
                    <div class="analytics-num">$<%= stats.estimatedEarnings || '0.00' %></div>
                    <div class="analytics-subtext">Based on reader views ($0.02 / read)</div>
                </div>
            </div>
        </div>
    <% } %>
</div>

<!-- ==================== FOLLOWERS / FOLLOWING NETWORK MODAL ==================== -->
<div class="network-modal-backdrop" id="network-modal" style="display:none;" aria-hidden="true">
    <div class="network-modal-card" role="dialog" aria-modal="true" aria-labelledby="network-modal-title">
        <div class="network-modal-header">
            <div class="network-modal-tabs">
                <button type="button" class="network-tab-btn is-active" id="modal-tab-followers" data-view="followers">
                    <span>Followers</span>
                    <span class="network-tab-badge" id="modal-followers-badge"><%= (typeof followersList !== 'undefined') ? followersList.length : 0 %></span>
                </button>
                <button type="button" class="network-tab-btn" id="modal-tab-following" data-view="following">
                    <span>Following</span>
                    <span class="network-tab-badge" id="modal-following-badge"><%= (typeof followingList !== 'undefined') ? followingList.length : 0 %></span>
                </button>
            </div>
            <button type="button" class="network-modal-close" id="close-network-modal" aria-label="Close modal">✕</button>
        </div>

        <div class="network-modal-search">
            <input type="text" id="network-search-input" class="network-search-field" placeholder="Search people by name or @username...">
        </div>

        <div class="network-modal-body">
            <!-- Followers List -->
            <div class="network-user-list" id="network-list-followers">
                <% if (typeof followersList !== 'undefined' && followersList.length > 0) { %>
                    <% followersList.forEach(userItem => { %>
                        <div class="network-user-card" data-name="<%= (userItem.name || '').toLowerCase() %>" data-username="<%= (userItem.username || '').toLowerCase() %>">
                            <a href="/profile/<%= encodeURIComponent(userItem.username || userItem.id) %>" class="network-user-avatar-link">
                                <% if (userItem.avatar) { %>
                                    <img src="<%= userItem.avatar %>" alt="<%= userItem.name %>" class="network-user-avatar-img">
                                <% } else { %>
                                    <div class="network-user-avatar-initial"><%= (userItem.name || 'U').charAt(0).toUpperCase() %></div>
                                <% } %>
                            </a>
                            <div class="network-user-info">
                                <div class="network-user-name-row">
                                    <a href="/profile/<%= encodeURIComponent(userItem.username || userItem.id) %>" class="network-user-name">
                                        <%= userItem.name %>
                                    </a>
                                    <% if (userItem.isFriend) { %>
                                        <span class="friend-badge" title="You both follow each other">🤝 Friend</span>
                                    <% } %>
                                </div>
                                <span class="network-user-handle">@<%= userItem.username %></span>
                                <% if (userItem.bio) { %>
                                    <p class="network-user-bio"><%= userItem.bio.substring(0, 80) %><%= userItem.bio.length > 80 ? '...' : '' %></p>
                                <% } %>
                            </div>
                            <div class="network-user-action">
                                <a href="/profile/<%= encodeURIComponent(userItem.username || userItem.id) %>" class="btn-network-view">View</a>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="network-empty-state">
                        <p>No followers yet.</p>
                    </div>
                <% } %>
            </div>

            <!-- Following List -->
            <div class="network-user-list" id="network-list-following" style="display: none;">
                <% if (typeof followingList !== 'undefined' && followingList.length > 0) { %>
                    <% followingList.forEach(userItem => { %>
                        <div class="network-user-card" data-name="<%= (userItem.name || '').toLowerCase() %>" data-username="<%= (userItem.username || '').toLowerCase() %>">
                            <a href="/profile/<%= encodeURIComponent(userItem.username || userItem.id) %>" class="network-user-avatar-link">
                                <% if (userItem.avatar) { %>
                                    <img src="<%= userItem.avatar %>" alt="<%= userItem.name %>" class="network-user-avatar-img">
                                <% } else { %>
                                    <div class="network-user-avatar-initial"><%= (userItem.name || 'U').charAt(0).toUpperCase() %></div>
                                <% } %>
                            </a>
                            <div class="network-user-info">
                                <div class="network-user-name-row">
                                    <a href="/profile/<%= encodeURIComponent(userItem.username || userItem.id) %>" class="network-user-name">
                                        <%= userItem.name %>
                                    </a>
                                    <% if (userItem.isFriend) { %>
                                        <span class="friend-badge" title="You both follow each other">🤝 Friend</span>
                                    <% } %>
                                </div>
                                <span class="network-user-handle">@<%= userItem.username %></span>
                                <% if (userItem.bio) { %>
                                    <p class="network-user-bio"><%= userItem.bio.substring(0, 80) %><%= userItem.bio.length > 80 ? '...' : '' %></p>
                                <% } %>
                            </div>
                            <div class="network-user-action">
                                <a href="/profile/<%= encodeURIComponent(userItem.username || userItem.id) %>" class="btn-network-view">View</a>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="network-empty-state">
                        <p>Not following anyone yet.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<style>
/* Clickable Stat Boxes */
.profile-stat-box.is-network-clickable {
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    position: relative;
    user-select: none;
}
.profile-stat-box.is-network-clickable:hover {
    transform: translateY(-2px);
    border-color: var(--accent-color);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    background: rgba(255, 138, 0, 0.05);
}
.profile-stat-box.is-network-clickable:active {
    transform: scale(0.97);
}

/* Network Modal Backdrop */
.network-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.network-modal-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
}

/* Network Modal Card */
.network-modal-card {
    background: #18181b;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    width: 100%;
    max-width: 480px;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    transform: translateY(16px) scale(0.98);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
body:not(.dark-mode) .network-modal-card {
    background: #ffffff;
    border-color: rgba(0, 0, 0, 0.1);
}
.network-modal-backdrop.is-open .network-modal-card {
    transform: translateY(0) scale(1);
}

/* Header & Tabs */
.network-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px 0 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
body:not(.dark-mode) .network-modal-header {
    border-bottom-color: rgba(0, 0, 0, 0.08);
}
.network-modal-tabs {
    display: flex;
    gap: 8px;
}
.network-tab-btn {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px 14px 16px;
    font-size: 0.95rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
}
body:not(.dark-mode) .network-tab-btn {
    color: rgba(0, 0, 0, 0.55);
}
.network-tab-btn.is-active {
    color: #ffffff;
    border-bottom-color: var(--accent-color);
}
body:not(.dark-mode) .network-tab-btn.is-active {
    color: #18181b;
}
.network-tab-badge {
    font-size: 0.75rem;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: inherit;
}
body:not(.dark-mode) .network-tab-badge {
    background: rgba(0, 0, 0, 0.08);
}
.network-modal-close {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    font-size: 1.2rem;
    cursor: pointer;
    padding: 6px 10px;
    border-radius: 8px;
    transition: color 0.15s, background 0.15s;
}
.network-modal-close:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
}

/* Search Box */
.network-modal-search {
    padding: 12px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
body:not(.dark-mode) .network-modal-search {
    border-bottom-color: rgba(0, 0, 0, 0.06);
}
.network-search-field {
    width: 100%;
    padding: 10px 14px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-size: 0.88rem;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
}
body:not(.dark-mode) .network-search-field {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.12);
    color: #18181b;
}
.network-search-field:focus {
    border-color: var(--accent-color);
}

/* Modal Body / User List */
.network-modal-body {
    padding: 8px 12px;
    overflow-y: auto;
    max-height: calc(85vh - 140px);
}
.network-user-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.network-user-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 14px;
    transition: background 0.15s ease;
}
.network-user-card:hover {
    background: rgba(255, 255, 255, 0.05);
}
body:not(.dark-mode) .network-user-card:hover {
    background: rgba(0, 0, 0, 0.03);
}
.network-user-avatar-link {
    text-decoration: none;
    flex-shrink: 0;
}
.network-user-avatar-img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
}
.network-user-avatar-initial {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #FF8A00 0%, #F59E0B 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 700;
}
.network-user-info {
    flex: 1;
    min-width: 0;
}
.network-user-name-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}
.network-user-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: #ffffff;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
body:not(.dark-mode) .network-user-name {
    color: #18181b;
}
.network-user-name:hover {
    color: var(--accent-color);
}
.friend-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(74, 222, 128, 0.2) 0%, rgba(34, 197, 94, 0.25) 100%);
    color: #4ade80;
    border: 1px solid rgba(74, 222, 128, 0.4);
    box-shadow: 0 2px 6px rgba(74, 222, 128, 0.15);
}
.network-user-handle {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
    display: block;
}
body:not(.dark-mode) .network-user-handle {
    color: rgba(0, 0, 0, 0.5);
}
.network-user-bio {
    margin: 4px 0 0 0;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
body:not(.dark-mode) .network-user-bio {
    color: rgba(0, 0, 0, 0.65);
}
.btn-network-view {
    padding: 6px 14px;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    text-decoration: none;
    transition: all 0.18s ease;
    white-space: nowrap;
}
body:not(.dark-mode) .btn-network-view {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.12);
    color: #18181b;
}
.btn-network-view:hover {
    background: var(--accent-color);
    border-color: var(--accent-color);
    color: #ffffff;
    transform: translateY(-1px);
}
.network-empty-state {
    padding: 32px 16px;
    text-align: center;
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.9rem;
}
body:not(.dark-mode) .network-empty-state {
    color: rgba(0, 0, 0, 0.45);
}
</style>

<script>
    // Tab Switcher Controller
    document.querySelectorAll('.profile-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const targetTab = btn.getAttribute('data-tab');
            document.querySelectorAll('.profile-tab-btn').forEach(b => {
                b.classList.remove('is-active');
                b.setAttribute('aria-selected', 'false');
            });
            document.querySelectorAll('.profile-tab-panel').forEach(p => p.classList.remove('is-active'));
            
            btn.classList.add('is-active');
            btn.setAttribute('aria-selected', 'true');
            const targetPanel = document.getElementById('panel-' + targetTab);
            if (targetPanel) targetPanel.classList.add('is-active');

            if (history.pushState) {
                history.pushState(null, null, '#' + targetTab);
            }
        });
    });

    // Check URL Hash on Load
    if (window.location.hash) {
        const hashTab = window.location.hash.substring(1);
        const matchingBtn = document.querySelector(`.profile-tab-btn[data-tab="${hashTab}"]`);
        if (matchingBtn) matchingBtn.click();
    }

    // Follow Button Controller
    const followBtn = document.getElementById('follow-author-btn');
    if (followBtn) {
        followBtn.addEventListener('click', async () => {
            const authorId = followBtn.getAttribute('data-user-id');
            try {
                const res = await fetch('/api/profile/follow/' + authorId, { method: 'POST' });
                if (res.ok) {
                    const data = await res.json();
                    const btnText = document.getElementById('follow-btn-text');
                    const countEl = document.getElementById('followers-count');
                    if (data.isFollowing) {
                        followBtn.classList.add('btn-profile-following');
                        btnText.textContent = 'Following';
                        if (countEl) countEl.textContent = parseInt(countEl.textContent || 0) + 1;
                    } else {
                        followBtn.classList.remove('btn-profile-following');
                        btnText.textContent = 'Follow Author';
                        if (countEl) countEl.textContent = Math.max(0, parseInt(countEl.textContent || 0) - 1);
                    }
                } else if (res.status === 401) {
                    window.location.href = '/login';
                }
            } catch (e) {
                console.error('Follow error:', e);
            }
        });
    }

    // =========================================
    // Followers & Following Network Modal
    // =========================================
    const networkModal = document.getElementById('network-modal');
    const btnStatFollowers = document.getElementById('stat-followers-box');
    const btnStatFollowing = document.getElementById('stat-following-box');
    const btnCloseNetworkModal = document.getElementById('close-network-modal');
    const modalTabFollowers = document.getElementById('modal-tab-followers');
    const modalTabFollowing = document.getElementById('modal-tab-following');
    const listFollowers = document.getElementById('network-list-followers');
    const listFollowing = document.getElementById('network-list-following');
    const networkSearchInput = document.getElementById('network-search-input');

    function openNetworkModal(view = 'followers') {
        if (!networkModal) return;
        networkModal.style.display = 'flex';
        // Force reflow for animation
        void networkModal.offsetWidth;
        networkModal.classList.add('is-open');
        networkModal.setAttribute('aria-hidden', 'false');
        switchNetworkView(view);
        if (networkSearchInput) {
            networkSearchInput.value = '';
            filterNetworkList('');
            networkSearchInput.focus();
        }
    }

    function closeNetworkModal() {
        if (!networkModal) return;
        networkModal.classList.remove('is-open');
        networkModal.setAttribute('aria-hidden', 'true');
        setTimeout(() => {
            networkModal.style.display = 'none';
        }, 220);
    }

    function switchNetworkView(view) {
        if (view === 'followers') {
            if (modalTabFollowers) modalTabFollowers.classList.add('is-active');
            if (modalTabFollowing) modalTabFollowing.classList.remove('is-active');
            if (listFollowers) listFollowers.style.display = 'flex';
            if (listFollowing) listFollowing.style.display = 'none';
        } else {
            if (modalTabFollowing) modalTabFollowing.classList.add('is-active');
            if (modalTabFollowers) modalTabFollowers.classList.remove('is-active');
            if (listFollowing) listFollowing.style.display = 'flex';
            if (listFollowers) listFollowers.style.display = 'none';
        }
        if (networkSearchInput) filterNetworkList(networkSearchInput.value);
    }

    function filterNetworkList(query) {
        const cleanQ = (query || '').toLowerCase().trim();
        const activeList = listFollowers?.style.display !== 'none' ? listFollowers : listFollowing;
        if (!activeList) return;
        const cards = activeList.querySelectorAll('.network-user-card');
        cards.forEach(card => {
            const name = card.getAttribute('data-name') || '';
            const username = card.getAttribute('data-username') || '';
            if (!cleanQ || name.includes(cleanQ) || username.includes(cleanQ)) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }

    if (btnStatFollowers) {
        btnStatFollowers.addEventListener('click', () => openNetworkModal('followers'));
        btnStatFollowers.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') openNetworkModal('followers'); });
    }
    if (btnStatFollowing) {
        btnStatFollowing.addEventListener('click', () => openNetworkModal('following'));
        btnStatFollowing.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') openNetworkModal('following'); });
    }
    if (btnCloseNetworkModal) {
        btnCloseNetworkModal.addEventListener('click', closeNetworkModal);
    }
    if (networkModal) {
        networkModal.addEventListener('click', (e) => {
            if (e.target === networkModal) closeNetworkModal();
        });
    }
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && networkModal?.classList.contains('is-open')) {
            closeNetworkModal();
        }
    });
    if (modalTabFollowers) {
        modalTabFollowers.addEventListener('click', () => switchNetworkView('followers'));
    }
    if (modalTabFollowing) {
        modalTabFollowing.addEventListener('click', () => switchNetworkView('following'));
    }
    if (networkSearchInput) {
        networkSearchInput.addEventListener('input', (e) => filterNetworkList(e.target.value));
    }
</script>

<%- include("partials/footer.ejs") %>
