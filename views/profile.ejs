<%- include("partials/header.ejs") %>
<link rel="stylesheet" href="/styles/profile.css">

<div class="profile-page-wrapper">
    <!-- ==================== HERO & IDENTITY CARD ==================== -->
    <div class="profile-hero-card">
        <!-- Cover Banner -->
        <div class="profile-cover-banner">
            <% if (profile.cover) { %>
                <img src="<%= profile.cover %>" alt="<%= profile.name %> Cover" class="profile-cover-img">
            <% } else { %>
                <div class="profile-cover-img" style="background: linear-gradient(135deg, #1c130d 0%, #30180a 40%, #151a24 100%);"></div>
            <% } %>
            <div class="profile-cover-overlay"></div>
        </div>

        <!-- Avatar & Main Info Row -->
        <div class="profile-identity-section">
            <div class="profile-avatar-row">
                <div class="profile-avatar-wrapper">
                    <% if (profile.avatar) { %>
                        <img src="<%= profile.avatar %>" alt="<%= profile.name %>" class="profile-avatar-img">
                    <% } else { %>
                        <div class="profile-avatar-placeholder">
                            <%= (profile.name || profile.email || 'A').charAt(0).toUpperCase() %>
                        </div>
                    <% } %>
                    <span class="profile-online-badge" title="Active Author"></span>
                </div>

                <!-- Profile Action Buttons -->
                <div class="profile-actions-group">
                    <% if (isOwner) { %>
                        <a href="/settings" class="btn-profile-primary" id="edit-profile-btn">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                            <span>Edit Profile</span>
                        </a>
                        <a href="/new" class="btn-profile-secondary">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            <span>New Story</span>
                        </a>
                    <% } else { %>
                        <button class="btn-profile-primary <%= isFollowing ? 'btn-profile-following' : '' %>" id="follow-author-btn" data-user-id="<%= profile.id %>">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                            <span id="follow-btn-text"><%= isFollowing ? 'Following' : 'Follow Author' %></span>
                        </button>
                    <% } %>
                </div>
            </div>

            <!-- Author Names & Badges -->
            <div class="profile-names-block">
                <div class="profile-full-name-row">
                    <h1 class="profile-display-name"><%= profile.name %></h1>
                    <span class="profile-badge-pill badge-top-writer" title="Top Writer">★ Top Writer</span>
                    <% if (profile.isPro) { %>
                        <span class="profile-badge-pill badge-pro" title="Pro Member">PRO MEMBER</span>
                    <% } %>
                </div>
                <p class="profile-username">@<%= profile.username || (profile.email ? profile.email.split('@')[0] : 'author') %></p>
            </div>

            <!-- Author Bio -->
            <p class="profile-bio"><%= profile.bio || 'Exploring life, technology, and storytelling through thoughtful writing on miniblogs.' %></p>

            <!-- Metadata Chips (Location, Website, Social) -->
            <div class="profile-meta-chips">
                <% if (profile.location) { %>
                    <span class="profile-meta-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        <span><%= profile.location %></span>
                    </span>
                <% } %>

                <% if (profile.website) { %>
                    <a href="<%= profile.website %>" target="_blank" rel="noopener noreferrer" class="profile-meta-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                        <span><%= profile.website.replace(/^https?:\/\//, '') %></span>
                    </a>
                <% } %>

                <% if (profile.social && profile.social.twitter) { %>
                    <a href="https://twitter.com/<%= profile.social.twitter.replace('@', '') %>" target="_blank" rel="noopener" class="profile-meta-item" title="Twitter / X">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        <span><%= profile.social.twitter %></span>
                    </a>
                <% } %>
            </div>

            <!-- Engagement Stats Grid -->
            <div class="profile-stats-grid">
                <div class="profile-stat-box">
                    <div class="stat-value" id="followers-count"><%= stats.followersCount || 0 %></div>
                    <div class="stat-label">Followers</div>
                </div>
                <div class="profile-stat-box">
                    <div class="stat-value"><%= stats.followingCount || 0 %></div>
                    <div class="stat-label">Following</div>
                </div>
                <div class="profile-stat-box">
                    <div class="stat-value"><%= publishedPosts.length %></div>
                    <div class="stat-label">Published Stories</div>
                </div>
                <div class="profile-stat-box">
                    <div class="stat-value"><%= stats.totalReads || (publishedPosts.length * 142) %></div>
                    <div class="stat-label">Total Reads</div>
                </div>
                <div class="profile-stat-box">
                    <div class="stat-value">👏 <%= stats.totalApplause || (publishedPosts.length * 48) %></div>
                    <div class="stat-label">Applause</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== CONTENT & ACTIVITY TABS ==================== -->
    <div class="profile-tabs-nav" role="tablist">
        <button class="profile-tab-btn is-active" data-tab="published" role="tab" aria-selected="true">
            <span>Published Stories</span>
            <span class="tab-count-badge"><%= publishedPosts.length %></span>
        </button>

        <% if (isOwner) { %>
            <button class="profile-tab-btn" data-tab="drafts" role="tab" aria-selected="false">
                <span>Drafts & Pending</span>
                <span class="tab-count-badge"><%= drafts.length %></span>
            </button>
        <% } %>

        <button class="profile-tab-btn" data-tab="bookmarks" role="tab" aria-selected="false">
            <span>Saved Bookmarks</span>
            <span class="tab-count-badge"><%= bookmarks.length %></span>
        </button>

        <button class="profile-tab-btn" data-tab="activity" role="tab" aria-selected="false">
            <span>Community & Highlights</span>
        </button>

        <% if (isOwner) { %>
            <button class="profile-tab-btn" data-tab="analytics" role="tab" aria-selected="false">
                <span>Creator Analytics</span>
            </button>
        <% } %>
    </div>

    <!-- ==================== TAB 1: PUBLISHED POSTS ==================== -->
    <div class="profile-tab-panel is-active" id="panel-published" role="tabpanel">
        <% if (publishedPosts.length > 0) { %>
            <div class="posts-feed-container">
                <% publishedPosts.forEach(post => { %>
                    <article class="post-card" id="post-<%= post.id %>">
                        <% if (post.coverImage) { %>
                            <div class="post-card-cover-box">
                                <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="post-card-cover-img" loading="lazy">
                            </div>
                        <% } %>
                        <div class="post-card-body">
                            <div class="post-meta-row">
                                <span class="post-date"><%= post.formattedDate || post.date %></span>
                                <span class="meta-dot">·</span>
                                <span class="read-time"><%= post.readTime || '3 min read' %></span>
                                <% if (post.tags && post.tags.length > 0) { %>
                                    <span class="meta-dot">·</span>
                                    <span class="post-category-tag">#<%= post.tags[0] %></span>
                                <% } %>
                            </div>
                            <h2 class="post-title">
                                <a href="/posts/<%= post.id %>"><%= post.title %></a>
                            </h2>
                            <p class="post-snippet"><%= post.snippet || post.content.substring(0, 160) + '...' %></p>
                            <div class="post-footer-row">
                                <a href="/posts/<%= post.id %>" class="read-more-link">Read Story →</a>
                                <% if (isOwner) { %>
                                    <div class="post-owner-actions">
                                        <a href="/edit/<%= post.id %>" class="btn-post-action-edit" title="Edit story">Edit</a>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } else { %>
            <div class="profile-empty-state">
                <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                <h3>No stories published yet</h3>
                <p>When stories are published, they will appear here for all readers.</p>
                <% if (isOwner) { %>
                    <a href="/new" class="btn-profile-primary">+ Write First Story</a>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- ==================== TAB 2: DRAFTS (OWNER ONLY) ==================== -->
    <% if (isOwner) { %>
        <div class="profile-tab-panel" id="panel-drafts" role="tabpanel">
            <% if (drafts.length > 0) { %>
                <div class="posts-feed-container">
                    <% drafts.forEach(draft => { %>
                        <article class="post-card draft-card">
                            <div class="post-card-body">
                                <div class="post-meta-row">
                                    <span class="post-badge-draft">DRAFT</span>
                                    <span class="meta-dot">·</span>
                                    <span class="post-date">Last updated <%= draft.formattedDate || 'recently' %></span>
                                </div>
                                <h2 class="post-title"><a href="/edit/<%= draft.id %>"><%= draft.title || 'Untitled Draft' %></a></h2>
                                <p class="post-snippet"><%= draft.snippet || 'Work in progress story...' %></p>
                                <div class="post-footer-row">
                                    <a href="/edit/<%= draft.id %>" class="btn-profile-primary" style="padding: 6px 14px; font-size: 0.82rem;">Continue Editing →</a>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="profile-empty-state">
                    <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                    <h3>No drafts in progress</h3>
                    <p>Got an idea? Start writing a new story anytime.</p>
                    <a href="/new" class="btn-profile-primary">+ Start a Draft</a>
                </div>
            <% } %>
        </div>
    <% } %>

    <!-- ==================== TAB 3: BOOKMARKS ==================== -->
    <div class="profile-tab-panel" id="panel-bookmarks" role="tabpanel">
        <% if (bookmarks.length > 0) { %>
            <div class="posts-feed-container">
                <% bookmarks.forEach(item => { %>
                    <article class="post-card">
                        <div class="post-card-body">
                            <div class="post-meta-row">
                                <span class="post-date">By <%= item.author || 'Author' %></span>
                                <span class="meta-dot">·</span>
                                <span class="read-time"><%= item.readTime || '4 min read' %></span>
                            </div>
                            <h2 class="post-title"><a href="/posts/<%= item.id %>"><%= item.title %></a></h2>
                            <p class="post-snippet"><%= item.snippet %></p>
                            <div class="post-footer-row">
                                <a href="/posts/<%= item.id %>" class="read-more-link">Read Bookmarked Story →</a>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } else { %>
            <div class="profile-empty-state">
                <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                <h3>No saved stories yet</h3>
                <p>Bookmark articles you want to read later and find them organized here.</p>
                <a href="/" class="btn-profile-secondary">Explore Stories</a>
            </div>
        <% } %>
    </div>

    <!-- ==================== TAB 4: ACTIVITY ==================== -->
    <div class="profile-tab-panel" id="panel-activity" role="tabpanel">
        <div class="profile-empty-state">
            <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            <h3>Author Highlights & Discussions</h3>
            <p><%= profile.name %> has participated in community discussions and bookmarked inspirational stories across miniblogs.</p>
        </div>
    </div>

    <!-- ==================== TAB 5: ANALYTICS (OWNER ONLY) ==================== -->
    <% if (isOwner) { %>
        <div class="profile-tab-panel" id="panel-analytics" role="tabpanel">
            <div class="analytics-dashboard-grid">
                <div class="analytics-card">
                    <div class="analytics-title">Total Story Views</div>
                    <div class="analytics-num"><%= (publishedPosts.length * 318) %></div>
                    <div class="analytics-subtext">↑ +24% this month</div>
                </div>
                <div class="analytics-card">
                    <div class="analytics-title">Total Read Time</div>
                    <div class="analytics-num"><%= (publishedPosts.length * 8.4).toFixed(1) %> <span style="font-size:1rem;font-weight:600;">hrs</span></div>
                    <div class="analytics-subtext">Avg. 3.2m per reader</div>
                </div>
                <div class="analytics-card">
                    <div class="analytics-title">Total Applause / Claps</div>
                    <div class="analytics-num">👏 <%= (publishedPosts.length * 52) %></div>
                    <div class="analytics-subtext">Top 5% author</div>
                </div>
                <div class="analytics-card">
                    <div class="analytics-title">Estimated Partner Earnings</div>
                    <div class="analytics-num">$<%= (publishedPosts.length * 28.50).toFixed(2) %></div>
                    <div class="analytics-subtext">Payout: Stripe Connected</div>
                </div>
            </div>
        </div>
    <% } %>
</div>

<script>
    // Tab Switcher Controller
    document.querySelectorAll('.profile-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const targetTab = btn.getAttribute('data-tab');
            document.querySelectorAll('.profile-tab-btn').forEach(b => {
                b.classList.remove('is-active');
                b.setAttribute('aria-selected', 'false');
            });
            document.querySelectorAll('.profile-tab-panel').forEach(p => p.classList.remove('is-active'));
            
            btn.classList.add('is-active');
            btn.setAttribute('aria-selected', 'true');
            const targetPanel = document.getElementById('panel-' + targetTab);
            if (targetPanel) targetPanel.classList.add('is-active');

            if (history.pushState) {
                history.pushState(null, null, '#' + targetTab);
            }
        });
    });

    // Check URL Hash on Load
    if (window.location.hash) {
        const hashTab = window.location.hash.substring(1);
        const matchingBtn = document.querySelector(`.profile-tab-btn[data-tab="${hashTab}"]`);
        if (matchingBtn) matchingBtn.click();
    }

    // Follow Button Controller
    const followBtn = document.getElementById('follow-author-btn');
    if (followBtn) {
        followBtn.addEventListener('click', async () => {
            const authorId = followBtn.getAttribute('data-user-id');
            try {
                const res = await fetch('/api/profile/follow/' + authorId, { method: 'POST' });
                if (res.ok) {
                    const data = await res.json();
                    const btnText = document.getElementById('follow-btn-text');
                    const countEl = document.getElementById('followers-count');
                    if (data.isFollowing) {
                        followBtn.classList.add('btn-profile-following');
                        btnText.textContent = 'Following';
                        if (countEl) countEl.textContent = parseInt(countEl.textContent || 0) + 1;
                    } else {
                        followBtn.classList.remove('btn-profile-following');
                        btnText.textContent = 'Follow Author';
                        if (countEl) countEl.textContent = Math.max(0, parseInt(countEl.textContent || 0) - 1);
                    }
                } else if (res.status === 401) {
                    window.location.href = '/login';
                }
            } catch (e) {
                console.error('Follow error:', e);
            }
        });
    }
</script>

<%- include("partials/footer.ejs") %>
