<%- include("partials/header.ejs") %>
<link rel="stylesheet" href="/styles/profile.css">

<div class="settings-container">
    <div class="settings-header-banner">
        <h1 class="settings-header-title">Account & Profile Settings</h1>
        <p class="settings-header-desc">Manage your public persona, security credentials, notifications, monetization, and data privacy.</p>
    </div>

    <div class="settings-layout">
        <!-- ==================== SIDEBAR NAVIGATION ==================== -->
        <aside class="settings-sidebar" role="tablist" aria-label="Settings Categories">
            <button class="settings-nav-item is-active" data-tab="general" role="tab" aria-selected="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                <span>Profile & Identity</span>
            </button>
            <button class="settings-nav-item" data-tab="security" role="tab" aria-selected="false">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <span>Security & Sessions</span>
            </button>
            <button class="settings-nav-item" data-tab="notifications" role="tab" aria-selected="false">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                <span>Notifications</span>
            </button>
            <button class="settings-nav-item" data-tab="monetization" role="tab" aria-selected="false">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                <span>Monetization & Payouts</span>
            </button>
            <button class="settings-nav-item" data-tab="privacy" role="tab" aria-selected="false">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span>Data & Privacy</span>
            </button>
        </aside>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <main class="settings-content-card">
            <!-- ========== TAB 1: PROFILE & IDENTITY ========== -->
            <div class="settings-tab-panel is-active" id="settings-panel-general">
                <h2 class="settings-section-title">Personal Information & Persona</h2>
                <p class="settings-section-desc">Update your public identity, bio, social presence, and visual assets.</p>

                <form id="profile-general-form">
                    <div class="settings-form-grid">
                        <div>
                            <label class="settings-label" for="setting-name">Display Name</label>
                            <input type="text" id="setting-name" name="name" class="settings-input" value="<%= profile.name %>" required>
                        </div>

                        <div>
                            <label class="settings-label" for="setting-username">Unique @username</label>
                            <input type="text" id="setting-username" name="username" class="settings-input" value="<%= profile.username || (profile.email ? profile.email.split('@')[0] : '') %>" required>
                        </div>

                        <div class="form-full-width">
                            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                                <label class="settings-label" for="setting-email" style="margin-bottom:0;">Email Address</label>
                                <span class="email-verified-chip">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                    <span>Verified Account Email</span>
                                </span>
                            </div>
                            <input type="email" id="setting-email" name="email" class="settings-input" value="<%= profile.email %>" readonly title="Primary account email">
                        </div>

                        <div class="form-full-width">
                            <label class="settings-label" for="setting-bio">Short Bio (150–250 characters max)</label>
                            <textarea id="setting-bio" name="bio" class="settings-textarea" rows="3" maxlength="250" placeholder="Tell readers about yourself, your passions, and what you write about..."><%= profile.bio || '' %></textarea>
                            <span style="font-size:0.78rem;color:rgba(255,255,255,0.45);display:block;margin-top:4px;" id="bio-char-count">250 characters remaining</span>
                        </div>

                        <!-- Profile Picture Media Picker -->
                        <div class="form-full-width">
                            <label class="settings-label">Profile Picture / Avatar</label>
                            <div class="media-picker-card">
                                <div class="media-avatar-container">
                                    <div class="media-avatar-preview" id="media-avatar-preview">
                                        <% if (profile.avatar) { %>
                                            <img src="<%= profile.avatar %>" alt="<%= profile.name %>" id="avatar-img-element" class="media-preview-img-round">
                                        <% } else { %>
                                            <div class="media-avatar-initial" id="avatar-initial-element"><%= (profile.name || 'U').charAt(0).toUpperCase() %></div>
                                        <% } %>
                                    </div>
                                    <button type="button" class="btn-avatar-camera-badge" id="btn-trigger-avatar-picker" title="Change Photo" aria-label="Change Photo">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                                    </button>
                                </div>
                                <div class="media-picker-info">
                                    <div class="media-picker-actions">
                                        <input type="file" id="avatar-file-input" accept="image/png, image/jpeg, image/webp, image/gif" style="display: none;">
                                        <input type="hidden" id="setting-avatar" name="avatar" value="<%= profile.avatar || '' %>">
                                        <button type="button" class="btn-profile-primary" id="btn-upload-avatar">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                                            <span>Upload from Device</span>
                                        </button>
                                        <button type="button" class="btn-profile-secondary" id="btn-remove-avatar" style="<%= profile.avatar ? '' : 'display: none;' %>">
                                            <span>Remove</span>
                                        </button>
                                    </div>
                                    <p class="media-picker-hint">Choose a photo from your computer or phone. JPG, PNG, GIF or WebP (max 5MB).</p>
                                </div>
                            </div>
                        </div>

                        <!-- Cover Banner Media Picker -->
                        <div class="form-full-width">
                            <label class="settings-label">Cover Banner Image</label>
                            <div class="media-cover-card" id="media-cover-dropzone">
                                <div class="media-cover-preview-wrapper">
                                    <% if (profile.cover) { %>
                                        <img src="<%= profile.cover %>" alt="Cover Banner" id="cover-img-element" class="media-cover-img">
                                    <% } else { %>
                                        <div class="media-cover-placeholder" id="cover-placeholder-element"></div>
                                    <% } %>
                                    <div class="media-cover-overlay">
                                        <input type="file" id="cover-file-input" accept="image/png, image/jpeg, image/webp, image/gif" style="display: none;">
                                        <input type="hidden" id="setting-cover" name="cover" value="<%= profile.cover || '' %>">
                                        <button type="button" class="btn-profile-primary" id="btn-upload-cover">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                                            <span>Upload Banner from Device</span>
                                        </button>
                                        <button type="button" class="btn-profile-secondary" id="btn-remove-cover" style="<%= profile.cover ? '' : 'display: none;' %>">
                                            <span>Reset to Default</span>
                                        </button>
                                    </div>
                                </div>
                                <p class="media-picker-hint" style="margin-top: 10px;">Recommended dimensions 1500 × 500 px. Supports PNG, JPG, WebP.</p>
                            </div>
                        </div>

                        <div class="form-full-width">
                            <label class="settings-label" for="setting-website">Personal Website / Portfolio</label>
                            <input type="url" id="setting-website" name="website" class="settings-input" placeholder="https://yourportfolio.dev" value="<%= profile.website || '' %>">
                        </div>

                        <div>
                            <label class="settings-label" for="setting-location">Location</label>
                            <input type="text" id="setting-location" name="location" class="settings-input" placeholder="e.g. San Francisco, CA" value="<%= profile.location || '' %>">
                        </div>

                        <div>
                            <label class="settings-label" for="setting-phone">Phone Number</label>
                            <input type="tel" id="setting-phone" name="phone" class="settings-input" placeholder="+1 (555) 000-0000" value="<%= profile.phone || '' %>">
                        </div>

                        <div class="form-full-width">
                            <label class="settings-label" for="setting-twitter">Twitter / X Handle</label>
                            <input type="text" id="setting-twitter" name="twitter" class="settings-input" placeholder="@username" value="<%= (profile.social && profile.social.twitter) || '' %>">
                        </div>
                    </div>

                    <div style="margin-top: 32px; display: flex; justify-content: flex-end; gap: 12px;">
                        <button type="submit" class="btn-profile-primary" id="save-profile-btn">Save Changes</button>
                    </div>
                </form>
            </div>

            <!-- ========== TAB 2: SECURITY & SESSIONS ========== -->
            <div class="settings-tab-panel" id="settings-panel-security" style="display:none;">
                <h2 class="settings-section-title">Security & Credentials</h2>
                <p class="settings-section-desc">Manage account credentials, authentication methods, and active sessions.</p>

                <% if (typeof isGoogleUser !== 'undefined' && isGoogleUser) { %>
                    <!-- Google OAuth Account Status Card -->
                    <div class="google-security-card">
                        <div class="google-security-header">
                            <div class="google-icon-box">
                                <svg width="22" height="22" viewBox="0 0 24 24">
                                    <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
                                    <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                                    <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                                    <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                                </svg>
                            </div>
                            <div class="google-security-text">
                                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                                    <h3 style="margin:0;font-size:1.15rem;font-weight:700;">Signed in through Google</h3>
                                    <span class="email-verified-chip">✓ Google OAuth Active</span>
                                </div>
                                <p style="margin:6px 0 0 0;font-size:0.88rem;color:rgba(255,255,255,0.6);line-height:1.5;">
                                    Your account is authenticated directly via Google (<strong style="color:var(--text-color);"><%= profile.email %></strong>). Password management and multi-factor authentication are handled securely through your Google Account.
                                </p>
                            </div>
                        </div>
                        <div style="margin-top:18px;display:flex;align-items:center;gap:12px;">
                            <a href="https://myaccount.google.com/security" target="_blank" rel="noopener noreferrer" class="btn-profile-secondary" style="font-size:0.84rem;padding:7px 18px;">
                                <span>Manage Google Account Security ↗</span>
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <!-- Standard Password Change Form for Email/Password Users -->
                    <form id="password-change-form">
                        <div class="settings-form-grid">
                            <div class="form-full-width">
                                <label class="settings-label" for="current-password">Current Password <span style="color: #ef4444;">*</span></label>
                                <input type="password" id="current-password" name="currentPassword" class="settings-input" placeholder="Enter existing password" required autocomplete="current-password">
                            </div>
                            <div>
                                <label class="settings-label" for="new-password">New Password <span style="color: #ef4444;">*</span></label>
                                <input type="password" id="new-password" name="newPassword" class="settings-input" placeholder="Min. 8 characters" minlength="8" required autocomplete="new-password">
                            </div>
                            <div>
                                <label class="settings-label" for="confirm-password">Confirm New Password <span style="color: #ef4444;">*</span></label>
                                <input type="password" id="confirm-password" name="confirmPassword" class="settings-input" placeholder="Repeat new password" minlength="8" required autocomplete="new-password">
                            </div>
                        </div>
                        <div style="margin-top: 24px; display: flex; align-items: center; gap: 12px;">
                            <button type="submit" class="btn-profile-primary" id="btn-update-password">Update Password</button>
                        </div>
                    </form>
                <% } %>

                <div class="settings-toggle-row">
                    <div class="toggle-info">
                        <h4>Active Login Sessions</h4>
                        <p>Currently logged in on <strong style="color:var(--text-color);"><%= typeof currentSessionInfo !== 'undefined' ? currentSessionInfo.device : 'This Device' %></strong> (Current Device) · IP <%= typeof currentSessionInfo !== 'undefined' ? currentSessionInfo.ip : '127.0.0.1' %></p>
                    </div>
                    <button type="button" class="btn-profile-secondary" id="btn-revoke-other-sessions" style="font-size:0.84rem;padding:8px 20px;">Log Out Other Devices</button>
                </div>
            </div>

            <!-- ========== TAB 3: NOTIFICATIONS ========== -->
            <div class="settings-tab-panel" id="settings-panel-notifications" style="display:none;">
                <h2 class="settings-section-title">Notification Preferences</h2>
                <p class="settings-section-desc">Choose what updates and digests you receive in your inbox and browser. Toggles save automatically.</p>

                <div class="settings-toggle-row">
                    <div class="toggle-info">
                        <h4>Story Comments & Responses</h4>
                        <p>Receive email notifications when someone leaves a comment on your stories.</p>
                    </div>
                    <label class="theme-switch">
                        <input type="checkbox" <%= (profile.notifications && profile.notifications.comments !== false) ? 'checked' : '' %> id="notif-comments">
                        <span class="slider round"></span>
                    </label>
                </div>

                <div class="settings-toggle-row">
                    <div class="toggle-info">
                        <h4>New Followers & Claps</h4>
                        <p>Get notified when a fellow reader follows your profile or applauds your article.</p>
                    </div>
                    <label class="theme-switch">
                        <input type="checkbox" <%= (profile.notifications && profile.notifications.followers !== false) ? 'checked' : '' %> id="notif-followers">
                        <span class="slider round"></span>
                    </label>
                </div>

                <div class="settings-toggle-row">
                    <div class="toggle-info">
                        <h4>Weekly Digest & Highlights</h4>
                        <p>A weekly roundup of trending stories tailored to your interests.</p>
                    </div>
                    <label class="theme-switch">
                        <input type="checkbox" <%= (profile.notifications && profile.notifications.digest !== false) ? 'checked' : '' %> id="notif-digest">
                        <span class="slider round"></span>
                    </label>
                </div>

                <div class="settings-toggle-row">
                    <div class="toggle-info">
                        <h4>Web & Mobile Push Alerts</h4>
                        <p>Instant browser push notifications for breaking story updates.</p>
                    </div>
                    <label class="theme-switch">
                        <input type="checkbox" <%= (profile.notifications && profile.notifications.push === true) ? 'checked' : '' %> id="notif-push">
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>

            <!-- ========== TAB 4: MONETIZATION & PAYOUTS ========== -->
            <div class="settings-tab-panel" id="settings-panel-monetization" style="display:none;">
                <h2 class="settings-section-title">Creator Monetization & Subscriptions</h2>
                <p class="settings-section-desc">Earn revenue based on reading time and member applause from your published stories.</p>

                <div class="analytics-dashboard-grid" style="margin-top:20px;">
                    <div class="analytics-card">
                        <div class="analytics-title">Creator Membership Status</div>
                        <div class="analytics-num" style="font-size:1.5rem;color:#4ade80;">Active Pro</div>
                        <div class="analytics-subtext">Tier: Partner Program</div>
                    </div>
                    <div class="analytics-card">
                        <div class="analytics-title">Current Balance</div>
                        <div class="analytics-num">$<%= (typeof stats !== 'undefined' && stats.estimatedEarnings) ? stats.estimatedEarnings : '0.00' %></div>
                        <div class="analytics-subtext"><%= (typeof stats !== 'undefined' && stats.totalReads > 0) ? (stats.totalReads + ' total reads recorded') : 'No earnings accumulated yet' %></div>
                    </div>
                </div>

                <div class="settings-toggle-row">
                    <div class="toggle-info">
                        <h4>Connected Payout Account</h4>
                        <p>Stripe Express (•••• 4242 · USD Direct Deposit)</p>
                    </div>
                    <button type="button" class="btn-profile-secondary" onclick="alert('Stripe Express dashboard management opened.')">Manage Payouts</button>
                </div>
            </div>

            <!-- ========== TAB 5: DATA & PRIVACY ========== -->
            <div class="settings-tab-panel" id="settings-panel-privacy" style="display:none;">
                <h2 class="settings-section-title">Data Privacy & Account Controls</h2>
                <p class="settings-section-desc">Manage public visibility, export your story archives, or permanently delete your account.</p>

                <div class="settings-toggle-row">
                    <div class="toggle-info">
                        <h4>Profile Visibility</h4>
                        <p>Allow search engines and non-members to view your public profile and published stories.</p>
                    </div>
                    <label class="theme-switch">
                        <input type="checkbox" <%= (profile.privacy && profile.privacy.isPublic !== false) ? 'checked' : '' %> id="privacy-visibility">
                        <span class="slider round"></span>
                    </label>
                </div>

                <div class="settings-toggle-row">
                    <div class="toggle-info">
                        <h4>Export My Data</h4>
                        <p>Download a complete JSON archive of your published posts, bookmarks, and account metadata.</p>
                    </div>
                    <a href="/api/profile/export" class="btn-profile-secondary" download>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        <span>Export Data (JSON)</span>
                    </a>
                </div>

                <!-- Danger Zone -->
                <div class="settings-danger-card">
                    <h3 style="color:#ef4444;margin:0 0 6px 0;font-size:1.1rem;">Danger Zone</h3>
                    <p style="font-size:0.86rem;color:rgba(255,255,255,0.6);margin:0 0 16px 0;">Once deleted, your account, published stories, bookmarks, and analytics cannot be recovered.</p>
                    <button type="button" class="btn-danger" id="delete-account-btn">Delete Account Permanently</button>
                </div>
            </div>
        </main>
    </div>
</div>



<script>
    // Settings Tabs Switcher
    document.querySelectorAll('.settings-nav-item').forEach(btn => {
        btn.addEventListener('click', () => {
            const target = btn.getAttribute('data-tab');
            document.querySelectorAll('.settings-nav-item').forEach(b => {
                b.classList.remove('is-active');
                b.setAttribute('aria-selected', 'false');
            });
            document.querySelectorAll('.settings-tab-panel').forEach(p => p.style.display = 'none');

            btn.classList.add('is-active');
            btn.setAttribute('aria-selected', 'true');
            const targetPanel = document.getElementById('settings-panel-' + target);
            if (targetPanel) targetPanel.style.display = 'block';
        });
    });

    // Bio Character Counter
    const bioTextarea = document.getElementById('setting-bio');
    const bioCount = document.getElementById('bio-char-count');
    if (bioTextarea && bioCount) {
        bioTextarea.addEventListener('input', () => {
            const remaining = 250 - bioTextarea.value.length;
            bioCount.textContent = `${remaining} characters remaining`;
        });
    }

    // =========================================
    // Device Media Picker: Avatar & Cover Banner
    // =========================================
    const avatarFileInput = document.getElementById('avatar-file-input');
    const avatarHiddenInput = document.getElementById('setting-avatar');
    const avatarPreviewContainer = document.getElementById('media-avatar-preview');
    const btnUploadAvatar = document.getElementById('btn-upload-avatar');
    const btnTriggerAvatarPicker = document.getElementById('btn-trigger-avatar-picker');
    const btnRemoveAvatar = document.getElementById('btn-remove-avatar');

    const coverFileInput = document.getElementById('cover-file-input');
    const coverHiddenInput = document.getElementById('setting-cover');
    const coverDropzone = document.getElementById('media-cover-dropzone');
    const btnUploadCover = document.getElementById('btn-upload-cover');
    const btnRemoveCover = document.getElementById('btn-remove-cover');

    function handleAvatarFile(file) {
        if (!file || !file.type.startsWith('image/')) {
            alert('Please select a valid image file (JPG, PNG, GIF, or WebP).');
            return;
        }
        if (file.size > 5 * 1024 * 1024) {
            alert('Image size exceeds 5MB. Please choose a smaller photo.');
            return;
        }
        const reader = new FileReader();
        reader.onload = (e) => {
            const dataUrl = e.target.result;
            avatarHiddenInput.value = dataUrl;
            avatarPreviewContainer.innerHTML = `<img src="${dataUrl}" alt="Avatar Preview" class="media-preview-img-round">`;
            if (btnRemoveAvatar) btnRemoveAvatar.style.display = 'inline-flex';
        };
        reader.readAsDataURL(file);
    }

    if (btnUploadAvatar && avatarFileInput) {
        btnUploadAvatar.addEventListener('click', () => avatarFileInput.click());
    }
    if (btnTriggerAvatarPicker && avatarFileInput) {
        btnTriggerAvatarPicker.addEventListener('click', () => avatarFileInput.click());
    }
    if (avatarFileInput) {
        avatarFileInput.addEventListener('change', (e) => {
            if (e.target.files && e.target.files[0]) {
                handleAvatarFile(e.target.files[0]);
            }
        });
    }
    if (btnRemoveAvatar) {
        btnRemoveAvatar.addEventListener('click', () => {
            avatarHiddenInput.value = '';
            const initial = (document.getElementById('setting-name')?.value || 'U').charAt(0).toUpperCase();
            avatarPreviewContainer.innerHTML = `<div class="media-avatar-initial">${initial}</div>`;
            btnRemoveAvatar.style.display = 'none';
        });
    }

    function handleCoverFile(file) {
        if (!file || !file.type.startsWith('image/')) {
            alert('Please select a valid image file (JPG, PNG, or WebP).');
            return;
        }
        if (file.size > 8 * 1024 * 1024) {
            alert('Cover image size exceeds 8MB. Please choose a smaller image.');
            return;
        }
        const reader = new FileReader();
        reader.onload = (e) => {
            const dataUrl = e.target.result;
            coverHiddenInput.value = dataUrl;
            const previewWrapper = coverDropzone.querySelector('.media-cover-preview-wrapper');
            let img = document.getElementById('cover-img-element');
            const placeholder = document.getElementById('cover-placeholder-element');
            if (placeholder) placeholder.style.display = 'none';
            if (img) {
                img.src = dataUrl;
                img.style.display = 'block';
            } else if (previewWrapper) {
                img = document.createElement('img');
                img.id = 'cover-img-element';
                img.src = dataUrl;
                img.className = 'media-cover-img';
                previewWrapper.prepend(img);
            }
            if (btnRemoveCover) btnRemoveCover.style.display = 'inline-flex';
        };
        reader.readAsDataURL(file);
    }

    if (btnUploadCover && coverFileInput) {
        btnUploadCover.addEventListener('click', () => coverFileInput.click());
    }
    if (coverFileInput) {
        coverFileInput.addEventListener('change', (e) => {
            if (e.target.files && e.target.files[0]) {
                handleCoverFile(e.target.files[0]);
            }
        });
    }
    if (btnRemoveCover) {
        btnRemoveCover.addEventListener('click', () => {
            coverHiddenInput.value = '';
            const img = document.getElementById('cover-img-element');
            if (img) img.style.display = 'none';
            const placeholder = document.getElementById('cover-placeholder-element');
            if (placeholder) placeholder.style.display = 'block';
            btnRemoveCover.style.display = 'none';
        });
    }

    // Drag and Drop for Cover Banner
    if (coverDropzone) {
        ['dragenter', 'dragover'].forEach(eventName => {
            coverDropzone.addEventListener(eventName, (e) => {
                e.preventDefault();
                coverDropzone.classList.add('is-dragover');
            }, false);
        });
        ['dragleave', 'drop'].forEach(eventName => {
            coverDropzone.addEventListener(eventName, (e) => {
                e.preventDefault();
                coverDropzone.classList.remove('is-dragover');
            }, false);
        });
        coverDropzone.addEventListener('drop', (e) => {
            if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                handleCoverFile(e.dataTransfer.files[0]);
            }
        }, false);
    }

    // Toast Notification Utility for Settings Feedback
    function showSettingsToast(msg, isError = false) {
        let toast = document.getElementById('settings-live-toast');
        if (!toast) {
            toast = document.createElement('div');
            toast.id = 'settings-live-toast';
            toast.style.cssText = 'position:fixed;bottom:28px;right:28px;z-index:99999;padding:12px 22px;border-radius:999px;font-size:0.9rem;font-weight:600;display:flex;align-items:center;gap:10px;box-shadow:0 12px 32px rgba(0,0,0,0.4);backdrop-filter:blur(16px);transition:all 0.3s cubic-bezier(0.16,1,0.3,1);opacity:0;transform:translateY(16px);pointer-events:none;';
            document.body.appendChild(toast);
        }
        toast.style.background = isError ? 'rgba(239, 68, 68, 0.92)' : 'rgba(16, 185, 129, 0.92)';
        toast.style.color = '#ffffff';
        toast.style.border = isError ? '1px solid rgba(255,255,255,0.2)' : '1px solid rgba(255,255,255,0.25)';
        toast.innerHTML = (isError ? '✕ ' : '✓ ') + msg;
        toast.style.opacity = '1';
        toast.style.transform = 'translateY(0)';
        clearTimeout(window.__settingsToastTimer);
        window.__settingsToastTimer = setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(16px)';
        }, 3200);
    }

    // Auto-Save Preference Toggles Handler
    async function autoSavePreferences() {
        const notifComments = document.getElementById('notif-comments')?.checked ?? true;
        const notifFollowers = document.getElementById('notif-followers')?.checked ?? true;
        const notifDigest = document.getElementById('notif-digest')?.checked ?? true;
        const notifPush = document.getElementById('notif-push')?.checked ?? false;
        const privacyVisibility = document.getElementById('privacy-visibility')?.checked ?? true;

        try {
            const res = await fetch('/api/profile', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    notifications: {
                        comments: notifComments,
                        followers: notifFollowers,
                        digest: notifDigest,
                        push: notifPush
                    },
                    privacy: {
                        isPublic: privacyVisibility
                    }
                })
            });
            if (res.ok) {
                showSettingsToast('Preference saved automatically');
            } else {
                showSettingsToast('Could not save preference', true);
            }
        } catch (e) {
            showSettingsToast('Network error saving preference', true);
        }
    }

    ['notif-comments', 'notif-followers', 'notif-digest', 'notif-push', 'privacy-visibility'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('change', autoSavePreferences);
    });

    // Save Profile Form
    if (profileForm) {
        profileForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const submitBtn = document.getElementById('save-profile-btn');
            submitBtn.textContent = 'Saving...';
            submitBtn.disabled = true;

            const formData = {
                name: document.getElementById('setting-name').value,
                username: document.getElementById('setting-username').value,
                phone: document.getElementById('setting-phone').value,
                bio: document.getElementById('setting-bio').value,
                avatar: document.getElementById('setting-avatar').value,
                cover: document.getElementById('setting-cover').value,
                location: document.getElementById('setting-location').value,
                website: document.getElementById('setting-website').value,
                twitter: document.getElementById('setting-twitter').value,
                notifications: {
                    comments: document.getElementById('notif-comments')?.checked ?? true,
                    followers: document.getElementById('notif-followers')?.checked ?? true,
                    digest: document.getElementById('notif-digest')?.checked ?? true,
                    push: document.getElementById('notif-push')?.checked ?? false
                },
                privacy: {
                    isPublic: document.getElementById('privacy-visibility')?.checked ?? true
                }
            };

            try {
                const res = await fetch('/api/profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                if (res.ok) {
                    showSettingsToast('All profile changes saved successfully!');
                    setTimeout(() => {
                        window.location.href = '/profile';
                    }, 800);
                } else {
                    const data = await res.json();
                    showSettingsToast(data.error || 'Failed to update profile', true);
                }
            } catch (err) {
                showSettingsToast('Network error updating profile', true);
            } finally {
                submitBtn.textContent = 'Save Changes';
                submitBtn.disabled = false;
            }
        });
    }

    // Password Change Form
    const passwordForm = document.getElementById('password-change-form');
    if (passwordForm) {
        passwordForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const currentPassword = document.getElementById('current-password').value;
            const newPassword = document.getElementById('new-password').value;
            const confirmPassword = document.getElementById('confirm-password').value;
            const updateBtn = document.getElementById('btn-update-password');

            if (!currentPassword) {
                alert('Please enter your current password.');
                document.getElementById('current-password').focus();
                return;
            }

            if (newPassword.length < 8) {
                alert('New password must be at least 8 characters long.');
                document.getElementById('new-password').focus();
                return;
            }

            if (newPassword !== confirmPassword) {
                alert('New password and confirmation password do not match.');
                document.getElementById('confirm-password').focus();
                return;
            }

            updateBtn.textContent = 'Verifying & Updating...';
            updateBtn.disabled = true;

            try {
                const res = await fetch('/api/profile/password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
                });

                const data = await res.json();
                if (res.ok && data.success) {
                    alert('Password updated successfully!');
                    passwordForm.reset();
                } else {
                    alert(data.error || 'Failed to update password. Current password may be incorrect.');
                }
            } catch (err) {
                alert('Network error changing password. Please try again.');
            } finally {
                updateBtn.textContent = 'Update Password';
                updateBtn.disabled = false;
            }
        });
    }



    // Real Revoke Other Sessions Handler
    const btnRevokeSessions = document.getElementById('btn-revoke-other-sessions');
    if (btnRevokeSessions) {
        btnRevokeSessions.addEventListener('click', async () => {
            if (confirm('Are you sure you want to log out all other devices and browser sessions? Your current session will remain active.')) {
                btnRevokeSessions.textContent = 'Revoking...';
                btnRevokeSessions.disabled = true;

                try {
                    const res = await fetch('/api/profile/sessions/revoke-others', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await res.json();

                    if (res.ok && data.success) {
                        alert(data.message || 'All other device sessions have been logged out successfully.');
                    } else {
                        alert(data.error || 'Failed to revoke sessions.');
                    }
                } catch (err) {
                    alert('Network error revoking other device sessions.');
                } finally {
                    btnRevokeSessions.textContent = 'Log Out Other Devices';
                    btnRevokeSessions.disabled = false;
                }
            }
        });
    }

    // Delete Account
    const deleteBtn = document.getElementById('delete-account-btn');
    if (deleteBtn) {
        deleteBtn.addEventListener('click', async () => {
            if (confirm('Are you sure you want to permanently delete your account? This action is irreversible.')) {
                try {
                    const res = await fetch('/api/profile/account', { method: 'DELETE' });
                    if (res.ok) {
                        alert('Your account has been deleted.');
                        window.location.href = '/login';
                    }
                } catch (e) {
                    alert('Error deleting account.');
                }
            }
        });
    }
</script>

