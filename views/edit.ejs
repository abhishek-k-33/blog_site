<%- include("partials/header.ejs") %>

<div class="form-container story-editor-container">
    <div class="editor-header">
        <h2>Edit Story</h2>
        <p class="editor-subtitle">Refine your story, memories, and thoughts.</p>
    </div>

    <form action="/update/<%= post.id %>" method="POST" class="post-form" id="story-form">
        <div class="form-group">
            <label for="title">Story Title</label>
            <input type="text" id="title" name="title" value="<%= post.title %>" required autocomplete="off">
        </div>

        <div class="form-group">
            <label for="author">Author</label>
            <input type="text" id="author" name="author" value="<%= post.author %>" required autocomplete="off">
        </div>

        <div class="form-group editor-group">
            <div class="editor-tabs-bar">
                <label for="content">Story Content (Markdown supported)</label>
                <div class="editor-tab-switches">
                    <button type="button" class="tab-btn active" id="tab-write-btn">Write</button>
                    <button type="button" class="tab-btn" id="tab-preview-btn">Preview</button>
                </div>
            </div>

            <!-- Dedicated Storyteller's Formatting Toolbar (Icon-Only) -->
            <div class="markdown-toolbar" id="markdown-toolbar">
                <div class="toolbar-group">
                    <button type="button" class="toolbar-btn" data-prefix="**" data-suffix="**" title="Bold">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path></svg>
                    </button>
                    <button type="button" class="toolbar-btn" data-prefix="*" data-suffix="*" title="Italic">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="4" x2="10" y2="4"></line><line x1="14" y1="20" x2="5" y2="20"></line><line x1="15" y1="4" x2="9" y2="20"></line></svg>
                    </button>
                    <button type="button" class="toolbar-btn" data-prefix="### " data-suffix="" title="Heading (H3)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v16"></path><path d="M18 4v16"></path><path d="M6 12h12"></path></svg>
                    </button>
                    <button type="button" class="toolbar-btn" data-prefix="> " data-suffix="" title="Quote / Reflection">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v6c0 1.1.9 2 2 2h4c0 3.5-1 5.5-5 6v2z"></path><path d="M15 21c3 0 7-1 7-8V5c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v6c0 1.1.9 2 2 2h4c0 3.5-1 5.5-5 6v2z"></path></svg>
                    </button>
                </div>

                <div class="toolbar-group">
                    <button type="button" class="toolbar-btn" data-prefix="- " data-suffix="" title="Bullet List">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="9" y1="6" x2="20" y2="6"></line><line x1="9" y1="12" x2="20" y2="12"></line><line x1="9" y1="18" x2="20" y2="18"></line><circle cx="4" cy="6" r="1.5" fill="currentColor"></circle><circle cx="4" cy="12" r="1.5" fill="currentColor"></circle><circle cx="4" cy="18" r="1.5" fill="currentColor"></circle></svg>
                    </button>
                    <button type="button" class="toolbar-btn" data-prefix="![Memory Photo](" data-suffix="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=800)" title="Insert Photo">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    </button>
                    <button type="button" class="toolbar-btn" data-prefix="[" data-suffix="](https://)" title="Insert Link">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                    </button>
                    <button type="button" class="toolbar-btn" data-prefix="```\n" data-suffix="\n```" title="Code Block">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                    </button>
                    <button type="button" class="toolbar-btn" data-prefix="\n---\n" data-suffix="" title="Divider Line">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line></svg>
                    </button>
                </div>
            </div>

            <textarea id="content" name="content" rows="12" required><%= post.content %></textarea>

            <!-- Live Story Preview Pane -->
            <div id="story-preview" class="story-preview-pane" style="display: none;">
                <div class="preview-placeholder">Your story preview will appear here.</div>
            </div>
        </div>

        <div class="form-actions">
            <a href="/posts/<%= post.id %>" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Update Story</button>
        </div>
    </form>
</div>

<script>
    // Story Editor Tab Switcher & Live Preview
    const tabWrite = document.getElementById('tab-write-btn');
    const tabPreview = document.getElementById('tab-preview-btn');
    const textarea = document.getElementById('content');
    const previewPane = document.getElementById('story-preview');
    const toolbar = document.getElementById('markdown-toolbar');

    tabWrite.addEventListener('click', () => {
        tabWrite.classList.add('active');
        tabPreview.classList.remove('active');
        textarea.style.display = 'block';
        toolbar.style.display = 'flex';
        previewPane.style.display = 'none';
    });

    tabPreview.addEventListener('click', () => {
        tabPreview.classList.add('active');
        tabWrite.classList.remove('active');
        textarea.style.display = 'none';
        toolbar.style.display = 'none';
        previewPane.style.display = 'block';

        const rawText = textarea.value.trim();
        if (rawText && typeof marked !== 'undefined') {
            previewPane.innerHTML = marked.parse(rawText);
            if (typeof hljs !== 'undefined') {
                previewPane.querySelectorAll('pre code').forEach((block) => {
                    hljs.highlightElement(block);
                });
            }
        } else {
            previewPane.innerHTML = '<p class="preview-empty">Your story preview will appear here...</p>';
        }
    });

    // Toolbar formatting helper
    document.querySelectorAll('.toolbar-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
            const prefix = btn.getAttribute('data-prefix');
            const suffix = btn.getAttribute('data-suffix');
            const insertText = btn.getAttribute('data-text');

            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            const text = textarea.value;

            if (insertText) {
                textarea.value = text.substring(0, start) + insertText + text.substring(end);
                textarea.focus();
                textarea.selectionStart = textarea.selectionEnd = start + insertText.length;
                return;
            }

            if (prefix !== null) {
                const selected = text.substring(start, end) || 'your text';
                const replacement = prefix + selected + (suffix || '');
                textarea.value = text.substring(0, start) + replacement + text.substring(end);
                textarea.focus();
                textarea.selectionStart = start + prefix.length;
                textarea.selectionEnd = start + prefix.length + selected.length;
            }
        });
    });
</script>


<%- include("partials/footer.ejs") %>
