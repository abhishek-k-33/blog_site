<%- include("partials/header.ejs") %>

<div class="medium-editor-layout">
    <!-- Floating Bottom Capsule Dock (Craft / Linear Style) -->
    <div class="editor-header-toolbox">
        <div class="toolbox-pill" id="static-pill-toolbox" aria-label="Story formatting toolbar">
            <button type="button" class="toolbox-btn format-trigger" data-action="bold" title="Bold">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path></svg>
            </button>
            <button type="button" class="toolbox-btn format-trigger" data-action="italic" title="Italic">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="4" x2="10" y2="4"></line><line x1="14" y1="20" x2="5" y2="20"></line><line x1="15" y1="4" x2="9" y2="20"></line></svg>
            </button>
            <div class="toolbox-divider"></div>
            <button type="button" class="toolbox-btn format-trigger" data-action="h2" title="Large Header">
                <span class="btn-text-glyph">H</span>
            </button>
            <button type="button" class="toolbox-btn format-trigger" data-action="h3" title="Subheader">
                <span class="btn-text-glyph small-glyph">h</span>
            </button>
            <button type="button" class="toolbox-btn format-trigger" data-action="blockquote" title="Quote">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v6c0 1.1.9 2 2 2h4c0 3.5-1 5.5-5 6v2z"></path><path d="M15 21c3 0 7-1 7-8V5c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v6c0 1.1.9 2 2 2h4c0 3.5-1 5.5-5 6v2z"></path></svg>
            </button>
            <button type="button" class="toolbox-btn format-trigger" data-action="insertUnorderedList" title="Bullet List">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="9" y1="6" x2="20" y2="6"></line><line x1="9" y1="12" x2="20" y2="12"></line><line x1="9" y1="18" x2="20" y2="18"></line><circle cx="4" cy="6" r="1.5" fill="currentColor"></circle><circle cx="4" cy="12" r="1.5" fill="currentColor"></circle><circle cx="4" cy="18" r="1.5" fill="currentColor"></circle></svg>
            </button>
            <button type="button" class="toolbox-btn format-trigger" data-action="createLink" title="Link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            </button>
            <div class="toolbox-divider"></div>
            <button type="button" class="toolbox-btn" id="toolbox-insert-photo" title="Insert Photo">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            </button>
            <button type="button" class="toolbox-btn" id="toolbox-insert-divider" title="Insert Divider">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line></svg>
            </button>
        </div>
    </div>

    <!-- Floating Bubble Selection Toolbar -->
    <div id="bubble-toolbar" class="bubble-toolbar" aria-label="Text formatting toolbar">
        <button type="button" class="bubble-btn format-trigger" data-action="bold" title="Bold">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path></svg>
        </button>
        <button type="button" class="bubble-btn format-trigger" data-action="italic" title="Italic">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="4" x2="10" y2="4"></line><line x1="14" y1="20" x2="5" y2="20"></line><line x1="15" y1="4" x2="9" y2="20"></line></svg>
        </button>
        <div class="bubble-divider"></div>
        <button type="button" class="bubble-btn format-trigger" data-action="h2" title="Large Header">
            <span class="btn-text-glyph">H</span>
        </button>
        <button type="button" class="bubble-btn format-trigger" data-action="h3" title="Subheader">
            <span class="btn-text-glyph small-glyph">h</span>
        </button>
        <button type="button" class="bubble-btn format-trigger" data-action="blockquote" title="Quote">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v6c0 1.1.9 2 2 2h4c0 3.5-1 5.5-5 6v2z"></path><path d="M15 21c3 0 7-1 7-8V5c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v6c0 1.1.9 2 2 2h4c0 3.5-1 5.5-5 6v2z"></path></svg>
        </button>
        <button type="button" class="bubble-btn format-trigger" data-action="insertUnorderedList" title="Bullet List">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="9" y1="6" x2="20" y2="6"></line><line x1="9" y1="12" x2="20" y2="12"></line><line x1="9" y1="18" x2="20" y2="18"></line><circle cx="4" cy="6" r="1.5" fill="currentColor"></circle><circle cx="4" cy="12" r="1.5" fill="currentColor"></circle><circle cx="4" cy="18" r="1.5" fill="currentColor"></circle></svg>
        </button>
        <button type="button" class="bubble-btn format-trigger" data-action="createLink" title="Link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
        </button>
    </div>

    <!-- Hidden Media File Picker -->
    <input type="file" id="media-image-picker" accept="image/*" style="display: none;">

    <!-- Theme-Styled Link Modal / Pill Dialog -->
    <div id="link-modal" class="link-modal-overlay" aria-hidden="true">
        <div class="link-pill-dialog">
            <div class="link-input-wrapper">
                <svg class="link-dialog-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                <input type="url" id="link-url-input" placeholder="Paste or type link (https://...)" autocomplete="off">
            </div>
            <div class="link-dialog-actions">
                <button type="button" id="link-submit-btn" class="btn-link-submit">Insert</button>
                <button type="button" id="link-cancel-btn" class="btn-link-cancel" title="Cancel">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Medium Writing Canvas Form -->
    <form action="/update/<%= post.id %>" method="POST" id="medium-story-form" class="medium-story-form">
        <input type="hidden" name="content" id="hidden-content">

        <div class="medium-canvas-wrapper">
            <!-- Title Input -->
            <input type="text" id="title" name="title" value="<%= post.title %>" required placeholder="Title" autocomplete="off" class="medium-title-input">

            <!-- Author Input -->
            <input type="text" id="author" name="author" value="<%= post.author %>" required placeholder="Author name..." autocomplete="off" class="medium-author-input">

            <!-- Topic Tags Selector -->
            <div class="composer-tag-picker" id="composer-tag-picker">
                <div class="tag-picker-header">
                    <span class="tag-picker-label">Topics:</span>
                    <div class="tag-preset-chips" id="tag-preset-chips">
                        <button type="button" class="tag-preset-btn <%= (post.tags && post.tags.includes('Thoughts')) ? 'is-selected' : '' %>" data-tag="Thoughts">#Thoughts</button>
                        <button type="button" class="tag-preset-btn <%= (post.tags && post.tags.includes('Tech')) ? 'is-selected' : '' %>" data-tag="Tech">#Tech</button>
                        <button type="button" class="tag-preset-btn <%= (post.tags && post.tags.includes('Guides')) ? 'is-selected' : '' %>" data-tag="Guides">#Guides</button>
                        <button type="button" class="tag-preset-btn <%= (post.tags && post.tags.includes('Opinion')) ? 'is-selected' : '' %>" data-tag="Opinion">#Opinion</button>
                        <button type="button" class="tag-preset-btn <%= (post.tags && post.tags.includes('Design')) ? 'is-selected' : '' %>" data-tag="Design">#Design</button>
                        <button type="button" class="tag-preset-btn <%= (post.tags && post.tags.includes('Life')) ? 'is-selected' : '' %>" data-tag="Life">#Life</button>
                    </div>
                </div>
                <input type="text" id="custom-tag-input" placeholder="+ Add custom tags (comma separated)..." class="custom-tag-input" autocomplete="off">
                <input type="hidden" name="tags" id="hidden-tags" value="<%= (post.tags || []).join(', ') %>">
            </div>

            <!-- Cover / Thumbnail Visual Item Selector -->
            <div class="composer-cover-picker" id="composer-cover-picker">
                <div class="cover-picker-header">
                    <div class="cover-picker-title-group">
                        <span class="cover-picker-label">Cover Artwork & Thumbnail:</span>
                        <span class="cover-selected-badge" id="cover-selected-badge"><%= post.coverImage ? 'Custom / Preset Selected' : 'Generative Mesh' %></span>
                    </div>
                    <button type="button" class="btn-toggle-custom-cover" id="btn-toggle-custom-cover">
                        <span id="custom-cover-toggle-text">+ Custom URL</span>
                    </button>
                </div>

                <!-- Curated Preset Item Grid -->
                <div class="cover-preset-grid" id="cover-preset-grid" role="radiogroup" aria-label="Select story cover artwork">
                    <!-- Preset 1: Generative Topic Mesh (Default) -->
                    <button type="button" class="cover-preset-card <%= !post.coverImage ? 'is-selected' : '' %>" data-cover-url="" data-cover-name="Generative Mesh" role="radio" aria-checked="<%= !post.coverImage ? 'true' : 'false' %>">
                        <div class="cover-card-art-preview topic-mesh-preview">
                            <div class="mesh-mini-glow"></div>
                            <div class="mesh-mini-circle"></div>
                            <span class="mesh-mini-tag">Topic Mesh</span>
                        </div>
                        <div class="cover-card-info">
                            <span class="cover-card-title">Generative Mesh</span>
                            <span class="cover-card-badge">Dynamic</span>
                        </div>
                        <div class="cover-card-check">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </div>
                    </button>

                    <!-- Preset 2: Tech Workspace -->
                    <button type="button" class="cover-preset-card <%= (post.coverImage && post.coverImage.includes('1498050108023')) ? 'is-selected' : '' %>" data-cover-url="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=800&q=80" data-cover-name="Tech Workspace" role="radio" aria-checked="<%= (post.coverImage && post.coverImage.includes('1498050108023')) ? 'true' : 'false' %>">
                        <div class="cover-card-img-preview">
                            <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=400&q=80" alt="Tech Workspace" loading="lazy">
                        </div>
                        <div class="cover-card-info">
                            <span class="cover-card-title">Tech Workspace</span>
                            <span class="cover-card-badge">Code</span>
                        </div>
                        <div class="cover-card-check">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </div>
                    </button>

                    <!-- Preset 3: Minimal Architecture -->
                    <button type="button" class="cover-preset-card <%= (post.coverImage && post.coverImage.includes('1513694203232')) ? 'is-selected' : '' %>" data-cover-url="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=800&q=80" data-cover-name="Minimal Space" role="radio" aria-checked="<%= (post.coverImage && post.coverImage.includes('1513694203232')) ? 'true' : 'false' %>">
                        <div class="cover-card-img-preview">
                            <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=400&q=80" alt="Minimal Space" loading="lazy">
                        </div>
                        <div class="cover-card-info">
                            <span class="cover-card-title">Minimal Space</span>
                            <span class="cover-card-badge">Design</span>
                        </div>
                        <div class="cover-card-check">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </div>
                    </button>

                    <!-- Preset 4: Editorial Coffee -->
                    <button type="button" class="cover-preset-card <%= (post.coverImage && post.coverImage.includes('1501339847302')) ? 'is-selected' : '' %>" data-cover-url="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=800&q=80" data-cover-name="Warm Reading" role="radio" aria-checked="<%= (post.coverImage && post.coverImage.includes('1501339847302')) ? 'true' : 'false' %>">
                        <div class="cover-card-img-preview">
                            <img src="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=400&q=80" alt="Warm Reading" loading="lazy">
                        </div>
                        <div class="cover-card-info">
                            <span class="cover-card-title">Warm Reading</span>
                            <span class="cover-card-badge">Thoughts</span>
                        </div>
                        <div class="cover-card-check">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </div>
                    </button>

                    <!-- Preset 5: Cyber Neon -->
                    <button type="button" class="cover-preset-card <%= (post.coverImage && post.coverImage.includes('1550745165')) ? 'is-selected' : '' %>" data-cover-url="https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=800&q=80" data-cover-name="Neon Cyber" role="radio" aria-checked="<%= (post.coverImage && post.coverImage.includes('1550745165')) ? 'true' : 'false' %>">
                        <div class="cover-card-img-preview">
                            <img src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=400&q=80" alt="Neon Cyber" loading="lazy">
                        </div>
                        <div class="cover-card-info">
                            <span class="cover-card-title">Neon Cyber</span>
                            <span class="cover-card-badge">Future</span>
                        </div>
                        <div class="cover-card-check">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </div>
                    </button>

                    <!-- Preset 6: Abstract Modern Art -->
                    <button type="button" class="cover-preset-card <%= (post.coverImage && post.coverImage.includes('1618005182384')) ? 'is-selected' : '' %>" data-cover-url="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=800&q=80" data-cover-name="Abstract Flow" role="radio" aria-checked="<%= (post.coverImage && post.coverImage.includes('1618005182384')) ? 'true' : 'false' %>">
                        <div class="cover-card-img-preview">
                            <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=400&q=80" alt="Abstract Flow" loading="lazy">
                        </div>
                        <div class="cover-card-info">
                            <span class="cover-card-title">Abstract Flow</span>
                            <span class="cover-card-badge">Art</span>
                        </div>
                        <div class="cover-card-check">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </div>
                    </button>

                    <!-- Preset 7: Forest Fog -->
                    <button type="button" class="cover-preset-card <%= (post.coverImage && post.coverImage.includes('1448375240586')) ? 'is-selected' : '' %>" data-cover-url="https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=800&q=80" data-cover-name="Forest Mist" role="radio" aria-checked="<%= (post.coverImage && post.coverImage.includes('1448375240586')) ? 'true' : 'false' %>">
                        <div class="cover-card-img-preview">
                            <img src="https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=400&q=80" alt="Forest Mist" loading="lazy">
                        </div>
                        <div class="cover-card-info">
                            <span class="cover-card-title">Forest Mist</span>
                            <span class="cover-card-badge">Nature</span>
                        </div>
                        <div class="cover-card-check">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </div>
                    </button>

                    <!-- Preset 8: Amber Sunset -->
                    <button type="button" class="cover-preset-card <%= (post.coverImage && post.coverImage.includes('1507525428034')) ? 'is-selected' : '' %>" data-cover-url="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80" data-cover-name="Amber Horizon" role="radio" aria-checked="<%= (post.coverImage && post.coverImage.includes('1507525428034')) ? 'true' : 'false' %>">
                        <div class="cover-card-img-preview">
                            <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=400&q=80" alt="Amber Horizon" loading="lazy">
                        </div>
                        <div class="cover-card-info">
                            <span class="cover-card-title">Amber Horizon</span>
                            <span class="cover-card-badge">Light</span>
                        </div>
                        <div class="cover-card-check">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </div>
                    </button>
                </div>

                <!-- Hidden Form Input synchronizing coverImage -->
                <input type="hidden" id="cover-image-input" name="coverImage" value="<%= post.coverImage || '' %>">

                <!-- Optional Custom URL Accordion -->
                <div class="cover-custom-container" id="cover-custom-container" style="display: none;">
                    <div class="cover-input-row">
                        <input type="url" id="custom-cover-input" value="<%= post.coverImage || '' %>" placeholder="Paste custom image URL (Unsplash, imgur, https://...)" class="cover-image-input" autocomplete="off">
                        <button type="button" class="btn btn-secondary btn-apply-custom-cover" id="btn-apply-custom-cover">Apply URL</button>
                    </div>
                </div>
            </div>

            <!-- Live Editable Story Canvas (Pre-filled with content) -->
            <div id="editor-body" class="medium-editor-body" contenteditable="true" data-placeholder="Tell your story..."><%- post.content %></div>
        </div>

        <!-- Sticky Action Bar -->
        <div class="medium-composer-actions">
            <a href="/posts/<%= post.id %>" class="btn-medium-cancel">Cancel</a>
            <button type="submit" class="btn btn-medium-publish">Update Story</button>
        </div>
    </form>
</div>

<script>
    const editor = document.getElementById('editor-body');
    const hiddenContent = document.getElementById('hidden-content');
    const bubbleToolbar = document.getElementById('bubble-toolbar');
    const form = document.getElementById('medium-story-form');

    // Helper: Find closest matching ancestor within editor
    function getClosestBlock(tag) {
        const selection = window.getSelection();
        if (!selection || !selection.rangeCount) return null;
        let node = selection.anchorNode;
        if (!node) return null;
        if (node.nodeType === 3) node = node.parentElement;
        return node.closest(tag);
    }

    // Toggle Blockquote on/off
    function toggleBlockquote() {
        const blockquote = getClosestBlock('blockquote');
        const selection = window.getSelection();

        if (blockquote) {
            // Cancel / remove quote formatting and convert to normal paragraph
            const p = document.createElement('p');
            p.innerHTML = blockquote.innerHTML.trim() || '<br>';
            blockquote.parentNode.replaceChild(p, blockquote);

            // Restore selection in new paragraph
            const range = document.createRange();
            range.selectNodeContents(p);
            range.collapse(false);
            selection.removeAllRanges();
            selection.addRange(range);
        } else {
            document.execCommand('formatBlock', false, '<blockquote>');
        }
    }

    // Toggle Heading on/off
    function toggleHeading(tag) {
        const heading = getClosestBlock(tag);
        if (heading) {
            document.execCommand('formatBlock', false, '<p>');
        } else {
            document.execCommand('formatBlock', false, `<${tag}>`);
        }
    }

    const editorLayout = document.querySelector('.medium-editor-layout');

    // Update active highlight states on all buttons (both Header Toolbox & Floating Bubble)
    function updateActiveStates() {
        const selection = window.getSelection();
        if (!selection || !selection.rangeCount) return;

        document.querySelectorAll('.format-trigger').forEach((btn) => {
            const action = btn.getAttribute('data-action');
            let isActive = false;
            try {
                if (action === 'bold' || action === 'italic' || action === 'insertUnorderedList') {
                    isActive = document.queryCommandState(action);
                } else if (action === 'blockquote' || action === 'h2' || action === 'h3') {
                    isActive = !!getClosestBlock(action);
                } else if (action === 'createLink') {
                    isActive = !!getClosestBlock('a');
                }
            } catch (err) {
                isActive = false;
            }
            btn.classList.toggle('active', isActive);
        });
    }

    // 1. Floating Bubble Selection Handler
    function updateBubbleToolbar() {
        updateActiveStates();

        const selection = window.getSelection();
        if (!selection || selection.isCollapsed || selection.rangeCount === 0) {
            bubbleToolbar.classList.remove('show');
            return;
        }

        const range = selection.getRangeAt(0);
        const container = range.commonAncestorContainer;
        const containerElement = container.nodeType === 3 ? container.parentElement : container;

        // Ensure selection is inside our editor
        if (!editor.contains(containerElement)) {
            bubbleToolbar.classList.remove('show');
            return;
        }

        const selectedText = selection.toString().trim();
        if (!selectedText) {
            bubbleToolbar.classList.remove('show');
            return;
        }

        const rect = range.getBoundingClientRect();
        const layoutRect = editorLayout.getBoundingClientRect();
        const bubbleWidth = bubbleToolbar.offsetWidth || 300;

        // Precise positioning relative to .medium-editor-layout
        let top = rect.top - layoutRect.top - 54;
        let left = (rect.left - layoutRect.left) + (rect.width / 2) - (bubbleWidth / 2);

        // Keep inside layout bounds
        if (left < 10) left = 10;
        if (left + bubbleWidth > layoutRect.width - 10) {
            left = layoutRect.width - bubbleWidth - 10;
        }

        bubbleToolbar.style.top = `${top}px`;
        bubbleToolbar.style.left = `${left}px`;
        bubbleToolbar.classList.add('show');
    }

    // Trigger on selection change, click, and all keyboard navigation
    document.addEventListener('selectionchange', () => {
        setTimeout(updateBubbleToolbar, 10);
    });
    editor.addEventListener('mouseup', () => {
        setTimeout(updateBubbleToolbar, 10);
    });
    editor.addEventListener('click', () => {
        setTimeout(updateActiveStates, 10);
    });
    editor.addEventListener('keyup', () => {
        setTimeout(updateBubbleToolbar, 10);
    });

    // Theme-Styled Link Modal Logic
    const linkModal = document.getElementById('link-modal');
    const linkUrlInput = document.getElementById('link-url-input');
    const linkSubmitBtn = document.getElementById('link-submit-btn');
    const linkCancelBtn = document.getElementById('link-cancel-btn');
    let savedSelectionRange = null;

    function openLinkModal() {
        const selection = window.getSelection();
        if (selection.rangeCount > 0) {
            savedSelectionRange = selection.getRangeAt(0).cloneRange();
        } else {
            savedSelectionRange = null;
        }

        const existingLink = getClosestBlock('a');
        linkUrlInput.value = existingLink ? existingLink.getAttribute('href') : '';
        linkModal.classList.add('show');
        linkModal.setAttribute('aria-hidden', 'false');
        setTimeout(() => linkUrlInput.focus(), 50);
    }

    function closeLinkModal() {
        linkModal.classList.remove('show');
        linkModal.setAttribute('aria-hidden', 'true');
        linkUrlInput.value = '';
        if (savedSelectionRange) {
            const selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(savedSelectionRange);
        }
        editor.focus();
    }

    function applyLink() {
        let url = linkUrlInput.value.trim();
        if (!url) {
            // If empty, remove link
            if (savedSelectionRange) {
                const selection = window.getSelection();
                selection.removeAllRanges();
                selection.addRange(savedSelectionRange);
            }
            document.execCommand('unlink', false, null);
            closeLinkModal();
            updateBubbleToolbar();
            return;
        }

        if (!/^https?:\/\//i.test(url) && !url.startsWith('#') && !url.startsWith('/')) {
            url = 'https://' + url;
        }

        if (savedSelectionRange) {
            const selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(savedSelectionRange);
        }

        document.execCommand('createLink', false, url);
        closeLinkModal();
        updateBubbleToolbar();
    }

    linkSubmitBtn.addEventListener('click', applyLink);
    linkCancelBtn.addEventListener('click', closeLinkModal);
    linkUrlInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            e.preventDefault();
            applyLink();
        } else if (e.key === 'Escape') {
            e.preventDefault();
            closeLinkModal();
        }
    });

    linkModal.addEventListener('click', (e) => {
        if (e.target === linkModal) {
            closeLinkModal();
        }
    });

    // Formatting Actions (Shared between Header Pill Toolbox and Floating Bubble)
    document.querySelectorAll('.format-trigger').forEach((btn) => {
        btn.addEventListener('mousedown', (e) => {
            e.preventDefault();
            const action = btn.getAttribute('data-action');

            if (action === 'bold' || action === 'italic' || action === 'insertUnorderedList') {
                document.execCommand(action, false, null);
            } else if (action === 'blockquote') {
                toggleBlockquote();
            } else if (action === 'h2' || action === 'h3') {
                toggleHeading(action);
            } else if (action === 'createLink') {
                openLinkModal();
            }
            setTimeout(updateBubbleToolbar, 10);
        });
    });

    // Smart Keyboard Shortcuts for Blockquotes (Enter twice or Backspace to exit quote)
    editor.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            const blockquote = getClosestBlock('blockquote');
            if (blockquote) {
                const text = blockquote.innerText.trim();
                if (text === '' || text === '"' || text === '""') {
                    e.preventDefault();
                    toggleBlockquote();
                }
            }
        } else if (e.key === 'Backspace') {
            const blockquote = getClosestBlock('blockquote');
            if (blockquote && (blockquote.innerText.trim() === '' || blockquote.innerText.trim() === '"')) {
                e.preventDefault();
                toggleBlockquote();
            }
        }
    });

    // Inserter Actions (Photo Media Picker & Divider)
    const mediaImagePicker = document.getElementById('media-image-picker');

    mediaImagePicker.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        if (!file.type.startsWith('image/')) {
            alert('Please select a valid image file.');
            return;
        }

        const reader = new FileReader();
        reader.onload = (event) => {
            const base64Data = event.target.result;
            const figureHtml = `<figure class="medium-figure"><img src="${base64Data}" alt="Story Photo" loading="lazy" decoding="async"><figcaption contenteditable="true" data-placeholder="Type a caption (optional)..."></figcaption></figure><p><br></p>`;
            editor.focus();
            document.execCommand('insertHTML', false, figureHtml);
            mediaImagePicker.value = '';
        };
        reader.readAsDataURL(file);
    });

    const openMediaPicker = () => {
        mediaImagePicker.click();
    };

    const insertDividerAction = () => {
        document.execCommand('insertHTML', false, '<hr><p><br></p>');
    };

    document.getElementById('toolbox-insert-photo')?.addEventListener('click', (e) => {
        e.preventDefault();
        openMediaPicker();
    });
    document.getElementById('toolbox-insert-divider')?.addEventListener('click', (e) => {
        e.preventDefault();
        insertDividerAction();
    });

    // Topic Tags Picker Interactivity
    const tagPresetBtns = document.querySelectorAll('.tag-preset-btn');
    const customTagInput = document.getElementById('custom-tag-input');
    const hiddenTags = document.getElementById('hidden-tags');

    tagPresetBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            btn.classList.toggle('is-selected');
            updateTagsValue();
        });
    });

    if (customTagInput) {
        customTagInput.addEventListener('input', updateTagsValue);
    }

    function updateTagsValue() {
        const selected = Array.from(document.querySelectorAll('.tag-preset-btn.is-selected')).map(b => b.dataset.tag);
        const custom = customTagInput ? customTagInput.value.split(',').map(t => t.trim().replace(/^#/, '')).filter(Boolean) : [];
        const combined = [...new Set([...selected, ...custom])];
        if (hiddenTags) {
            hiddenTags.value = combined.length > 0 ? combined.join(',') : 'Thoughts';
        }
    }

    // 3. Visual Cover Preset Item Selector Logic
    const coverPresetCards = document.querySelectorAll('.cover-preset-card');
    const coverImageInput = document.getElementById('cover-image-input');
    const coverSelectedBadge = document.getElementById('cover-selected-badge');
    const btnToggleCustomCover = document.getElementById('btn-toggle-custom-cover');
    const coverCustomContainer = document.getElementById('cover-custom-container');
    const customCoverToggleText = document.getElementById('custom-cover-toggle-text');
    const customCoverInput = document.getElementById('custom-cover-input');
    const btnApplyCustomCover = document.getElementById('btn-apply-custom-cover');

    coverPresetCards.forEach(card => {
        card.addEventListener('click', () => {
            coverPresetCards.forEach(c => {
                c.classList.remove('is-selected');
                c.setAttribute('aria-checked', 'false');
            });
            card.classList.add('is-selected');
            card.setAttribute('aria-checked', 'true');

            const url = card.dataset.coverUrl || '';
            const name = card.dataset.coverName || 'Generative Mesh';

            if (coverImageInput) coverImageInput.value = url;
            if (coverSelectedBadge) coverSelectedBadge.textContent = name;
        });
    });

    if (btnToggleCustomCover && coverCustomContainer) {
        btnToggleCustomCover.addEventListener('click', () => {
            const isHidden = coverCustomContainer.style.display === 'none';
            coverCustomContainer.style.display = isHidden ? 'block' : 'none';
            if (customCoverToggleText) customCoverToggleText.textContent = isHidden ? 'Hide Custom' : '+ Custom URL';
            if (isHidden && customCoverInput) customCoverInput.focus();
        });
    }

    if (btnApplyCustomCover && customCoverInput) {
        btnApplyCustomCover.addEventListener('click', () => {
            const customUrl = customCoverInput.value.trim();
            if (customUrl) {
                coverPresetCards.forEach(c => {
                    c.classList.remove('is-selected');
                    c.setAttribute('aria-checked', 'false');
                });
                if (coverImageInput) coverImageInput.value = customUrl;
                if (coverSelectedBadge) coverSelectedBadge.textContent = 'Custom URL';
            }
        });
    }

    // 4. Form Submit Validation & Synchronization
    form.addEventListener('submit', (e) => {
        const rawContent = editor.innerHTML.trim();
        const plainText = editor.innerText.trim();

        if (!plainText) {
            e.preventDefault();
            alert('Please write some content for your story before publishing.');
            editor.focus();
            return;
        }

        updateTagsValue();
        hiddenContent.value = rawContent;
    });
</script>

