<%- include("partials/header.ejs") %>

<div class="form-container">
    <div class="editor-header">
        <h2>Write a Story</h2>
        <p class="editor-subtitle">Share your daily adventures, thoughts, and memories with friends.</p>
    </div>

    <form action="/posts" method="POST" class="post-form">
        <div class="form-group">
            <label for="title">Story Title</label>
            <input type="text" id="title" name="title" required placeholder="e.g. Late night ramen & rooftop conversations..." autocomplete="off">
        </div>

        <div class="form-group">
            <label for="author">Author</label>
            <input type="text" id="author" name="author" required placeholder="Your name or nickname..." autocomplete="off">
        </div>

        <div class="form-group">
            <label for="content">Story Content</label>
            <textarea id="content" name="content" rows="12" required placeholder="Write your daily thoughts, story, or memory here..."></textarea>
        </div>

        <div class="form-actions">
            <a href="/" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Publish Story</button>
        </div>
    </form>
</div>

<%- include("partials/footer.ejs") %>
