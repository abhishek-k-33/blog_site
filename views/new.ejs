<%- include("partials/header.ejs") %>

<div class="form-container story-editor-container">
    <div class="editor-header">
        <h2>Write a Story</h2>
        <p class="editor-subtitle">Share your daily adventures, thoughts, and moments with friends.</p>
    </div>

    <form action="/posts" method="POST" class="post-form" id="story-form">
        <div class="form-group">
            <label for="title">Story Title</label>
            <input type="text" id="title" name="title" required placeholder="Story title..." autocomplete="off">
        </div>

        <div class="form-group">
            <label for="author">Author</label>
            <input type="text" id="author" name="author" required placeholder="Your name or nickname..." autocomplete="off">
        </div>

        <div class="form-group editor-group">
            <div class="editor-tabs-bar">
                <label for="content">Story Content (Markdown supported)</label>
                <div class="editor-tab-switches">
                    <button type="button" class="tab-btn active" id="tab-write-btn">Write</button>
                    <button type="button" class="tab-btn" id="tab-preview-btn">Preview</button>
                </div>
            </div>

            <!-- Dedicated Storyteller's Formatting Toolbar -->
            <div class="markdown-toolbar" id="markdown-toolbar">
                <div class="toolbar-group">
                    <button type="button" class="toolbar-btn" data-prefix="**" data-suffix="**" title="Bold">Bold</button>
                    <button type="button" class="toolbar-btn" data-prefix="*" data-suffix="*" title="Italic">Italic</button>
                    <button type="button" class="toolbar-btn" data-prefix="### " data-suffix="" title="Heading">Heading</button>
                    <button type="button" class="toolbar-btn" data-prefix="> " data-suffix="" title="Quote">Quote</button>
                </div>

                <div class="toolbar-group">
                    <button type="button" class="toolbar-btn" data-prefix="- " data-suffix="" title="Bullet List">List</button>
                    <button type="button" class="toolbar-btn" data-prefix="![Photo Caption](" data-suffix="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=800)" title="Embed Photo">Photo</button>
                    <button type="button" class="toolbar-btn" data-prefix="[" data-suffix="](https://)" title="Insert Link">Link</button>
                    <button type="button" class="toolbar-btn" data-prefix="```\n" data-suffix="\n```" title="Code snippet">Code</button>
                </div>

                <div class="toolbar-group mood-group">
                    <button type="button" class="toolbar-btn mood-btn" data-text="[Chill] " title="Chill tag">Chill</button>
                    <button type="button" class="toolbar-btn mood-btn" data-text="[Excited] " title="Excited tag">Excited</button>
                    <button type="button" class="toolbar-btn mood-btn" data-text="[Night] " title="Night tag">Night</button>
                    <button type="button" class="toolbar-btn mood-btn" data-text="[Trip] " title="Trip tag">Trip</button>
                </div>
            </div>

            <textarea id="content" name="content" rows="12" required placeholder="Write your story here...
Tip: Use > for thoughts, ![photo](url) for memories, and - for daily recaps!"></textarea>

            <!-- Live Story Preview Pane -->
            <div id="story-preview" class="story-preview-pane" style="display: none;">
                <div class="preview-placeholder">Your story preview will appear here.</div>
            </div>
        </div>

        <div class="form-actions">
            <a href="/" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Publish Story</button>
        </div>
    </form>
</div>

<script>
    // Story Editor Tab Switcher & Live Preview
    const tabWrite = document.getElementById('tab-write-btn');
    const tabPreview = document.getElementById('tab-preview-btn');
    const textarea = document.getElementById('content');
    const previewPane = document.getElementById('story-preview');
    const toolbar = document.getElementById('markdown-toolbar');

    tabWrite.addEventListener('click', () => {
        tabWrite.classList.add('active');
        tabPreview.classList.remove('active');
        textarea.style.display = 'block';
        toolbar.style.display = 'flex';
        previewPane.style.display = 'none';
    });

    tabPreview.addEventListener('click', () => {
        tabPreview.classList.add('active');
        tabWrite.classList.remove('active');
        textarea.style.display = 'none';
        toolbar.style.display = 'none';
        previewPane.style.display = 'block';

        const rawText = textarea.value.trim();
        if (rawText && typeof marked !== 'undefined') {
            previewPane.innerHTML = marked.parse(rawText);
            if (typeof hljs !== 'undefined') {
                previewPane.querySelectorAll('pre code').forEach((block) => {
                    hljs.highlightElement(block);
                });
            }
        } else {
            previewPane.innerHTML = '<p class="preview-empty">Your story preview will appear here...</p>';
        }
    });

    // Toolbar formatting helper
    document.querySelectorAll('.toolbar-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
            const prefix = btn.getAttribute('data-prefix');
            const suffix = btn.getAttribute('data-suffix');
            const insertText = btn.getAttribute('data-text');

            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            const text = textarea.value;

            if (insertText) {
                textarea.value = text.substring(0, start) + insertText + text.substring(end);
                textarea.focus();
                textarea.selectionStart = textarea.selectionEnd = start + insertText.length;
                return;
            }

            if (prefix !== null) {
                const selected = text.substring(start, end) || 'your text';
                const replacement = prefix + selected + (suffix || '');
                textarea.value = text.substring(0, start) + replacement + text.substring(end);
                textarea.focus();
                textarea.selectionStart = start + prefix.length;
                textarea.selectionEnd = start + prefix.length + selected.length;
            }
        });
    });
</script>


<%- include("partials/footer.ejs") %>
