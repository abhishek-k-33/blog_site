<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signing you in... — miniblogs</title>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="stylesheet" href="/styles/style.css">
    <style>
        body {
            background: #0c0d10;
            color: #ffffff;
            font-family: var(--font-ui, sans-serif);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }
        .callback-box {
            text-align: center;
            background: rgba(23, 24, 29, 0.85);
            padding: 40px 32px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
            max-width: 380px;
            width: 90%;
        }
        .spinner {
            width: 36px;
            height: 36px;
            border: 3px solid rgba(255, 138, 0, 0.2);
            border-top-color: #FF8A00;
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
            margin: 0 auto 20px;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        h2 {
            font-family: var(--font-story, serif);
            font-size: 1.35rem;
            margin-bottom: 8px;
        }
        p {
            font-size: 0.88rem;
            color: rgba(255, 255, 255, 0.55);
        }
    </style>
</head>
<body>
    <div class="callback-box">
        <div class="spinner"></div>
        <h2>Authenticating...</h2>
        <p>Please wait while we log you into miniblogs.</p>
    </div>

    <script>
        (async function() {
            // 1. Check if token exists in hash fragment (#access_token=...)
            const hash = window.location.hash.substring(1);
            const params = new URLSearchParams(hash);
            const accessToken = params.get('access_token');

            if (accessToken) {
                try {
                    await fetch('/api/auth/session', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ token: accessToken })
                    });
                    window.location.href = '/';
                    return;
                } catch (e) {
                    console.error('Session setting error:', e);
                }
            }

            // If query params code or error
            const queryParams = new URLSearchParams(window.location.search);
            const error = queryParams.get('error_description') || queryParams.get('error');
            if (error) {
                alert('Authentication failed: ' + error);
                window.location.href = '/login';
                return;
            }

            setTimeout(() => {
                window.location.href = '/';
            }, 1200);
        })();
    </script>
</body>
</html>
